<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <style>
    @media print {
      body { background: #ffffff !important; color: #000000 !important; }
      header, .no-print { display: none !important; }
      .print-border { border: 1px solid #111111 !important; }
      .bg-panel { background: #ffffff !important; color: #000000 !important; }
      .text-fg, .text-muted { color: #000000 !important; }
      .border-line { border-color: #cccccc !important; }
      .shadow-xl { box-shadow: none !important; }
    }
  </style>
</head>
<body class="font-sans text-fg antialiased bg-bg">
  <div class="no-print">
    <%- include('../partials/nav') %>
  </div>

  <main class="max-w-[900px] mx-auto px-4 sm:px-8 py-8">
    <!-- Controls (Hidden during print) -->
    <div class="no-print flex items-center justify-between mb-8 pb-4 border-b border-line">
      <a href="/student/semester-report" class="text-xs font-mono text-muted hover:text-fg">&larr; Back to Reports</a>
      <div class="flex items-center gap-3">
        <button onclick="window.print()" class="btn-lime text-xs font-semibold px-4 py-2 bg-lime text-black rounded-md flex items-center gap-1.5 shadow">
          <span>🖨️</span> Print / Save PDF
        </button>
      </div>
    </div>

    <!-- Official Hardcoded Institutional Report Sheet -->
    <div class="border-2 border-line bg-panel p-8 sm:p-12 rounded-xl shadow-xl print-border">
      <!-- Institutional Letterhead -->
      <div class="text-center border-b-2 border-line pb-6 mb-6">
        <div class="flex items-center justify-center gap-3 mb-2">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" class="shrink-0">
            <path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z" fill="#d7ff2b"/>
          </svg>
          <span class="font-display text-2xl font-bold tracking-tight">CAMPUSBUZZ • INSTITUTIONAL COUNCIL</span>
        </div>
        <div class="font-mono text-xs tracking-[0.2em] uppercase text-muted">
          STUDENT EXTRA-CURRICULAR &amp; CLUB ACTIVITY SEMESTER LOG REPORT
        </div>
        <div class="text-xs text-muted/80 mt-1">
          Academic Year: <strong><%= report.academic_year %></strong> | Semester: <strong><%= report.semester %></strong>
        </div>
      </div>

      <!-- Student & Club Bio Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-4 rounded-lg bg-black/20 border border-line mb-8 text-xs">
        <div>
          <span class="text-muted block font-mono text-[10px] tracking-wider uppercase">STUDENT NAME</span>
          <span class="font-bold text-fg text-sm"><%= report.student_name %></span>
        </div>
        <div>
          <span class="text-muted block font-mono text-[10px] tracking-wider uppercase">ROLL NUMBER</span>
          <span class="font-mono font-bold text-fg"><%= report.roll_number || 'N/A' %></span>
        </div>
        <div>
          <span class="text-muted block font-mono text-[10px] tracking-wider uppercase">DEPARTMENT &amp; YEAR</span>
          <span class="font-semibold text-fg"><%= report.department || 'Eng' %> (Yr <%= report.student_year || '1' %>)</span>
        </div>
        <div>
          <span class="text-muted block font-mono text-[10px] tracking-wider uppercase">CLUB / SOCIETY</span>
          <span class="font-bold text-lime"><%= report.club_name %></span>
        </div>
      </div>

      <!-- Hardcoded Event Table -->
      <div class="mb-8">
        <h3 class="font-mono text-xs tracking-[0.15em] uppercase text-muted mb-3">
          // ITEMIZED ACTIVITY LOGBOOK &amp; CREDIT HOURS
        </h3>

        <% 
          const repData = typeof report.report_data === 'string' ? JSON.parse(report.report_data) : (report.report_data || {});
          const eventsList = repData.events || [];
        %>

        <% if (eventsList.length === 0) { %>
          <div class="p-6 border border-line rounded-lg text-center text-muted text-sm">
            No events registered under this club for the selected semester.
          </div>
        <% } else { %>
          <table class="w-full text-left text-xs border border-line">
            <thead class="bg-black/30 font-mono text-[10px] tracking-wider uppercase text-muted border-b border-line">
              <tr>
                <th class="p-3 border-r border-line">#</th>
                <th class="p-3 border-r border-line">Event Name</th>
                <th class="p-3 border-r border-line">Date</th>
                <th class="p-3 border-r border-line">Venue</th>
                <th class="p-3 text-right">Credit Hours</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line">
              <% eventsList.forEach(function(e, i) { %>
                <tr>
                  <td class="p-3 border-r border-line font-mono"><%= i + 1 %></td>
                  <td class="p-3 border-r border-line font-bold"><%= e.title %></td>
                  <td class="p-3 border-r border-line font-mono"><%= e.date ? new Date(e.date).toLocaleDateString() : 'N/A' %></td>
                  <td class="p-3 border-r border-line"><%= e.venue || 'Campus' %></td>
                  <td class="p-3 text-right font-mono font-bold text-lime">+<%= e.creditHours || 0 %> hrs</td>
                </tr>
              <% }); %>
            </tbody>
            <tfoot class="border-t-2 border-line bg-black/20 font-bold">
              <tr>
                <td colspan="4" class="p-3 text-right font-mono uppercase text-muted">Total Verified Hours:</td>
                <td class="p-3 text-right font-mono text-sm text-lime"><%= report.total_hours %> Hours</td>
              </tr>
            </tfoot>
          </table>
        <% } %>
      </div>

      <!-- Verification Status Stamp -->
      <div class="mb-10 p-4 rounded-lg border border-line bg-black/10 flex items-center justify-between">
        <div>
          <span class="text-muted text-[10px] font-mono tracking-wider uppercase block">STATUS OF REPORT</span>
          <span class="font-display text-base font-bold uppercase
            <%= report.status === 'approved' ? 'text-emerald-400' :
                report.status === 'rejected' ? 'text-red-400' :
                report.status === 'reverification' ? 'text-amber-300' : 'text-sky-400' %>">
            <%= report.status === 'approved' ? '✓ VERIFIED & APPROVED' :
                report.status === 'rejected' ? '✗ REJECTED' :
                report.status === 'reverification' ? '↺ SENT BACK FOR RE-VERIFICATION' : 'PENDING FACULTY REVIEW' %>
          </span>
          <% if (report.fc_remarks) { %>
            <div class="text-xs text-muted mt-1 italic">
              Faculty Remarks: "<%= report.fc_remarks %>"
            </div>
          <% } %>
        </div>
        <div class="text-right text-xs text-muted font-mono">
          <% if (report.verified_at) { %>
            <div>Verified on: <%= new Date(report.verified_at).toLocaleDateString() %></div>
            <div>Signee: <%= report.verified_by_name || 'Faculty Incharge' %></div>
          <% } else { %>
            <div>Awaiting Sign-off</div>
          <% } %>
        </div>
      </div>

      <!-- Tripartite Sign-off Block -->
      <div class="grid grid-cols-3 gap-6 pt-10 border-t border-line text-center text-xs">
        <div class="flex flex-col items-center">
          <div class="w-32 border-b border-muted pb-1 mb-2 font-mono text-muted text-[11px]"><%= report.student_name %></div>
          <span class="font-mono text-[10px] text-muted tracking-wider uppercase">Student Signature</span>
        </div>

        <div class="flex flex-col items-center">
          <div class="w-32 border-b border-muted pb-1 mb-2 font-mono text-muted text-[11px]">Authorized</div>
          <span class="font-mono text-[10px] text-muted tracking-wider uppercase">Student Coordinator</span>
        </div>

        <div class="flex flex-col items-center">
          <div class="w-32 border-b border-muted pb-1 mb-2 font-mono text-muted text-[11px]">
            <%= report.verified_by_name || 'Faculty Incharge' %>
          </div>
          <span class="font-mono text-[10px] text-muted tracking-wider uppercase">Faculty Coordinator</span>
        </div>
      </div>
    </div>
  </main>
</body>
</html>
