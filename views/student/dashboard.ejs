<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: (isViewingOwn ? 'Student Hub' : student.name + ' Ledger') + ' — CampusBuzz' }) %>
  <style>
    .score-conic {
      background: conic-gradient(var(--lime) 0% var(--perc, 75%), var(--surface-3) var(--perc, 75%) 100%);
    }
  </style>
</head>
<body class="font-sans text-fg antialiased bg-bg">
  <%- include('../partials/nav') %>

  <main class="page">
    <!-- Inspection Banner if viewing as Auditor/Faculty -->
    <% if (isInspector) { %>
      <div class="mb-6 p-4 rounded-xl bg-lime/10 border border-lime/40 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="w-2.5 h-2.5 rounded-full bg-lime animate-pulse"></span>
          <span class="text-xs font-bold font-mono text-lime tracking-wide">
            AUDIT / INSPECTOR MODE: Viewing Official Ledger of <%= student.name %> (<%= student.roll_number || 'N/A' %>)
          </span>
        </div>
        <span class="badge badge-lime font-mono text-[9px]">Verified Session</span>
      </div>
    <% } %>

    <!-- Welcome Header Row (CampusBuzz UI Design) -->
    <section class="welcome-row">
      <div>
        <span class="overline">// OFFICIAL CO-CURRICULAR LEDGER</span>
        <h1>Good day, <%= student.name.split(' ')[0] %>.</h1>
        <p>Your institutional activity transcript is <strong>cryptographically verified</strong> and non-editable.</p>
      </div>

      <div class="student-id">
        <span class="avatar avatar-lg">
          <%= student.name.split(' ').map(n => n[0]).join('').slice(0, 2).toUpperCase() %>
        </span>
        <div>
          <strong><%= student.name %></strong>
          <p class="mono"><%= student.roll_number || 'PRN PENDING' %> · <%= (student.department || 'COMPUTER ENGG').toUpperCase() %> · YEAR <%= student.year || '2' %></p>
        </div>
        <span class="badge badge-green">VERIFIED</span>
      </div>
    </section>

    <!-- Quick Exports Row (CampusBuzz UI Design) -->
    <section class="quick-row">
      <div class="section-kicker">
        <span>QUICK EXPORTS</span>
        <i></i>
      </div>
      <div class="quick-actions">
        <a href="/student/semester-report" class="quick-button text-decoration-none">
          <span class="quick-icon q0">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
          </span>
          <span>
            <strong>Semester Report</strong>
            <small>Hardcoded Institutional PDF</small>
          </span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>

        <a href="/student/graduation-report<%= isInspector ? '/' + student.id : '' %>" class="quick-button text-decoration-none">
          <span class="quick-icon q1">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="8" r="6"></circle>
              <path d="M8.5 13 7 22l5-3 5 3-1.5-9"></path>
            </svg>
          </span>
          <span>
            <strong>4-Year Dossier</strong>
            <small>Degree Graduation Keepsake</small>
          </span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>

        <a href="/student/yearly-summary<%= isInspector ? '/' + student.id : '' %>" class="quick-button text-decoration-none">
          <span class="quick-icon q2">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m12 2 1.5 5.2L18 10l-4.5 2.8L12 18l-1.5-5.2L6 10l4.5-2.8L12 2Z"></path>
            </svg>
          </span>
          <span>
            <strong>Yearly Keepsake</strong>
            <small>Visual Memory Certificate</small>
          </span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </section>

    <!-- 4-Card Metric Grid (CampusBuzz UI Design) -->
    <section class="metric-grid">
      <!-- 1. First Priority Club -->
      <article class="metric featured">
        <div class="metric-top">
          <span class="metric-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m12 2 1.5 5.2L18 10l-4.5 2.8L12 18l-1.5-5.2L6 10l4.5-2.8L12 2Z"></path>
            </svg>
          </span>
          <span class="badge badge-lime">PRIMARY</span>
        </div>
        <p>FIRST PRIORITY CLUB</p>
        <h2 class="truncate"><%= priorityClub ? priorityClub.name : 'None Selected' %></h2>
        <div class="metric-foot">
          <span>Priority Hours: <strong class="text-lime font-mono"><%= priorityClubHours %> hrs</strong></span>
          <% if (isViewingOwn && myClubs && myClubs.length > 0) { %>
            <form action="/student/priority-club" method="POST" class="inline-flex items-center gap-1.5 ml-auto">
              <select name="clubId" onchange="this.form.submit()" class="text-[10px] bg-surface-3 border border-line rounded px-1.5 py-1 text-fg">
                <% myClubs.forEach(function(c) { %>
                  <option value="<%= c.club_id %>" <%= priorityClub && priorityClub.id === c.club_id ? 'selected' : '' %>><%= c.name %></option>
                <% }); %>
              </select>
            </form>
          <% } %>
        </div>
      </article>

      <!-- 2. Priority Club Progress -->
      <article class="metric">
        <div class="metric-top">
          <span class="metric-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="9"></circle>
              <polyline points="12 7 12 12 15 14"></polyline>
            </svg>
          </span>
          <span class="trend font-mono">SEMESTER GOAL</span>
        </div>
        <p>PRIORITY CLUB HOURS</p>
        <h2><%= priorityClubHours %> <small>hrs</small></h2>
        <div class="meter">
          <% const priorityPct = Math.min(100, Math.round((priorityClubHours / 40) * 100)); %>
          <span style="width: <%= priorityPct %>%;"></span>
        </div>
        <div class="metric-foot">
          <span>Target: 40 hours</span>
          <strong><%= priorityPct %>%</strong>
        </div>
      </article>

      <!-- 3. Total Credited Hours -->
      <article class="metric">
        <div class="metric-top">
          <span class="metric-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="8" r="6"></circle>
              <path d="M8.5 13 7 22l5-3 5 3-1.5-9"></path>
            </svg>
          </span>
          <span class="badge badge-green">ON TRACK</span>
        </div>
        <p>CUMULATIVE CREDITED HOURS</p>
        <h2><%= totalHoursAll %> <small>hrs</small></h2>
        <div class="metric-foot">
          <span>Across all verified check-ins</span>
          <span class="font-mono text-xs text-lime">8 Sems Active</span>
        </div>
      </article>

      <!-- 4. Leadership / Coordinatorship -->
      <article class="metric">
        <div class="metric-top">
          <span class="metric-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </span>
          <span class="trend font-mono"><%= coordinatorships && coordinatorships.length > 0 ? coordinatorships.length + ' APPOINTED' : 'PARTICIPANT' %></span>
        </div>
        <p>COORDINATOR AUTHORITY</p>
        <h2><%= coordinatorships ? String(coordinatorships.length).padStart(2, '0') : '00' %></h2>
        <div class="metric-foot">
          <span class="truncate"><%= coordinatorships && coordinatorships.length > 0 ? coordinatorships[0].role_title + ' · ' + coordinatorships[0].club_name : 'General Student Member' %></span>
          <% if (coordinatorships && coordinatorships.some(c => c.can_inspect_students)) { %>
            <span class="badge badge-lime text-[7px]">INSPECTOR</span>
          <% } %>
        </div>
      </article>
    </section>

    <!-- Main Content Grid (CampusBuzz UI Design: Ledger Table + Report Status Card) -->
    <section class="content-grid">
      <!-- Left: Tamper-Proof Attendance Ledger -->
      <article class="panel table-panel">
        <div class="panel-head">
          <div>
            <span class="overline">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="4" y="10" width="16" height="11" rx="3"></rect>
                <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
              </svg>
              VERIFIED LEDGER (NON-EDITABLE)
            </span>
            <h3>Attended Events &amp; Credit Log</h3>
          </div>
          <span class="badge badge-green font-mono text-[9px]">
            <%= attendedEvents ? attendedEvents.length : 0 %> SESSIONS LOGGED
          </span>
        </div>

        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Event</th>
                <th>Host Club</th>
                <th>Date</th>
                <th>Venue</th>
                <th>Assigned Hours</th>
                <th>Verification Status</th>
              </tr>
            </thead>
            <tbody>
              <% if (!attendedEvents || attendedEvents.length === 0) { %>
                <tr>
                  <td colspan="6" class="text-center py-10 text-muted">
                    No verified event check-ins recorded yet for this student.
                  </td>
                </tr>
              <% } else { %>
                <% attendedEvents.forEach(function(ev, idx) { %>
                  <tr>
                    <td>
                      <span class="event-name">
                        <i class="event-dot d<%= (idx % 3) + 1 %>"></i>
                        <strong><%= ev.title %></strong>
                      </span>
                    </td>
                    <td>
                      <span class="text-fg text-xs font-medium"><%= ev.club_name %></span>
                    </td>
                    <td class="mono text-xs">
                      <%= new Date(ev.date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                    </td>
                    <td class="text-xs text-muted">
                      <%= ev.location || 'PICT Campus' %>
                    </td>
                    <td class="mono font-bold text-lime">
                      +<%= parseFloat(ev.hours || 0).toFixed(1) %> hrs
                    </td>
                    <td>
                      <span class="badge badge-green">
                        <i></i> Verified QR
                      </span>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </article>

      <!-- Right: Semester Report Status Card -->
      <article class="panel report-status">
        <div class="panel-head">
          <div>
            <span class="overline">SEMESTER AUDIT</span>
            <h3>Transcript Progress</h3>
          </div>
          <span class="badge badge-lime font-mono text-[8px]">ACTIVE</span>
        </div>

        <% 
          const calcGoal = 40;
          const currentTotal = parseFloat(priorityClubHours || 0);
          const percent = Math.min(100, Math.round((currentTotal / calcGoal) * 100));
        %>
        <div class="score-ring score-conic" style="--perc: <%= percent %>%;">
          <div>
            <strong><%= percent %></strong>
            <small>%</small>
          </div>
        </div>

        <p class="center-copy">
          <%= priorityClubHours %> of 40 standard semester hours credited for priority club.
        </p>

        <div class="status-list">
          <div>
            <span><i class="status-dot green"></i><strong>Priority Hours</strong></span>
            <b><%= priorityClubHours %> h</b>
          </div>
          <div>
            <span><i class="status-dot amber"></i><strong>Other Clubs</strong></span>
            <b><%= Math.max(0, totalHoursAll - priorityClubHours).toFixed(1) %> h</b>
          </div>
          <div>
            <span><i class="status-dot red"></i><strong>Cumulative Total</strong></span>
            <b><%= totalHoursAll %> h</b>
          </div>
        </div>

        <a href="/student/semester-report" class="button button-primary block text-center mt-4 text-decoration-none">
          Open Semester Report Studio →
        </a>
      </article>
    </section>
  </main>
</body>
</html>
