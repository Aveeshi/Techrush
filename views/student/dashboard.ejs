<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="font-sans text-fg antialiased">
  <%- include('../partials/nav') %>

  <main class="max-w-[1400px] mx-auto px-4 sm:px-8 py-10">
    <!-- Breadcrumb / Inspector notice -->
    <% if (isInspector) { %>
      <div class="mb-6 p-4 rounded-lg bg-lime/10 border border-lime/40 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="w-3 h-3 rounded-full bg-lime animate-pulse"></span>
          <span class="text-sm font-semibold text-lime">
            INSPECTION MODE: Viewing Activity Record of <%= student.name %> (<%= student.roll_number || 'N/A' %>)
          </span>
        </div>
        <span class="font-mono text-xs text-muted uppercase">Auditor: <%= user.name %> (<%= user.type %>)</span>
      </div>
    <% } %>

    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8 pb-6 border-b border-line">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <span class="w-6 h-px bg-lime"></span>
          <span class="font-mono text-xs tracking-[0.2em] text-lime">// ACADEMIC & ACTIVITY RECORD</span>
        </div>
        <h1 class="font-display text-3xl sm:text-4xl"><%= isViewingOwn ? 'My Activity Dashboard' : student.name + '\'s Activity Dashboard' %></h1>
        <p class="text-muted text-sm mt-1">
          Verified, tamper-proof record of event attendance and club activity hours. (Non-editable)
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-3">
        <a href="/student/semester-report" class="btn-lime text-xs font-semibold px-4 py-2.5 bg-lime text-black rounded-md flex items-center gap-1.5">
          <span>📄</span> Semester Report
        </a>
        <a href="/student/graduation-report<%= isInspector ? '/' + student.id : '' %>" class="btn-outline text-xs font-semibold px-4 py-2.5 border border-line rounded-md hover:border-lime transition-colors flex items-center gap-1.5">
          <span>🎓</span> 4-Year Graduation Dossier
        </a>
        <a href="/student/yearly-summary<%= isInspector ? '/' + student.id : '' %>" class="btn-outline text-xs font-semibold px-4 py-2.5 border border-line rounded-md hover:border-lime transition-colors flex items-center gap-1.5">
          <span>📅</span> Yearly Memory Summary
        </a>
      </div>
    </div>

    <!-- Student Info & Hours Overview Grid -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-10">
      <!-- Profile Card -->
      <div class="border border-line bg-panel p-6 rounded-xl flex items-center gap-4">
        <img src="<%= student.profile_photo_url || '/avatars/avatar-1.svg' %>" alt="" class="w-16 h-16 rounded-full object-cover border border-line" />
        <div>
          <h2 class="font-bold text-lg leading-tight"><%= student.name %></h2>
          <div class="text-xs text-muted mt-1 font-mono">Roll: <%= student.roll_number || 'N/A' %></div>
          <div class="text-xs text-muted"><%= student.department || 'Department' %> • Year <%= student.year || '1' %></div>
        </div>
      </div>

      <!-- Priority Club Card -->
      <div class="border border-line bg-panel p-6 rounded-xl flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between">
            <span class="font-mono text-[10px] tracking-[0.15em] text-muted">FIRST PRIORITY CLUB</span>
            <span class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-lime/20 text-lime font-bold">PRIMARY</span>
          </div>
          <div class="font-display text-xl mt-2 text-fg truncate">
            <%= priorityClub ? priorityClub.name : 'No Club Selected' %>
          </div>
          <div class="text-xs text-muted mt-1">
            Priority club hours: <span class="text-lime font-bold font-mono"><%= priorityClubHours %> hrs</span>
          </div>
        </div>

        <% if (isViewingOwn && myClubs && myClubs.length > 0) { %>
          <form action="/student/priority-club" method="POST" class="mt-4 pt-3 border-t border-line flex items-center gap-2">
            <select name="clubId" class="text-xs bg-black/40 border border-line rounded px-2 py-1.5 text-fg flex-1 focus:outline-none focus:border-lime">
              <% myClubs.forEach(function(c) { %>
                <option value="<%= c.club_id %>" <%= priorityClub && priorityClub.id === c.club_id ? 'selected' : '' %>>
                  <%= c.name %>
                </option>
              <% }); %>
            </select>
            <button type="submit" class="text-xs px-2.5 py-1.5 bg-line text-fg hover:bg-lime hover:text-black rounded transition-colors font-mono">
              Save
            </button>
          </form>
        <% } %>
      </div>

      <!-- Total Hours Card -->
      <div class="border border-line bg-panel p-6 rounded-xl flex flex-col justify-between">
        <span class="font-mono text-[10px] tracking-[0.15em] text-muted">TOTAL CREDITED HOURS</span>
        <div class="my-2">
          <span class="font-display text-4xl text-lime font-bold"><%= totalHoursAll %></span>
          <span class="text-xs text-muted ml-1">Hours</span>
        </div>
        <div class="text-xs text-muted">
          Counted across all verified event check-ins and tasks.
        </div>
      </div>

      <!-- Leadership Roles Card -->
      <div class="border border-line bg-panel p-6 rounded-xl flex flex-col justify-between">
        <span class="font-mono text-[10px] tracking-[0.15em] text-muted">LEADERSHIP &amp; COORDINATION</span>
        <div class="my-2">
          <% if (coordinatorships && coordinatorships.length > 0) { %>
            <div class="space-y-1">
              <% coordinatorships.forEach(function(sc) { %>
                <div class="text-xs font-semibold text-lime flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-lime"></span>
                  <%= sc.role_title %> (<%= sc.club_name %>)
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <div class="text-xs text-muted">No student coordinator assignments.</div>
          <% } %>
        </div>
        <div class="text-[11px] text-muted font-mono">
          Assigned by Faculty Coordinator
        </div>
      </div>
    </div>

    <!-- Attended Events Section (Non-Editable verified log) -->
    <div class="border border-line rounded-xl bg-panel overflow-hidden mb-10">
      <div class="p-6 border-b border-line flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 class="font-display text-xl">Verified Attended Events Log</h2>
          <p class="text-xs text-muted mt-0.5">
            Strictly read-only &amp; non-editable. Automatically recorded upon official QR code check-in.
          </p>
        </div>
        <div class="flex items-center gap-2">
          <span class="font-mono text-xs px-2.5 py-1 rounded-full bg-lime/10 text-lime border border-lime/30">
            <%= attendedEvents.length %> Events Completed
          </span>
        </div>
      </div>

      <% if (attendedEvents.length === 0) { %>
        <div class="p-12 text-center text-muted text-sm">
          No attended event check-ins recorded yet. Check into events with your personal QR code to earn verified hours.
        </div>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-black/20 text-muted font-mono text-[10px] tracking-[0.1em] border-b border-line uppercase">
              <tr>
                <th class="px-6 py-3.5">#</th>
                <th class="px-6 py-3.5">Event Name</th>
                <th class="px-6 py-3.5">Organizing Club</th>
                <th class="px-6 py-3.5">Date &amp; Venue</th>
                <th class="px-6 py-3.5 text-center">Assigned Hours</th>
                <th class="px-6 py-3.5">Checked-In At</th>
                <th class="px-6 py-3.5 text-right">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line">
              <% attendedEvents.forEach(function(ev, idx) { %>
                <tr class="hover:bg-white/[0.02] transition-colors">
                  <td class="px-6 py-4 font-mono text-xs text-muted"><%= idx + 1 %></td>
                  <td class="px-6 py-4 font-semibold text-fg">
                    <a href="/events/<%= ev.event_id %>" class="hover:text-lime transition-colors">
                      <%= ev.title %>
                    </a>
                  </td>
                  <td class="px-6 py-4">
                    <span class="inline-flex items-center gap-1.5 text-xs text-fg">
                      <% if (priorityClub && priorityClub.id === ev.club_id) { %>
                        <span class="w-2 h-2 rounded-full bg-lime" title="First Priority Club"></span>
                      <% } %>
                      <%= ev.club_name %>
                    </span>
                  </td>
                  <td class="px-6 py-4 text-xs text-muted">
                    <div><%= new Date(ev.event_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></div>
                    <div class="text-[11px] font-mono text-muted/80"><%= ev.venue || 'Campus' %></div>
                  </td>
                  <td class="px-6 py-4 text-center font-mono font-bold text-lime">
                    +<%= ev.credit_hours %> hrs
                  </td>
                  <td class="px-6 py-4 text-xs text-muted font-mono">
                    <%= new Date(ev.checked_in_at).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) %>
                  </td>
                  <td class="px-6 py-4 text-right">
                    <span class="inline-flex items-center gap-1 text-[11px] font-mono font-semibold text-emerald-400 bg-emerald-500/10 border border-emerald-500/30 px-2 py-0.5 rounded">
                      <span>✓</span> VERIFIED
                    </span>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <!-- Semester Reports Tracking -->
    <div class="border border-line rounded-xl bg-panel p-6">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 class="font-display text-xl">Semester Activity Reports</h2>
          <p class="text-xs text-muted mt-0.5">Official end-of-semester submissions sent to the Faculty Coordinator for verification.</p>
        </div>
        <a href="/student/semester-report" class="btn-outline text-xs px-3 py-1.5 border border-line rounded hover:border-lime">
          Submit New Report &rarr;
        </a>
      </div>

      <% if (!semesterReports || semesterReports.length === 0) { %>
        <p class="text-muted text-sm py-4">No semester reports submitted yet.</p>
      <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
          <% semesterReports.forEach(function(rep) { %>
            <div class="p-4 rounded-lg border border-line/80 bg-black/20 flex items-center justify-between">
              <div>
                <div class="font-bold text-sm text-fg">
                  Semester <%= rep.semester %> (<%= rep.academic_year %>)
                </div>
                <div class="text-xs text-muted mt-0.5"><%= rep.club_name %> • <span class="text-lime font-mono"><%= rep.total_hours %> hrs</span></div>
                <% if (rep.fc_remarks) { %>
                  <div class="text-xs text-amber-300/80 mt-1 italic">"<%= rep.fc_remarks %>"</div>
                <% } %>
              </div>
              <div class="flex items-center gap-3">
                <span class="text-xs font-mono px-2.5 py-1 rounded-full uppercase
                  <%= rep.status === 'approved' ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/40' :
                      rep.status === 'rejected' ? 'bg-red-500/20 text-red-400 border border-red-500/40' :
                      rep.status === 'reverification' ? 'bg-amber-500/20 text-amber-300 border border-amber-500/40' :
                      'bg-sky-500/20 text-sky-400 border border-sky-500/40' %>">
                  <%= rep.status === 'reverification' ? 'Needs Revision' : rep.status %>
                </span>
                <a href="/student/semester-report/<%= rep.id %>/view" class="text-xs font-mono text-lime hover:underline">
                  View &rarr;
                </a>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </main>
</body>
</html>
