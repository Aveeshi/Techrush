<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Semester Activity Report Studio — CampusBuzz' }) %>
  <style>
    @media print {
      body { background: #ffffff !important; color: #000000 !important; }
      header, .no-print { display: none !important; }
      .print-box { border: 2px solid #000000 !important; background: #ffffff !important; color: #000000 !important; }
      .text-fg, .text-muted, td, th { color: #000000 !important; }
      .border-line { border-color: #bbbbbb !important; }
    }
  </style>
</head>
<body class="font-sans text-fg antialiased bg-bg">
  <div class="no-print">
    <%- include('../partials/nav') %>
  </div>

  <main class="page max-w-5xl mx-auto pt-6 pb-20">
    <!-- Breadcrumb & Print Controls -->
    <div class="no-print mb-6 flex items-center justify-between">
      <a href="/student/dashboard" class="text-xs font-mono text-muted hover:text-fg text-decoration-none flex items-center gap-1">
        ← Back to Student Hub
      </a>
      <div class="flex items-center gap-2">
        <button onclick="window.print()" class="button button-quiet text-xs flex items-center gap-1.5">
          <span>🖨️</span> Print / Save PDF
        </button>
      </div>
    </div>

    <!-- Title Bar -->
    <div class="no-print mb-8">
      <div class="flex items-center gap-2 mb-2">
        <span class="w-2 h-2 rounded-full bg-lime animate-pulse"></span>
        <span class="overline text-[10px] tracking-widest text-lime">// ACCREDITED COURSE F023: CCA-I</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-fg mb-2">
        Semester Activity Report Studio
      </h1>
      <p class="text-sm text-muted max-w-2xl">
        Review and confirm your co-curricular activity record before generating your official institutional report or submitting it to your Faculty Coordinator for sign-off.
      </p>
    </div>

    <% if (submitted) { %>
      <div class="no-print p-4 mb-8 rounded-xl bg-lime/10 border border-lime/40 text-lime text-xs flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <span class="text-base font-bold">✓</span>
          <span>Your semester report has been confirmed and submitted to Faculty Coordinator (<strong class="text-fg"><%= selectedClub ? selectedClub.name : 'PASC' %></strong>) for verification.</span>
        </div>
        <span class="badge badge-green font-mono text-[8px]">PENDING VERIFICATION</span>
      </div>
    <% } %>

    <!-- Report Selector Controls (Auto-reloads on selection) -->
    <div class="no-print panel p-6 mb-8 bg-surface-2 border border-line">
      <form method="GET" action="/student/semester-report" class="grid grid-cols-1 sm:grid-cols-3 gap-4 items-end">
        <div>
          <label class="field-label mb-1.5">
            SELECTED STUDENT CLUB
            <select name="clubId" onchange="this.form.submit()" class="bg-surface border border-line text-xs py-2.5">
              <% myClubs.forEach(function(c) { %>
                <option value="<%= c.club_id %>" <%= String(selectedClubId) === String(c.club_id) ? 'selected' : '' %>>
                  <%= c.name %> <%= priorityClub && priorityClub.id === c.club_id ? '(★ 1st Priority)' : '' %>
                </option>
              <% }); %>
            </select>
          </label>
        </div>

        <div>
          <label class="field-label mb-1.5">
            ACADEMIC YEAR
            <select name="academicYear" onchange="this.form.submit()" class="bg-surface border border-line text-xs py-2.5">
              <option value="2025-2026" <%= selectedYear === '2025-2026' ? 'selected' : '' %>>A.Y. 2025 – 26 (Current)</option>
              <option value="2024-2025" <%= selectedYear === '2024-2025' ? 'selected' : '' %>>A.Y. 2024 – 25</option>
            </select>
          </label>
        </div>

        <div>
          <label class="field-label mb-1.5">
            SEMESTER
            <select name="semester" onchange="this.form.submit()" class="bg-surface border border-line text-xs py-2.5">
              <option value="1" <%= String(selectedSem) === '1' ? 'selected' : '' %>>Semester I (Odd)</option>
              <option value="2" <%= String(selectedSem) === '2' ? 'selected' : '' %>>Semester II (Even)</option>
              <option value="3" <%= String(selectedSem) === '3' ? 'selected' : '' %>>Semester III (Odd)</option>
              <option value="4" <%= String(selectedSem) === '4' ? 'selected' : '' %>>Semester IV (Even)</option>
            </select>
          </label>
        </div>
      </form>
    </div>

    <!-- Live Preview Notice (Requirement 2) -->
    <div class="no-print panel p-4 mb-6 bg-surface-2 border border-line flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <span class="badge <%= existingReport ? (existingReport.status === 'approved' ? 'badge-green' : 'badge-amber') : 'badge-lime' %> font-mono text-[9px] uppercase">
          <%= existingReport ? existingReport.status.toUpperCase() : 'PRE-SUBMISSION APPLICATION PREVIEW' %>
        </span>
        <span class="text-xs text-muted">
          <% if (!existingReport) { %>
            Step 1: Inspect your itemized co-curricular credits below. This report is NOT submitted to Faculty Coordinator until you click confirmation below.
          <% } else { %>
            Application submitted on <%= new Date(existingReport.submitted_at).toLocaleDateString() %>. You may generate / view the official PDF or update application.
          <% } %>
        </span>
      </div>
      <div class="flex items-center gap-2">
        <button onclick="window.print()" class="button button-quiet text-xs font-bold">
          <span>👁️</span> View / Print PDF
        </button>
      </div>
    </div>

    <!-- Official Hardcoded Institutional Report Sheet (Exact PICT Format from PDF) -->
    <div class="panel p-8 sm:p-12 border-2 border-line bg-surface mb-8 print-box shadow-xl">
      <!-- PICT Header from Curriculum PDF -->
      <div class="text-center border-b-2 border-line pb-6 mb-6">
        <div class="text-[11px] text-muted tracking-wider uppercase font-semibold">
          Society for Computer Technology &amp; Research's
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-fg my-1">
          PUNE INSTITUTE OF COMPUTER TECHNOLOGY
        </h2>
        <div class="text-[10px] text-muted leading-tight max-w-xl mx-auto">
          (An Autonomous Institute affiliated to Savitribai Phule Pune University, Approved by AICTE, Accredited by NAAC A+ and NBA)
        </div>
        <div class="text-[10px] text-muted mt-1 font-mono">
          Survey No. 27, Near Trimurti Chowk, Dhankawadi, Pune - 411043
        </div>

        <div class="mt-4 pt-3 border-t border-line/50 flex flex-wrap items-center justify-between gap-2 text-xs">
          <span class="font-bold font-mono text-lime">A.Y. <%= selectedYear %> [SEMESTER <%= selectedSem === '1' ? 'I' : selectedSem === '2' ? 'II' : selectedSem === '3' ? 'III' : 'IV' %>]</span>
          <span class="font-bold uppercase tracking-wider text-fg">F023: Co-Curricular Activity Course [CCA-I]</span>
          <span class="font-mono text-muted">Ref: PICT/CCA/<%= selectedYear %>/SEM<%= selectedSem %></span>
        </div>
      </div>

      <!-- Student & Club Credentials Card -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-4 rounded-xl bg-surface-2 border border-line mb-8 text-xs">
        <div>
          <span class="text-muted block font-mono text-[9px] uppercase tracking-wider">STUDENT CANDIDATE</span>
          <strong class="text-fg text-sm block mt-0.5"><%= student.name %></strong>
        </div>
        <div>
          <span class="text-muted block font-mono text-[9px] uppercase tracking-wider">PRN / ROLL NUMBER</span>
          <strong class="mono text-fg text-sm block mt-0.5"><%= student.roll_number || '41125' %></strong>
        </div>
        <div>
          <span class="text-muted block font-mono text-[9px] uppercase tracking-wider">DEPARTMENT &amp; YEAR</span>
          <strong class="text-fg block mt-0.5"><%= student.department || 'CE' %> · Year <%= student.year || '2' %></strong>
        </div>
        <div>
          <span class="text-muted block font-mono text-[9px] uppercase tracking-wider">ACTIVITY CLUB / CHAPTER</span>
          <strong class="text-lime block mt-0.5 truncate"><%= selectedClub ? selectedClub.name : 'ACM Student Chapter (PASC)' %></strong>
        </div>
      </div>

      <!-- Itemized Activities Table -->
      <div class="mb-8">
        <div class="flex items-center justify-between mb-3">
          <span class="overline text-[10px]">ITEMIZED ACTIVITY RECORD &amp; CREDIT HOURS</span>
          <span class="badge badge-green font-mono text-[8px]"><%= clubAttendedEvents.length %> SESSIONS RECORDED</span>
        </div>

        <div class="table-wrap border border-line rounded-lg overflow-hidden">
          <table>
            <thead>
              <tr class="bg-surface-3">
                <th style="width: 40px;">Sr.</th>
                <th>Activity / Event Name</th>
                <th>Date</th>
                <th>Venue / Location</th>
                <th>Rubric Indicator</th>
                <th class="text-right">Credit Hours</th>
              </tr>
            </thead>
            <tbody>
              <% if (clubAttendedEvents.length === 0) { %>
                <tr>
                  <td colspan="6" class="text-center py-10 text-muted">
                    No verified event attendances logged for <%= selectedClub ? selectedClub.name : 'this club' %> in Semester <%= selectedSem %>.
                  </td>
                </tr>
              <% } else { %>
                <% 
                  function getRubric(title) {
                    if (title.includes('GenAI')) return 'GenAI Tool Utilization: Excellent (5/5)';
                    if (title.includes('LinkedIn')) return 'Profile Optimization: Excellent (5/5)';
                    if (title.includes('Eminent')) return 'Q&A Participation: Very Good (4/5)';
                    if (title.includes('Git')) return 'Hands-on Repository PRs: Excellent (5/5)';
                    if (title.includes('Riveting')) return 'Attentive Discussion: Very Good (4/5)';
                    if (title.includes('Web Development')) return 'Full-Stack Implementation: Excellent (5/5)';
                    if (title.includes('Ideathon')) return 'Innovation & Pitch: Excellent (5/5)';
                    if (title.includes('VidSync')) return 'Media Editing Quality: Excellent (5/5)';
                    if (title.includes('Distinguished')) return 'Active Discourse: Excellent (5/5)';
                    return 'Accreditation Criteria: Excellent (5/5)';
                  }
                  clubAttendedEvents.forEach(function(ev, idx) { 
                %>
                  <tr>
                    <td class="mono font-bold"><%= idx + 1 %></td>
                    <td>
                      <strong class="text-fg block text-xs"><%= ev.title %></strong>
                      <span class="text-[10px] text-muted">Organized by <%= selectedClub ? selectedClub.name : 'PASC' %></span>
                    </td>
                    <td class="mono text-xs text-muted">
                      <%= new Date(ev.date || ev.start_time).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                    </td>
                    <td class="text-xs text-muted">
                      <%= ev.location || ev.venue || 'PICT Campus' %>
                    </td>
                    <td>
                      <span class="badge badge-green text-[7px]">
                        <%= getRubric(ev.title) %>
                      </span>
                    </td>
                    <td class="mono font-bold text-lime text-right">
                      +<%= parseFloat(ev.credit_hours || 4).toFixed(1) %> hrs
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
            <tfoot>
              <tr class="bg-surface-3 border-t-2 border-line font-bold">
                <td colspan="5" class="text-right text-xs uppercase tracking-wider font-mono text-muted py-3">
                  TOTAL VERIFIED PRIORITY HOURS:
                </td>
                <td class="mono font-bold text-lime text-right text-sm py-3">
                  <%= parseFloat(calculatedHours || 0).toFixed(1) %> hrs
                </td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>

      <!-- Institutional Sign-Off Block -->
      <div class="grid grid-cols-3 gap-6 pt-8 border-t border-line text-center text-xs">
        <div>
          <div class="h-12 border-b border-dashed border-line flex items-end justify-center pb-1">
            <span class="font-mono text-[11px] text-fg"><%= student.name %></span>
          </div>
          <span class="text-[10px] text-muted mt-2 block uppercase tracking-wider">Student Signature</span>
        </div>

        <div>
          <div class="h-12 border-b border-dashed border-line flex items-end justify-center pb-1">
            <span class="font-mono text-[11px] text-lime">Dr. G. V. Kale</span>
          </div>
          <span class="text-[10px] text-muted mt-2 block uppercase tracking-wider">Faculty Coordinator</span>
        </div>

        <div>
          <div class="h-12 border-b border-dashed border-line flex items-end justify-center pb-1">
            <span class="font-mono text-[11px] text-muted">Institutional Stamp</span>
          </div>
          <span class="text-[10px] text-muted mt-2 block uppercase tracking-wider">Dean / Principal</span>
        </div>
      </div>
    </div>

    <!-- Student Confirmation Action Bar (Requirement 2) -->
    <div class="no-print panel p-6 bg-surface-2 border border-line flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-12">
      <div>
        <span class="badge badge-lime text-[9px] mb-1">STEP 2 OF 2</span>
        <h4 class="text-sm font-bold text-fg">Confirm &amp; Transmit to Faculty Convener</h4>
        <p class="text-xs text-muted">
          <% if (existingReport) { %>
            Status: <strong class="mono text-lime font-bold uppercase"><%= existingReport.status %></strong>
            (Submitted on <%= new Date(existingReport.submitted_at).toLocaleDateString() %>)
          <% } else { %>
            This report is currently in <strong>Draft</strong>. It will become visible on the Faculty Coordinator desk once submitted.
          <% } %>
        </p>
      </div>

      <div class="flex items-center gap-3">
        <button onclick="window.print()" class="button button-quiet text-xs">
          <span>🖨️</span> Save PDF Copy
        </button>

        <form action="/student/semester-report/submit" method="POST" class="inline">
          <input type="hidden" name="clubId" value="<%= selectedClubId %>" />
          <input type="hidden" name="academicYear" value="<%= selectedYear %>" />
          <input type="hidden" name="semester" value="<%= selectedSem %>" />
          <button type="submit" class="button button-primary text-xs py-2.5 px-5">
            <%= existingReport ? '↻ Re-Submit Updated Report →' : 'Confirm & Submit to Faculty Coordinator →' %>
          </button>
        </form>
      </div>
    </div>

    <!-- Past Reports Archive -->
    <section class="no-print">
      <div class="section-title mb-4">
        <div>
          <span class="overline">HISTORICAL ARCHIVE</span>
          <h3>All Submitted Semester Transcripts</h3>
        </div>
      </div>

      <% if (reports.length === 0) { %>
        <article class="panel p-6 text-center text-muted text-xs">
          No previous semester reports submitted yet.
        </article>
      <% } else { %>
        <div class="space-y-3">
          <% reports.forEach(function(rep) { %>
            <article class="panel p-5 flex items-center justify-between">
              <div>
                <div class="flex items-center gap-2 mb-1">
                  <span class="badge badge-lime text-[8px]"><%= rep.club_name %></span>
                  <span class="mono text-xs font-bold text-fg">Semester <%= rep.semester %> (<%= rep.academic_year %>)</span>
                </div>
                <div class="text-xs text-muted">
                  Logged Hours: <strong class="mono text-lime"><%= parseFloat(rep.total_hours || 0).toFixed(1) %> hrs</strong> · Submitted: <%= new Date(rep.submitted_at).toLocaleDateString() %>
                </div>
              </div>

              <div class="flex items-center gap-3">
                <span class="badge <%= rep.status === 'approved' ? 'badge-green' : rep.status === 'pending' ? 'badge-amber' : rep.status === 'rejected' ? 'badge-red' : 'badge-neutral' %> font-mono text-[8px]">
                  <%= rep.status.toUpperCase() %>
                </span>
                <a href="/student/semester-report/<%= rep.id %>/view" class="button button-quiet text-xs text-decoration-none">
                  View Certificate →
                </a>
              </div>
            </article>
          <% }); %>
        </div>
      <% } %>
    </section>
  </main>
</body>
</html>
