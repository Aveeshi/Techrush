<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Campus Availability Calendar — CampusBuzz' }) %>
  <style>
    .availability-calendar { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 6px; }
    .calendar-day { min-height: 92px; border: 1px solid var(--line); border-radius: 10px; padding: 9px; background: var(--surface); }
    .calendar-day.is-busy { background: color-mix(in srgb, var(--amber) 8%, var(--surface)); border-color: color-mix(in srgb, var(--amber) 35%, var(--line)); }
    .calendar-day.is-empty { opacity: .35; background: transparent; }
    .calendar-day-number { font-family: 'DM Mono', monospace; font-size: 12px; font-weight: 700; }
    .calendar-day-status { margin-top: 20px; font-size: 9px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
    .calendar-day.is-busy .calendar-day-status { color: var(--amber); }
    .availability-table { width: 100%; border-collapse: collapse; }
    .availability-table th, .availability-table td { padding: 10px 12px; border-bottom: 1px solid var(--line); text-align: left; font-size: 12px; }
    .availability-table th { color: var(--muted); font-size: 9px; letter-spacing: .1em; text-transform: uppercase; }
    .availability-table td:first-child { font-weight: 700; }
    @media (max-width: 700px) {
      .calendar-day { min-height: 64px; padding: 7px; }
      .calendar-day-status { margin-top: 10px; font-size: 8px; }
      .calendar-day-status span { display: none; }
    }
  </style>
</head>
<body class="font-sans text-fg antialiased bg-bg">
  <%- include('../partials/nav') %>
  <main class="page">
    <section class="welcome-row">
      <div>
        <span class="overline">// CAMPUS SPACE PLANNER</span>
        <h1>Availability calendar.</h1>
        <p>Class timetables and planned events are combined here to show when rooms can be scheduled.</p>
      </div>
      <div class="flex items-center gap-2">
        <a class="button button-quiet text-xs text-decoration-none" href="/scheduling?month=<%= new Date(calendar.month + '-01T00:00:00Z').toISOString().slice(0, 7) %>">This month</a>
        <a class="button button-primary text-xs text-decoration-none" href="/scheduling?month=<%= new Date(Date.UTC(Number(calendar.month.slice(0, 4)), Number(calendar.month.slice(5)) - 2, 1)).toISOString().slice(0, 7) %>">← Previous</a>
        <a class="button button-primary text-xs text-decoration-none" href="/scheduling?month=<%= new Date(Date.UTC(Number(calendar.month.slice(0, 4)), Number(calendar.month.slice(5)), 1)).toISOString().slice(0, 7) %>">Next →</a>
      </div>
    </section>

    <% if (message) { %><div class="panel p-3 mb-5 text-xs text-lime"><%= message %></div><% } %>
    <% if (error) { %><div class="panel p-3 mb-5 text-xs text-red-300"><%= error %></div><% } %>

    <section class="grid grid-cols-1 lg:grid-cols-[1.4fr_.6fr] gap-6 mb-6">
      <article class="panel p-5">
        <div class="panel-head mb-4">
          <div><span class="overline">MONTH OVERVIEW</span><h3><%= calendar.monthLabel %></h3></div>
          <div class="flex gap-3 text-[10px] text-muted"><span><i class="inline-block w-2 h-2 rounded-full bg-lime mr-1"></i>Free</span><span><i class="inline-block w-2 h-2 rounded-full bg-amber-400 mr-1"></i>Busy</span></div>
        </div>
        <div class="grid grid-cols-7 gap-1 mb-2 text-[9px] uppercase tracking-wider text-muted text-center">
          <% ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].forEach(day => { %><span><%= day %></span><% }); %>
        </div>
        <div class="availability-calendar">
          <% for (let i = 0; i < calendar.firstDay; i += 1) { %><div class="calendar-day is-empty"></div><% } %>
          <% calendar.days.forEach(day => { %>
            <a href="#rooms-<%= day.date %>" class="calendar-day text-decoration-none <%= day.busy ? 'is-busy' : '' %>">
              <span class="calendar-day-number"><%= day.dayNumber %></span>
              <div class="calendar-day-status"><span><%= day.busy ? 'Busy' : 'Free' %></span></div>
            </a>
          <% }); %>
        </div>
      </article>

      <article class="panel p-5">
        <span class="overline">ROOM INVENTORY</span>
        <h3 class="mb-4">Schedulable rooms</h3>
        <div class="space-y-2 mb-6">
          <% calendar.rooms.forEach(room => { %>
            <div class="flex items-center justify-between p-2.5 rounded-lg bg-surface-2 border border-line text-xs">
              <span><i class="inline-block w-2 h-2 rounded-full bg-lime mr-2"></i><%= room.name %></span>
              <span class="text-muted">Active</span>
            </div>
          <% }); %>
        </div>
        <form action="/scheduling/rooms" method="POST" class="flex gap-2">
          <input name="name" required placeholder="Add room, e.g. A1-104" class="min-w-0 flex-1 text-xs px-3 py-2 bg-surface-2 border border-line rounded-lg" />
          <button class="button button-quiet text-xs" type="submit">Add</button>
        </form>
      </article>
    </section>

    <% calendar.days.filter(day => day.busy).forEach(day => { %>
      <article id="rooms-<%= day.date %>" class="panel p-5 mb-4">
        <div class="panel-head mb-3">
          <div><span class="overline">ROOM STATUS · <%= day.date %></span><h3><%= new Date(day.date + 'T00:00:00Z').toLocaleDateString('en-IN', { weekday: 'long', day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }) %></h3></div>
          <span class="badge badge-amber">TIMETABLE / EVENT CONFLICTS</span>
        </div>
        <table class="availability-table">
          <thead><tr><th>Room</th><th>Status</th><th>Busy blocks</th></tr></thead>
          <tbody>
            <% calendar.rooms.forEach(room => {
              const timetable = day.timetable.filter(block => block.room_name.toLowerCase() === room.name.toLowerCase());
              const eventsWithKnownRoom = day.events.filter(event => calendar.rooms.some(candidate => (event.venue || '').toLowerCase().includes(candidate.name.toLowerCase())));
              const events = day.events.filter(event => (event.venue || '').toLowerCase().includes(room.name.toLowerCase()) || !eventsWithKnownRoom.includes(event));
              const manualEvents = day.manualEvents.filter(event => !event.room_name || event.room_name.toLowerCase() === room.name.toLowerCase());
              const blocks = timetable.map(block => `${block.class_name} (${block.start_time.slice(0, 5)}–${block.end_time.slice(0, 5)})`)
                .concat(events.map(event => `${event.title} (event)`))
                .concat(manualEvents.map(event => `${event.title} (${event.start_time.slice(0, 5)}–${event.end_time.slice(0, 5)})`));
            %>
              <tr>
                <td><%= room.name %></td>
                <td><span class="badge <%= blocks.length ? 'badge-amber' : 'badge-green' %>"><%= blocks.length ? 'UNAVAILABLE' : 'FREE' %></span></td>
                <td class="text-muted"><%= blocks.length ? blocks.join(' · ') : 'Available for event planning' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </article>
    <% }); %>

    <section class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-6">
      <article class="panel p-5">
        <span class="overline">MANUAL EVENT PLAN</span>
        <h3>Add an event to the calendar</h3>
        <p class="text-xs text-muted mt-2 mb-4">Choose any date in the month and reserve a room. Leave the room unassigned to mark every room unavailable.</p>
        <form action="/scheduling/events" method="POST" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <label class="field-label sm:col-span-2">EVENT TITLE
            <input name="title" required maxlength="160" placeholder="e.g. ACM workshop" class="mt-1 w-full text-xs px-3 py-2 bg-surface-2 border border-line rounded-lg" />
          </label>
          <label class="field-label sm:col-span-2">STUDENT-FACING CLUB
            <select name="clubId" class="mt-1 w-full text-xs px-3 py-2 bg-surface-2 border border-line rounded-lg">
              <% clubs.forEach(club => { %><option value="<%= club.id %>"><%= club.name %></option><% }); %>
            </select>
          </label>
          <label class="field-label">DATE
            <input type="date" name="eventDate" required value="<%= calendar.month %>-01" class="mt-1 w-full text-xs px-3 py-2 bg-surface-2 border border-line rounded-lg" />
          </label>
          <label class="field-label">ROOM
            <select name="roomName" class="mt-1 w-full text-xs px-3 py-2 bg-surface-2 border border-line rounded-lg">
              <option value="">All rooms / not assigned</option>
              <% calendar.rooms.forEach(room => { %><option value="<%= room.name %>"><%= room.name %></option><% }); %>
            </select>
          </label>
          <label class="field-label">START TIME
            <input type="time" name="startTime" required value="09:00" class="mt-1 w-full text-xs px-3 py-2 bg-surface-2 border border-line rounded-lg" />
          </label>
          <label class="field-label">END TIME
            <input type="time" name="endTime" required value="10:00" class="mt-1 w-full text-xs px-3 py-2 bg-surface-2 border border-line rounded-lg" />
          </label>
          <button class="button button-primary text-xs sm:col-span-2" type="submit">Add Event &amp; Block Availability →</button>
        </form>
      </article>
      <article class="panel p-5">
        <span class="overline">TIMETABLE IMPORT</span>
        <h3>Upload class schedule</h3>
        <p class="text-xs text-muted mt-2 mb-4">CSV headers: <code>room,class_name,day_of_week,start_time,end_time</code>. Day can be Sunday–Saturday or 0–6.</p>
        <form action="/scheduling/timetable/import" method="POST" enctype="multipart/form-data" class="flex gap-2">
          <input type="file" name="timetable" accept=".csv,text/csv" required class="min-w-0 flex-1 text-xs" />
          <button class="button button-primary text-xs" type="submit">Import CSV</button>
        </form>
      </article>
      <article class="panel p-5">
        <span class="overline">PLANNED EVENTS</span>
        <h3><%= calendar.events.length + calendar.manualEvents.length %> event blocks this month</h3>
        <p class="text-xs text-muted mt-2">Existing club events and manually planned events are included. Room-level plans block only their selected room; unassigned plans block every room.</p>
      </article>
    </section>
  </main>
</body>
</html>
