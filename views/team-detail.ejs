<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: team.name + ' · Team Workspace — CampusBuzz' }) %>
  <script src="/socket.io/socket.io.js"></script>
</head>
<body class="font-sans text-fg antialiased bg-bg">
  <%- include('partials/nav') %>

  <main class="page max-w-6xl mx-auto pt-8 pb-20">
    <div class="mb-6 flex items-center justify-between">
      <a href="/teams" class="text-xs font-mono text-muted hover:text-fg text-decoration-none flex items-center gap-1.5">
        ← BACK TO MY TEAMS
      </a>
      <span class="badge badge-lime font-mono text-[9px]">VOLUNTEER SQUAD</span>
    </div>

    <!-- Header Section -->
    <div class="welcome-row mb-8 items-start">
      <div>
        <span class="overline text-lime">// OPERATIONAL WORKSPACE</span>
        <h1 class="text-3xl font-extrabold text-fg my-1"><%= team.name %></h1>
        <% if (team.description) { %>
          <p class="text-xs text-muted max-w-xl"><%= team.description %></p>
        <% } %>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
      <!-- LEFT: Tasks Section -->
      <section>
        <div class="panel-head px-0 pt-0 pb-4 mb-4">
          <div>
            <span class="overline">// DELIVERABLES &amp; COMMITS</span>
            <h3 class="text-base font-bold text-fg">My Tasks (<%= tasks.length %>)</h3>
          </div>
          <span class="badge badge-neutral text-[9px] font-mono"><%= tasks.length %> Assigned</span>
        </div>

        <% if (tasks.length === 0) { %>
          <div class="panel p-8 text-center text-muted text-xs">
            No tasks assigned to your roster on this team yet.
          </div>
        <% } %>

        <div class="space-y-3">
          <% tasks.forEach(function(task, i) { %>
            <button
              type="button"
              onclick="openTaskModal(<%= i %>)"
              class="panel p-5 w-full text-left bg-surface hover:bg-surface-2 hover:border-lime/40 transition-colors block cursor-pointer"
            >
              <div class="flex items-start justify-between gap-3 mb-2">
                <h4 class="text-sm font-bold text-fg"><%= task.title %></h4>
                <span class="badge <%= task.my_status === 'completed' ? 'badge-green' : 'badge-lime' %> font-mono text-[8px] uppercase">
                  <%= task.my_status %>
                </span>
              </div>
              <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-muted">
                <span class="mono text-lime font-bold">⏱ +<%= task.assigned_hours %> hrs</span>
                <% if (task.due_at) { %>
                  <span>📅 Due <%= new Date(task.due_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></span>
                <% } %>
                <span>👥 <%= task.assignees.length %> assigned</span>
              </div>
            </button>
          <% }); %>
        </div>
      </section>

      <!-- RIGHT: Group Chat -->
      <section id="chat" class="panel flex flex-col h-[70vh] overflow-hidden bg-surface">
        <div class="panel-head">
          <div>
            <span class="overline text-lime">// COMMS CHANNEL</span>
            <h3 class="text-sm font-bold text-fg">Squad Encrypted Chat</h3>
          </div>
          <span id="chat-status" class="badge badge-green font-mono text-[8px]">CONNECTING…</span>
        </div>

        <div id="chat-messages" class="flex-1 overflow-y-auto p-5 space-y-4 bg-surface-2">
          <% messages.forEach(function(msg) { %>
            <div class="chat-msg <%= msg.sender_id === user.id ? 'text-right' : '' %>">
              <div class="text-[10px] font-mono text-muted mb-1">
                <%= msg.sender_id === user.id ? 'You' : (msg.sender_name || 'Squad Member') %>
                · <%= new Date(msg.created_at).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }) %>
              </div>
              <div class="inline-block max-w-[85%] rounded-xl px-4 py-2 text-xs <%= msg.sender_id === user.id ? 'bg-lime text-black font-semibold' : 'bg-surface border border-line text-fg' %>">
                <%= msg.content %>
              </div>
            </div>
          <% }); %>
        </div>

        <form id="chat-form" action="/teams/<%= team.id %>/chat" method="POST" class="p-3 bg-surface border-t border-line flex gap-2">
          <input
            type="text"
            name="content"
            id="chat-input"
            placeholder="Type message to team…"
            required
            autocomplete="off"
            class="flex-1 bg-surface-2 border border-line rounded-lg px-3 py-2 text-xs text-fg focus:outline-none focus:border-lime"
          />
          <button type="submit" class="button button-primary text-xs font-bold px-4">
            Send
          </button>
        </form>
      </section>
    </div>
  </main>

  <!-- Task Detail Modal -->
  <div id="task-modal" class="hidden fixed inset-0 z-50 items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/80 backdrop-blur-sm" onclick="closeTaskModal()"></div>
    <div class="relative panel border border-line bg-surface rounded-2xl max-w-lg w-full p-6 max-h-[85vh] overflow-y-auto shadow-2xl">
      <button type="button" onclick="closeTaskModal()" class="absolute top-4 right-4 text-muted hover:text-fg text-sm">✕</button>
      <div id="task-modal-body"></div>
    </div>
  </div>

  <script>
    const currentUserId = '<%= user.id %>';
    const tasks = <%- JSON.stringify(tasks) %>;

    function escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = str == null ? '' : str;
      return div.innerHTML;
    }

    function openTaskModal(index) {
      const task = tasks[index];
      const modal = document.getElementById('task-modal');
      const body = document.getElementById('task-modal-body');

      const dueText = task.due_at
        ? new Date(task.due_at).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' })
        : 'No due date set';

      const assigneesHtml = task.assignees.map((a) => {
        const you = a.student_id === currentUserId ? ' <span class="text-lime font-bold">(you)</span>' : '';
        return `<li class="flex items-center justify-between text-xs border-b border-line/50 py-2.5 last:border-0">
          <span class="text-fg font-medium">${escapeHtml(a.name)}${you}</span>
          <span class="badge badge-neutral font-mono text-[8px] uppercase">${escapeHtml(a.status)}</span>
        </li>`;
      }).join('');

      body.innerHTML = `
        <span class="badge badge-lime text-[9px] font-mono mb-2">TASK SPEC</span>
        <h2 class="text-xl font-bold text-fg mb-4">${escapeHtml(task.title)}</h2>

        <div class="grid grid-cols-2 gap-3 mb-5">
          <div class="panel p-3.5 bg-surface-2 border border-line">
            <span class="overline text-[8px] text-muted block mb-1">DUE DATE</span>
            <strong class="text-xs text-fg block">${escapeHtml(dueText)}</strong>
          </div>
          <div class="panel p-3.5 bg-surface-2 border border-line">
            <span class="overline text-[8px] text-muted block mb-1">CREDITED AWARD</span>
            <strong class="text-xs text-lime mono block">+${escapeHtml(task.assigned_hours)} hrs</strong>
          </div>
        </div>

        <div class="mb-5">
          <span class="overline text-muted text-[8px] block mb-1">INSTRUCTIONS &amp; CRITERIA</span>
          <p class="text-xs text-muted leading-relaxed whitespace-pre-line">${escapeHtml(task.description) || 'No specific criteria written.'}</p>
        </div>

        <div>
          <span class="overline text-muted text-[8px] block mb-2">ASSIGNED ROSTER (${task.assignees.length})</span>
          <ul class="divide-y divide-line">${assigneesHtml}</ul>
        </div>
      `;

      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeTaskModal() {
      const modal = document.getElementById('task-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    const teamId = '<%= team.id %>';
    const chatBox = document.getElementById('chat-messages');
    const chatForm = document.getElementById('chat-form');
    const chatInput = document.getElementById('chat-input');
    const chatStatus = document.getElementById('chat-status');

    let lastSeenAt = <%- JSON.stringify(messages.length ? messages[messages.length - 1].created_at : null) %>;

    function isAtBottom() {
      return chatBox.scrollTop + chatBox.clientHeight >= chatBox.scrollHeight - 40;
    }

    function appendMessage(msg) {
      const mine = msg.sender_id === currentUserId;
      const wrap = document.createElement('div');
      wrap.className = 'chat-msg' + (mine ? ' text-right' : '');
      wrap.innerHTML = `
        <div class="text-[10px] font-mono text-muted mb-1">
          ${mine ? 'You' : escapeHtml(msg.sender_name || 'Member')}
          · ${new Date(msg.created_at).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' })}
        </div>
        <div class="inline-block max-w-[85%] rounded-xl px-4 py-2 text-xs ${mine ? 'bg-lime text-black font-semibold' : 'bg-surface border border-line text-fg'}">
          ${escapeHtml(msg.content)}
        </div>
      `;
      const wasAtBottom = isAtBottom();
      chatBox.appendChild(wrap);
      if (msg.created_at > (lastSeenAt || '')) lastSeenAt = msg.created_at;
      if (wasAtBottom || mine) chatBox.scrollTop = chatBox.scrollHeight;
    }

    if (typeof io === 'function') {
      const socket = io({ withCredentials: true });
      socket.on('connect', () => {
        chatStatus.textContent = 'ONLINE';
        chatStatus.className = 'badge badge-green font-mono text-[8px]';
        socket.emit('team:join', teamId);
      });
      socket.on('disconnect', () => {
        chatStatus.textContent = 'RECONNECTING';
        chatStatus.className = 'badge badge-amber font-mono text-[8px]';
      });
      socket.on('chat:message', (msg) => {
        if (msg.team_id === teamId) appendMessage(msg);
      });
    }

    chatForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const content = chatInput.value.trim();
      if (!content) return;
      chatInput.value = '';

      try {
        const res = await fetch(chatForm.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content }),
        });
        if (!res.ok) console.error('Failed to transmit message');
      } catch (err) {
        console.error(err);
      }
    });
  </script>
</body>
</html>
