<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Student Semester Reports Verification — CampusBuzz' }) %>
</head>
<body class="font-sans text-fg antialiased bg-bg">
  <%- include('../partials/nav') %>

  <main class="page max-w-6xl mx-auto pt-8 pb-20">
    <div class="mb-6 flex items-center justify-between">
      <a href="/faculty/dashboard" class="text-xs font-mono text-muted hover:text-fg text-decoration-none flex items-center gap-1.5">
        ← Back to Faculty Desk
      </a>
      <span class="badge badge-lime font-mono text-[9px]">F023 COMPLIANCE</span>
    </div>

    <!-- Header Section -->
    <section class="welcome-row mb-8">
      <div>
        <span class="overline text-lime">// STUDENT HOURS &amp; ACCREDITATION AUDIT</span>
        <h1>Student Semester Reports Verification</h1>
        <p>Verify student submitted activity hours. Review individual reports with direct options to <strong class="text-lime">Tick (Approve)</strong>, <strong class="text-red-400">Cross (Reject)</strong>, or <strong class="text-amber-400">Send back for re-verification</strong>.</p>
      </div>

      <div class="date-tile">
        <strong><%= reports.length %></strong>
        <small>REPORTS</small>
      </div>
    </section>

    <% if (message) { %>
      <div class="panel p-4 mb-6 bg-lime/10 border border-lime/40 text-lime text-xs flex items-center gap-2">
        <span class="font-bold">✓</span> <%= message %>
      </div>
    <% } %>

    <!-- Filter Pills -->
    <div class="flex flex-wrap items-center gap-2 mb-6">
      <a href="/faculty/reports" class="badge <%= currentFilter === 'all' ? 'badge-lime' : 'badge-neutral' %> text-xs px-3.5 py-1.5 text-decoration-none">
        All Reports
      </a>
      <a href="/faculty/reports?status=pending" class="badge <%= currentFilter === 'pending' ? 'badge-lime' : 'badge-neutral' %> text-xs px-3.5 py-1.5 text-decoration-none">
        Pending Review
      </a>
      <a href="/faculty/reports?status=approved" class="badge <%= currentFilter === 'approved' ? 'badge-lime' : 'badge-neutral' %> text-xs px-3.5 py-1.5 text-decoration-none">
        Verified (Approved)
      </a>
      <a href="/faculty/reports?status=reverification" class="badge <%= currentFilter === 'reverification' ? 'badge-lime' : 'badge-neutral' %> text-xs px-3.5 py-1.5 text-decoration-none">
        Needs Re-verification
      </a>
      <a href="/faculty/reports?status=rejected" class="badge <%= currentFilter === 'rejected' ? 'badge-lime' : 'badge-neutral' %> text-xs px-3.5 py-1.5 text-decoration-none">
        Rejected
      </a>
    </div>

    <!-- Reports Table Panel -->
    <div class="panel overflow-hidden">
      <div class="panel-head">
        <div>
          <span class="overline">// VERIFICATION QUEUE</span>
          <h3 class="text-base font-bold text-fg">Submitted Student Transcripts (<%= club ? club.name : 'PASC' %>)</h3>
        </div>
        <span class="badge badge-green font-mono text-[9px]"><%= reports.length %> in view</span>
      </div>

      <% if (reports.length === 0) { %>
        <div class="p-12 text-center text-muted text-xs">
          No semester reports matching the selected filter.
        </div>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Student Candidate</th>
                <th>Roll Number</th>
                <th>Dept &amp; Year</th>
                <th>Semester &amp; Year</th>
                <th class="text-center">Claimed Hours</th>
                <th>Status</th>
                <th class="text-right">Action</th>
              </tr>
            </thead>
            <tbody>
              <% reports.forEach(function(rep) { %>
                <tr>
                  <td>
                    <strong class="text-xs text-fg block"><%= rep.student_name %></strong>
                    <span class="mono text-[10px] text-muted"><%= rep.student_email %></span>
                  </td>
                  <td class="mono text-xs text-fg">
                    <%= rep.roll_number || '41125' %>
                  </td>
                  <td class="text-xs text-muted">
                    <%= rep.department || 'CE' %> (Yr <%= rep.student_year || '2' %>)
                  </td>
                  <td class="mono text-xs">
                    Sem <%= rep.semester %> (<%= rep.academic_year %>)
                  </td>
                  <td class="text-center mono font-bold text-lime">
                    <%= parseFloat(rep.total_hours || 0).toFixed(1) %> hrs
                  </td>
                  <td>
                    <span class="badge <%= rep.status === 'approved' ? 'badge-green' : rep.status === 'rejected' ? 'badge-red' : rep.status === 'reverification' ? 'badge-amber' : 'badge-lime' %> font-mono text-[8px]">
                      <%= rep.status === 'approved' ? '✓ VERIFIED' : rep.status === 'rejected' ? '✕ REJECTED' : rep.status === 'reverification' ? '↺ RE-VERIFY' : 'PENDING' %>
                    </span>
                  </td>
                  <td class="text-right">
                    <a href="/faculty/reports/<%= rep.id %>" class="button button-primary text-[9px] py-1.5 px-3.5 text-decoration-none">
                      Inspect &amp; Verify →
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </main>
</body>
</html>
