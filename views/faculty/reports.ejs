<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="font-sans text-fg antialiased">
  <%- include('../partials/nav') %>

  <main class="max-w-[1400px] mx-auto px-4 sm:px-8 py-10">
    <div class="mb-6 flex items-center justify-between">
      <a href="/faculty/dashboard" class="text-xs font-mono text-muted hover:text-fg">&larr; Back to Command Center</a>
    </div>

    <div class="flex items-center gap-3 mb-2">
      <span class="w-6 h-px bg-lime"></span>
      <span class="font-mono text-xs tracking-[0.2em] text-lime">// STUDENT HOURS &amp; ACCREDITATION</span>
    </div>
    <h1 class="font-display text-3xl sm:text-4xl mb-3">Student Semester Reports Verification</h1>
    <p class="text-muted text-sm max-w-2xl mb-8">
      Verify student submitted activity hours. Review individual reports with direct options to <strong>Tick (Approve)</strong>, <strong>Cross (Reject)</strong>, or <strong>Send back for re-verification</strong>.
    </p>

    <% if (message) { %>
      <div class="p-4 mb-6 rounded-lg bg-lime/10 border border-lime/30 text-lime text-sm">
        ✓ <%= message %>
      </div>
    <% } %>

    <!-- Filter Bar -->
    <div class="flex flex-wrap items-center gap-2 mb-6">
      <a href="/faculty/reports" class="px-3 py-1.5 rounded text-xs font-mono font-semibold transition-colors
        <%= currentFilter === 'all' ? 'bg-lime text-black' : 'border border-line text-muted hover:text-fg' %>">
        All Reports
      </a>
      <a href="/faculty/reports?status=pending" class="px-3 py-1.5 rounded text-xs font-mono font-semibold transition-colors
        <%= currentFilter === 'pending' ? 'bg-lime text-black' : 'border border-line text-muted hover:text-fg' %>">
        Pending Review
      </a>
      <a href="/faculty/reports?status=approved" class="px-3 py-1.5 rounded text-xs font-mono font-semibold transition-colors
        <%= currentFilter === 'approved' ? 'bg-lime text-black' : 'border border-line text-muted hover:text-fg' %>">
        Verified (Approved)
      </a>
      <a href="/faculty/reports?status=reverification" class="px-3 py-1.5 rounded text-xs font-mono font-semibold transition-colors
        <%= currentFilter === 'reverification' ? 'bg-lime text-black' : 'border border-line text-muted hover:text-fg' %>">
        Needs Re-verification
      </a>
      <a href="/faculty/reports?status=rejected" class="px-3 py-1.5 rounded text-xs font-mono font-semibold transition-colors
        <%= currentFilter === 'rejected' ? 'bg-lime text-black' : 'border border-line text-muted hover:text-fg' %>">
        Rejected
      </a>
    </div>

    <!-- Reports Table -->
    <div class="border border-line rounded-xl bg-panel overflow-hidden">
      <% if (reports.length === 0) { %>
        <div class="p-12 text-center text-muted text-sm">
          No semester reports matching the selected filter.
        </div>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-black/30 font-mono text-[10px] text-muted tracking-wider uppercase border-b border-line">
              <tr>
                <th class="px-6 py-4">Student Name</th>
                <th class="px-6 py-4">Roll Number</th>
                <th class="px-6 py-4">Department &amp; Year</th>
                <th class="px-6 py-4">Semester &amp; Year</th>
                <th class="px-6 py-4 text-center">Claimed Hours</th>
                <th class="px-6 py-4">Status</th>
                <th class="px-6 py-4 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line">
              <% reports.forEach(function(rep) { %>
                <tr class="hover:bg-white/[0.02] transition-colors">
                  <td class="px-6 py-4 font-semibold text-fg">
                    <%= rep.student_name %>
                    <div class="text-xs text-muted font-normal"><%= rep.student_email %></div>
                  </td>
                  <td class="px-6 py-4 font-mono text-xs text-fg">
                    <%= rep.roll_number || 'N/A' %>
                  </td>
                  <td class="px-6 py-4 text-xs text-muted">
                    <%= rep.department || 'Eng' %> (Yr <%= rep.student_year || '1' %>)
                  </td>
                  <td class="px-6 py-4 text-xs font-mono">
                    Sem <%= rep.semester %> (<%= rep.academic_year %>)
                  </td>
                  <td class="px-6 py-4 text-center font-mono font-bold text-lime">
                    <%= rep.total_hours %> hrs
                  </td>
                  <td class="px-6 py-4">
                    <span class="inline-flex items-center gap-1 text-[11px] font-mono px-2.5 py-0.5 rounded-full uppercase
                      <%= rep.status === 'approved' ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/40' :
                          rep.status === 'rejected' ? 'bg-red-500/20 text-red-400 border border-red-500/40' :
                          rep.status === 'reverification' ? 'bg-amber-500/20 text-amber-300 border border-amber-500/40' :
                          'bg-sky-500/20 text-sky-400 border border-sky-500/40' %>">
                      <%= rep.status === 'approved' ? '✓ VERIFIED' :
                          rep.status === 'rejected' ? '✗ REJECTED' :
                          rep.status === 'reverification' ? '↺ RE-VERIFY' : 'PENDING' %>
                    </span>
                  </td>
                  <td class="px-6 py-4 text-right">
                    <a href="/faculty/reports/<%= rep.id %>" class="btn-lime text-xs font-semibold px-3.5 py-1.5 bg-lime text-black rounded hover:opacity-90 inline-flex items-center gap-1">
                      <span>Inspect &amp; Verify</span> &rarr;
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </main>
</body>
</html>
