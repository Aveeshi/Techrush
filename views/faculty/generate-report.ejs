<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Faculty Activity Report Generator — CampusBuzz' }) %>
  <style>
    @media print {
      body { background: #ffffff !important; color: #000000 !important; }
      header, .no-print { display: none !important; }
      .print-box { border: 2px solid #000000 !important; background: #ffffff !important; color: #000000 !important; }
      .text-fg, .text-muted, th, td { color: #000000 !important; }
      .border-line { border-color: #888888 !important; }
    }
  </style>
</head>
<body class="font-sans text-fg antialiased bg-bg">
  <div class="no-print">
    <%- include('../partials/nav') %>
  </div>

  <main class="page max-w-6xl mx-auto pt-8 pb-20">
    <div class="no-print mb-6 flex items-center justify-between">
      <a href="/faculty/dashboard" class="text-xs font-mono text-muted hover:text-fg text-decoration-none">
        ← Back to Faculty Desk
      </a>
      <% if (reportData) { %>
        <button onclick="window.print()" class="button button-primary text-xs flex items-center gap-1.5">
          <span>🖨️</span> Print / Save Report PDF
        </button>
      <% } %>
    </div>

    <div class="no-print mb-8">
      <div class="flex items-center gap-2 mb-2">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        <span class="overline text-[10px] tracking-widest text-amber-400">// AUDIT &amp; ACCREDITATION ENGINE</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-fg mb-2">
        Club Activity Report Generator
      </h1>
      <p class="text-sm text-muted max-w-2xl">
        Generate signed yearly, monthly, weekly, or individual event attendance reports for <strong class="text-lime"><%= club ? club.name : 'ACM Student Chapter (PASC)' %></strong>.
      </p>
    </div>

    <!-- Report Filter Form (CampusBuzz UI Design) -->
    <div class="no-print panel p-6 sm:p-8 mb-8 bg-surface-2 border border-line">
      <form method="GET" action="/faculty/generate-report" class="grid grid-cols-1 sm:grid-cols-4 gap-4 items-end">
        <input type="hidden" name="run" value="1" />

        <div>
          <label class="field-label mb-1.5">
            REPORT TIMEFRAME
            <select name="timeframe" id="tf-select" onchange="updateFormFields()" class="bg-surface border border-line text-xs py-2.5">
              <option value="yearly" <%= timeframe === 'yearly' ? 'selected' : '' %>>Yearly Report (Annual Dossier)</option>
              <option value="monthly" <%= timeframe === 'monthly' ? 'selected' : '' %>>Monthly Report</option>
              <option value="weekly" <%= timeframe === 'weekly' ? 'selected' : '' %>>Weekly Report (Last 7 Days)</option>
              <option value="event" <%= timeframe === 'event' ? 'selected' : '' %>>Individual Event Roster</option>
            </select>
          </label>
        </div>

        <div id="year-field">
          <label class="field-label mb-1.5">
            ACADEMIC YEAR
            <select name="year" class="bg-surface border border-line text-xs py-2.5">
              <option value="2026" <%= String(year) === '2026' ? 'selected' : '' %>>2026</option>
              <option value="2025" <%= String(year) === '2025' ? 'selected' : '' %>>2025</option>
            </select>
          </label>
        </div>

        <div id="month-field">
          <label class="field-label mb-1.5">
            CALENDAR MONTH
            <select name="month" class="bg-surface border border-line text-xs py-2.5">
              <% const months = ['January','February','March','April','May','June','July','August','September','October','November','December']; %>
              <% months.forEach(function(m, idx) { %>
                <option value="<%= idx + 1 %>" <%= Number(month) === (idx + 1) ? 'selected' : '' %>><%= m %></option>
              <% }); %>
            </select>
          </label>
        </div>

        <div id="event-field" style="display: none;">
          <label class="field-label mb-1.5">
            SELECT EVENT
            <select name="eventId" class="bg-surface border border-line text-xs py-2.5">
              <% allEvents.forEach(function(ev) { %>
                <option value="<%= ev.id %>" <%= eventId === ev.id ? 'selected' : '' %>><%= ev.title %></option>
              <% }); %>
            </select>
          </label>
        </div>

        <div>
          <button type="submit" class="button button-primary w-full text-xs font-bold py-2.5">
            Generate Audit Dossier →
          </button>
        </div>
      </form>
    </div>

    <script>
      function updateFormFields() {
        const tf = document.getElementById('tf-select').value;
        document.getElementById('year-field').style.display = (tf === 'weekly' || tf === 'event') ? 'none' : 'block';
        document.getElementById('month-field').style.display = (tf === 'monthly') ? 'block' : 'none';
        document.getElementById('event-field').style.display = (tf === 'event') ? 'block' : 'none';
      }
      updateFormFields();
    </script>

    <!-- Generated Report Output (Paper & PDF Sheet) -->
    <% if (reportData) { %>
      <div class="print-box panel p-8 sm:p-12 border-2 border-line bg-surface mb-8 shadow-2xl">
        <!-- Letterhead -->
        <div class="text-center border-b-2 border-line pb-6 mb-8">
          <div class="text-[11px] text-muted tracking-wider uppercase font-semibold">
            Society for Computer Technology &amp; Research's
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-fg my-1">
            PUNE INSTITUTE OF COMPUTER TECHNOLOGY
          </h2>
          <div class="font-mono text-xs uppercase text-lime tracking-widest mt-1">
            <%= club ? club.name : 'ACM Student Chapter (PASC)' %> • <%= timeframe.toUpperCase() %> AUDIT REPORT
          </div>
          <div class="text-xs text-muted mt-1">
            Faculty In-Charge: <strong><%= fc.name %></strong> (<%= fc.department %>) • Generated: <%= new Date().toLocaleDateString() %>
          </div>
        </div>

        <!-- High-level Metric Strip -->
        <% 
          let totalEvents = reportData.length;
          let totalStudentsAttended = 0;
          let totalHoursGenerated = 0;
          reportData.forEach(ev => {
            const attCount = ev.attendees ? ev.attendees.length : 0;
            totalStudentsAttended += attCount;
            totalHoursGenerated += (Number(ev.credit_hours) || 0) * attCount;
          });
        %>

        <div class="admin-stats mb-8">
          <article class="panel stat-wide s0">
            <span class="metric-icon">📅</span>
            <div>
              <p>EVENTS CONDUCTED</p>
              <h2><%= totalEvents %></h2>
            </div>
            <span class="badge badge-green font-mono">VERIFIED</span>
          </article>

          <article class="panel stat-wide s1">
            <span class="metric-icon">👥</span>
            <div>
              <p>VERIFIED ATTENDANCES</p>
              <h2><%= totalStudentsAttended %></h2>
            </div>
            <span class="badge badge-lime font-mono">ROSTER LOGGED</span>
          </article>

          <article class="panel stat-wide s2">
            <span class="metric-icon">⏱️</span>
            <div>
              <p>TOTAL HOURS AWARDED</p>
              <h2><%= totalHoursGenerated %> <small class="text-xs">hrs</small></h2>
            </div>
            <span class="badge badge-green font-mono">ACCREDITED</span>
          </article>
        </div>

        <% if (reportData.length === 0) { %>
          <div class="p-8 text-center text-muted text-sm border border-line rounded-xl">
            No events found for the selected timeframe.
          </div>
        <% } else { %>
          <div class="space-y-8">
            <% reportData.forEach(function(ev, idx) { %>
              <div class="panel border border-line rounded-xl overflow-hidden">
                <div class="p-5 border-b border-line bg-surface-2 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                  <div>
                    <span class="mono text-xs text-lime font-bold">#<%= idx + 1 %></span>
                    <h3 class="font-bold text-base text-fg inline ml-1"><%= ev.title %></h3>
                    <div class="text-xs text-muted mt-1 space-x-2">
                      <span>Date: <%= new Date(ev.start_time).toLocaleDateString() %></span>
                      <span>•</span>
                      <span>Venue: <%= ev.venue || 'PICT Campus' %></span>
                      <span>•</span>
                      <span>Credit Hours: <strong class="mono text-lime">+<%= ev.credit_hours || 4 %> hrs</strong></span>
                    </div>
                  </div>

                  <span class="badge badge-green font-mono text-[9px] self-start sm:self-auto">
                    <%= ev.attendees.length %> Students Attended
                  </span>
                </div>

                <!-- Attendee List -->
                <% if (ev.attendees.length === 0) { %>
                  <div class="p-4 text-xs text-muted text-center">
                    No verified attendee check-ins recorded for this event.
                  </div>
                <% } else { %>
                  <div class="table-wrap">
                    <table>
                      <thead>
                        <tr>
                          <th style="width: 40px;">#</th>
                          <th>Roll Number</th>
                          <th>Student Name</th>
                          <th>Department &amp; Year</th>
                          <th>Check-in Timestamp</th>
                          <th class="text-right">Credit Awarded</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% ev.attendees.forEach(function(att, aIdx) { %>
                          <tr>
                            <td class="mono font-bold"><%= aIdx + 1 %></td>
                            <td class="mono font-bold text-fg"><%= att.roll_number || 'N/A' %></td>
                            <td><strong class="text-fg text-xs"><%= att.student_name %></strong></td>
                            <td class="text-xs text-muted"><%= att.department || 'CE' %> (Yr <%= att.year || '2' %>)</td>
                            <td class="mono text-xs text-muted"><%= new Date(att.checked_in_at).toLocaleTimeString() %></td>
                            <td class="mono font-bold text-lime text-right">+<%= att.credit_hours %> hrs</td>
                          </tr>
                        <% }); %>
                      </tbody>
                    </table>
                  </div>
                <% } %>
              </div>
            <% }); %>
          </div>
        <% } %>

        <!-- Signature Block -->
        <div class="pt-10 mt-10 border-t-2 border-line grid grid-cols-2 gap-8 text-center text-xs">
          <div>
            <div class="h-12 border-b border-dashed border-line flex items-end justify-center pb-1">
              <span class="font-mono text-[11px] text-lime font-bold"><%= fc.name %></span>
            </div>
            <span class="text-[10px] text-muted mt-2 block uppercase tracking-wider">Faculty In-Charge Signature</span>
          </div>
          <div>
            <div class="h-12 border-b border-dashed border-line flex items-end justify-center pb-1">
              <span class="font-mono text-[11px] text-fg font-bold">Directorate of Student Welfare</span>
            </div>
            <span class="text-[10px] text-muted mt-2 block uppercase tracking-wider">Institutional Dean / Principal</span>
          </div>
        </div>
      </div>
    <% } %>
  </main>
</body>
</html>
