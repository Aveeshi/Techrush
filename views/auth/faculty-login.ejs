<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Faculty Coordinator Review Desk — CampusBuzz' }) %>
</head>
<body class="font-sans text-fg antialiased bg-bg">
  <%- include('../partials/nav') %>

  <div class="login-screen">
    <!-- Left Visual Panel (CampusBuzz Design) -->
    <div class="login-visual">
      <div class="brand">
        <span class="brand-mark"><span>CB</span></span>
        <span class="brand-word">Campus<span>Buzz</span></span>
      </div>

      <div class="visual-copy">
        <span class="badge badge-amber mb-4">FACULTY ADVISORY NODE</span>
        <h1>Event Sanctions &<br /><span>Credit Sign-Off.</span></h1>
        <p>Official faculty convener workspace to review upcoming student event proposals, approve semester credit hours, and assign student coordinators.</p>
      </div>

      <div class="orb orb-one"></div>
      <div class="orb orb-two"></div>

      <div class="floating-card f-one">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
        <span>
          <small>FACULTY CONVENER DESK</small>
          <strong>Club Event Permissions &amp; Hours</strong>
        </span>
      </div>

      <div class="floating-card f-two">
        <span class="avatar">FC</span>
        <span>
          <small>SANCTION AUTHORITY</small>
          <strong>Official Department Sign-Off</strong>
        </span>
      </div>

      <small class="copyright">© <%= new Date().getFullYear() %> CAMPUSBUZZ PROTOCOL · FACULTY COUNCIL</small>
    </div>

    <!-- Right Form Section -->
    <main class="login-form-wrap">
      <a href="/auth/login" class="back-button">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M13 6l6 6-6 6"/>
        </svg>
        Back to Student Login
      </a>

      <div class="login-form">
        <span class="overline">FACULTY DESK AUTHENTICATION</span>
        <h2>Faculty Coordinator</h2>
        <p>Sign in to review club events and verify student transcripts.</p>

        <% if (errors && errors.length > 0) { %>
          <div class="badge badge-red mb-4 p-3 w-full justify-start text-xs rounded-lg">
            <ul class="list-disc list-inside space-y-0.5">
              <% errors.forEach(function(error) { %>
                <li><%= error %></li>
              <% }); %>
            </ul>
          </div>
        <% } %>

        <form action="/auth/faculty/login" method="POST">
          <label class="field-label mb-3">
            FACULTY EMAIL ADDRESS
            <input type="email" name="email" value="<%= oldInput.email || '' %>" placeholder="fc.roboticsclub@pict.edu" required />
          </label>

          <label class="field-label mb-4">
            PASSWORD
            <div class="password-field">
              <input type="password" id="faculty-pass" name="password" placeholder="••••••••" required />
              <button type="button" onclick="togglePass('faculty-pass')">SHOW</button>
            </div>
          </label>

          <button type="submit" class="button button-primary w-full">
            Authenticate Faculty Desk →
          </button>
        </form>

        <div class="mt-6 p-3.5 rounded-xl border border-line bg-surface-2 text-xs space-y-1.5">
          <div class="flex items-center justify-between">
            <span class="text-muted">Sample Credential:</span>
            <code class="mono text-lime bg-surface px-1.5 py-0.5 rounded text-[10px]">fc.roboticsclub@pict.edu</code>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-muted">Default Password:</span>
            <code class="mono text-fg bg-surface px-1.5 py-0.5 rounded text-[10px]">admin123</code>
          </div>
        </div>

        <p class="secure">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          Dedicated Institutional RBAC Node · All actions audit-logged
        </p>
      </div>
    </main>
  </div>

  <script>
    function togglePass(id) {
      const el = document.getElementById(id);
      el.type = el.type === 'password' ? 'text' : 'password';
    }
  </script>
</body>
</html>
