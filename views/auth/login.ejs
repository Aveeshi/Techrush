<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Sign In — CampusBuzz Operating System' }) %>
  <style>
    .role-picker > button.active {
      border-color: var(--lime) !important;
      background: rgba(215, 255, 43, 0.08) !important;
      color: var(--lime) !important;
    }
  </style>
</head>
<body class="auth-page font-sans text-fg antialiased bg-bg">
  <%- include('../partials/nav') %>

  <div class="login-screen">
    <main class="login-form-wrap">
      <a href="/events" class="back-button">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M13 6l6 6-6 6"/>
        </svg>
        Back to events
      </a>

      <div class="auth-intro">
        <span class="overline">SECURE PORTAL</span>
        <h1>Welcome back.</h1>
        <p>Choose your portal to continue.</p>
      </div>

      <div class="login-form">
        <!-- One login entry point with portal selection -->
        <div class="role-picker">
          <button type="button" class="active" id="role-student" data-role="student">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="8" r="6"></circle>
              <path d="M8.5 13 7 22l5-3 5 3-1.5-9"></path>
            </svg>
            <span>
              <strong>Student</strong>
              <small>Track credits & clubs</small>
            </span>
            <i id="check-student">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </i>
          </button>

          <button type="button" id="role-faculty" data-role="faculty">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
              <span>
                <strong>Faculty</strong>
                <small>Review & approve</small>
              </span>
              <i id="check-faculty" style="display:none;">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </i>
          </button>

          <button type="button" id="role-admin" data-role="institutional">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 21h18M6 21V7l6-4 6 4v14"></path>
              </svg>
              <span>
                <strong>Institution</strong>
                <small>Audit & oversight</small>
              </span>
              <i id="check-institutional" style="display:none;">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </i>
          </button>

          <button type="button" id="role-organizer" data-role="organizer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
            </svg>
            <span>
              <strong>President / Chairperson</strong>
              <small>Club operations</small>
            </span>
            <i id="check-organizer" style="display:none;">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </i>
          </button>
        </div>

        <% if (errors && errors.length > 0) { %>
          <div class="badge badge-red mb-4 p-3 w-full justify-start text-xs rounded-lg">
            <ul class="list-disc list-inside space-y-0.5">
              <% errors.forEach(function(error) { %>
                <li><%= error %></li>
              <% }); %>
            </ul>
          </div>
        <% } %>

        <!-- Student Login Form -->
        <div id="form-student-wrap">
          <form action="/auth/student/login" method="POST">
            <label class="field-label mb-3">
              STUDENT EMAIL
              <input type="email" name="email" value="<%= oldInput.email || '' %>" placeholder="student@gmail.com" required />
            </label>

            <label class="field-label mb-4">
              PASSWORD
              <div class="password-field">
                <input type="password" id="student-pass" name="password" placeholder="••••••••" required />
                <button type="button" data-toggle-password="student-pass">SHOW</button>
              </div>
            </label>

            <div class="login-options">
              <label>
                <input type="checkbox" checked /> Keep me signed in
              </label>
              <a href="#" class="text-muted hover:text-lime">Forgot password?</a>
            </div>

            <button type="submit" class="button button-primary w-full">
              Enter Student Hub →
            </button>
          </form>

          <div class="sso">
            <span>OR CONTINUE WITH SSO</span>
            <a href="/auth/google" class="button button-quiet w-full text-decoration-none">
              <svg width="15" height="15" viewBox="0 0 48 48">
                <path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12s5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24s8.955,20,20,20s20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"/>
                <path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"/>
                <path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"/>
                <path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z"/>
              </svg>
              Student Google Account
            </a>
            <p class="auth-signup-prompt">
              New student? <a href="/auth/signup">Create your student account →</a>
            </p>
          </div>
        </div>

        <!-- Organizer Login Form (Toggled) -->
        <div id="form-organizer-wrap" style="display:none;">
          <form action="/auth/organizer/login" method="POST">
            <label class="field-label mb-3">
              PRESIDENT / CHAIRPERSON EMAIL
              <input type="email" name="email" value="<%= oldInput.email || '' %>" placeholder="president@gmail.com" required />
            </label>

            <label class="field-label mb-4">
              PASSWORD
              <div class="password-field">
                <input type="password" id="org-pass" name="password" placeholder="••••••••" required />
                <button type="button" data-toggle-password="org-pass">SHOW</button>
              </div>
            </label>

            <button type="submit" class="button button-primary w-full">
              Enter Club Hub →
            </button>
          </form>
        </div>

        <div id="form-faculty-wrap" style="display:none;">
          <form action="/auth/faculty/login" method="POST">
            <label class="field-label mb-3">
              FACULTY EMAIL ADDRESS
              <input type="email" name="email" value="<%= oldInput.email || '' %>" placeholder="faculty@gmail.com" required />
            </label>

            <label class="field-label mb-4">
              PASSWORD
              <div class="password-field">
                <input type="password" id="faculty-pass" name="password" placeholder="••••••••" required />
                <button type="button" data-toggle-password="faculty-pass">SHOW</button>
              </div>
            </label>

            <button type="submit" class="button button-primary w-full">
              Authenticate Faculty Desk →
            </button>
          </form>
        </div>

        <div id="form-institutional-wrap" style="display:none;">
          <form action="/auth/institutional/login" method="POST">
            <label class="field-label mb-3">
              ADMINISTRATOR EMAIL
              <input type="email" name="email" value="<%= oldInput.email || '' %>" placeholder="institution@gmail.com" required />
            </label>

            <label class="field-label mb-4">
              MASTER PASSWORD
              <div class="password-field">
                <input type="password" id="institutional-pass" name="password" placeholder="••••••••" required />
                <button type="button" data-toggle-password="institutional-pass">SHOW</button>
              </div>
            </label>

            <button type="submit" class="button button-primary w-full">
              Enter Institutional Hub →
            </button>
          </form>
        </div>

        <p class="secure">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          Protected by PICT SSO and 256-bit tamper-proof encryption
        </p>
      </div>
    </main>
  </div>

  <script nonce="<%= cspNonce %>">
    function setRole(role) {
      const roles = ['student', 'organizer', 'faculty', 'institutional'];
      roles.forEach(function (name) {
        const button = document.getElementById('role-' + (name === 'institutional' ? 'admin' : name));
        const check = document.getElementById('check-' + name);
        const form = document.getElementById('form-' + name + '-wrap');

        button.classList.toggle('active', name === role);
        check.style.display = name === role ? 'grid' : 'none';
        form.style.display = name === role ? 'block' : 'none';
      });
    }

    function togglePass(id) {
      const el = document.getElementById(id);
      if (el.type === 'password') {
        el.type = 'text';
      } else {
        el.type = 'password';
      }
    }

    document.querySelectorAll('[data-role]').forEach(function (button) {
      button.addEventListener('click', function () {
        setRole(button.dataset.role);
      });
    });

    document.querySelectorAll('[data-toggle-password]').forEach(function (button) {
      button.addEventListener('click', function () {
        togglePass(button.dataset.togglePassword);
      });
    });

    setRole('<%= initialRole || "student" %>');
  </script>
</body>
</html>
