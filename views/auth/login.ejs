<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <style>
    #tab-student, #tab-organizer { position: absolute; opacity: 0; width: 0; height: 0; }
    .tab-label {
      flex: 1;
      text-align: center;
      padding: 0.75rem;
      border: 1px solid #242424;
      cursor: pointer;
      color: #8a8a8a;
      font-size: 0.875rem;
      font-weight: 600;
      transition: all .15s ease;
    }
    #tab-student:checked ~ .tab-bar label[for="tab-student"],
    #tab-organizer:checked ~ .tab-bar label[for="tab-organizer"] {
      background-color: #d7ff2b;
      border-color: #d7ff2b;
      color: #0a0a0a;
    }
    #student-panel, #organizer-panel { display: none; }
    #tab-student:checked ~ #student-panel { display: block; }
    #tab-organizer:checked ~ #organizer-panel { display: block; }
  </style>
</head>
<body class="font-sans text-fg antialiased">
  <%- include('../partials/nav') %>

  <main class="max-w-md mx-auto px-8 py-16">
    <div class="flex items-center gap-3 mb-6">
      <span class="w-6 h-px bg-lime"></span>
      <span class="font-mono text-xs tracking-[0.2em] text-lime">// WELCOME BACK</span>
    </div>
    <h1 class="font-display text-4xl mb-8">Log In</h1>

    <% if (errors && errors.length > 0) { %>
      <div class="border border-red-500 bg-red-500/10 text-red-400 px-4 py-3 rounded-md mb-6 text-sm">
        <ul class="list-disc list-inside space-y-1">
          <% errors.forEach(function(error) { %>
            <li><%= error %></li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <a href="/auth/google"
       class="w-full flex items-center justify-center gap-3 border border-line rounded-md py-3 mb-6 bg-panel text-fg font-medium hover:bg-white/5 transition-colors">
      <svg width="18" height="18" viewBox="0 0 48 48">
        <path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12
            s5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24
            s8.955,20,20,20s20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"/>
        <path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039
            l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"/>
        <path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36
            c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"/>
        <path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571
            c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24
            C44,22.659,43.862,21.35,43.611,20.083z"/>
      </svg>
      Continue with Google
    </a>

    <div class="flex items-center gap-3 mb-8">
      <div class="flex-grow border-t border-line"></div>
      <span class="text-muted text-xs font-mono">OR LOG IN WITH EMAIL</span>
      <div class="flex-grow border-t border-line"></div>
    </div>

    <input type="radio" name="tab" id="tab-student" value="student" checked />
    <input type="radio" name="tab" id="tab-organizer" value="organizer" />

    <div class="tab-bar flex mb-8 rounded-md overflow-hidden">
      <label for="tab-student" class="tab-label">STUDENT</label>
      <label for="tab-organizer" class="tab-label">ORGANIZER</label>
    </div>

    <div id="student-panel">
      <form action="/auth/student/login" method="POST">
        <input type="email" name="email" placeholder="Email"
               value="<%= oldInput.email || '' %>"
               class="w-full px-4 py-3 mb-4 bg-panel border border-line rounded-md text-fg placeholder-muted focus:outline-none focus:border-lime" required />
        <input type="password" name="password" placeholder="Password"
               class="w-full px-4 py-3 mb-6 bg-panel border border-line rounded-md text-fg placeholder-muted focus:outline-none focus:border-lime" required />
        <button type="submit" class="btn-lime w-full bg-lime text-black font-semibold py-3.5 rounded-md">
          Log in as student
        </button>
      </form>
    </div>

    <div id="organizer-panel">
      <form action="/auth/organizer/login" method="POST">
        <input type="email" name="email" placeholder="Email"
               value="<%= oldInput.email || '' %>"
               class="w-full px-4 py-3 mb-4 bg-panel border border-line rounded-md text-fg placeholder-muted focus:outline-none focus:border-lime" required />
        <input type="password" name="password" placeholder="Password"
               class="w-full px-4 py-3 mb-6 bg-panel border border-line rounded-md text-fg placeholder-muted focus:outline-none focus:border-lime" required />
        <button type="submit" class="btn-lime w-full bg-lime text-black font-semibold py-3.5 rounded-md">
          Log in as organizer
        </button>
      </form>
    </div>

    <p class="text-muted text-sm text-center mt-6">
      New here? <a href="/auth/signup" class="text-lime hover:underline">Create an account</a>
    </p>
  </main>
</body>
</html>
