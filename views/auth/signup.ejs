<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Create Account — CampusBuzz Operating System' }) %>
  <style>
    #tab-student, #tab-organizer { position: absolute; opacity: 0; width: 0; height: 0; }
    .role-btn {
      flex: 1;
      text-align: center;
      padding: 0.75rem;
      border: 1px solid var(--line);
      cursor: pointer;
      color: var(--muted);
      font-size: 0.75rem;
      font-weight: 700;
      background: var(--surface);
      border-radius: 10px;
      transition: all .15s ease;
    }
    #tab-student:checked ~ .role-tabs label[for="tab-student"],
    #tab-organizer:checked ~ .role-tabs label[for="tab-organizer"] {
      background: var(--lime);
      color: var(--lime-ink);
      border-color: var(--lime);
    }
    #student-panel, #organizer-panel { display: none; }
    #tab-student:checked ~ #student-panel { display: block; }
    #tab-organizer:checked ~ #organizer-panel { display: block; }
  </style>
</head>
<body class="font-sans text-fg antialiased bg-bg">
  <%- include('../partials/nav') %>

  <div class="login-screen">
    <!-- Left Visual Panel -->
    <div class="login-visual">
      <div class="brand">
        <span class="brand-mark"><span>CB</span></span>
        <span class="brand-word">Campus<span>Buzz</span></span>
      </div>

      <div class="visual-copy">
        <span class="badge badge-lime mb-4">ONBOARDING GATEWAY</span>
        <h1>Join your institutional<br /><span>Ledger.</span></h1>
        <p>Register as a student candidate or student club executive to automatically log verified CCA hours, check in to workshops, and generate certified transcripts.</p>
      </div>

      <div class="orb orb-one"></div>
      <div class="orb orb-two"></div>

      <!-- Floating Achievement Cards -->
      <div class="floating-card f-one">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>
          <small>ACCREDITATION</small>
          <strong>Course F023: CCA-I Compliant</strong>
        </span>
      </div>

      <small class="copyright">© <%= new Date().getFullYear() %> CAMPUSBUZZ PROTOCOL · PUNE INSTITUTE OF COMPUTER TECHNOLOGY</small>
    </div>

    <!-- Right Form Section -->
    <main class="login-form-wrap overflow-y-auto">
      <a href="/auth/login" class="back-button">
        <span>Already have an account? Sign In</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M13 6l6 6-6 6"/>
        </svg>
      </a>

      <div class="login-form my-auto py-6">
        <span class="overline text-lime">// NEW ACCOUNT REGISTRATION</span>
        <h2 class="text-3xl font-extrabold text-fg mt-1 mb-2">Create Account</h2>
        <p class="text-xs text-muted mb-6">Choose account type and configure credentials for institutional sign-off.</p>

        <% if (errors && errors.length > 0) { %>
          <div class="panel p-3.5 mb-6 bg-red-500/10 border border-red-500/30 text-red-400 text-xs">
            <ul class="list-disc list-inside space-y-1">
              <% errors.forEach(function(error) { %><li><%= error %></li><% }); %>
            </ul>
          </div>
        <% } %>

        <a href="/auth/google" class="button button-quiet w-full flex items-center justify-center gap-3 text-xs py-3 mb-6 text-decoration-none">
          <svg width="16" height="16" viewBox="0 0 48 48">
            <path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12s5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24s8.955,20,20,20s20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"/>
            <path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"/>
            <path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"/>
            <path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z"/>
          </svg>
          <span>Sign up with Google</span>
        </a>

        <div class="sso mb-6">
          <span>OR CONTINUE WITH CREDENTIALS</span>
        </div>

        <form action="/auth/signup" method="POST" enctype="multipart/form-data" class="space-y-4">
          <!-- Role selector radio tabs -->
          <input type="radio" name="typeOfUser" id="tab-student" value="student"
                 <%= (typeof oldInput.typeOfUser === 'undefined' || oldInput.typeOfUser === 'student') ? 'checked' : '' %> />
          <input type="radio" name="typeOfUser" id="tab-organizer" value="organizer"
                 <%= oldInput.typeOfUser === 'organizer' ? 'checked' : '' %> />

          <div class="role-tabs flex gap-2 mb-4">
            <label for="tab-student" class="role-btn">STUDENT</label>
            <label for="tab-organizer" class="role-btn">CLUB ORGANIZER</label>
          </div>

          <label class="field-label">
            FULL NAME
            <input type="text" name="name" placeholder="First and last name" value="<%= oldInput.name || '' %>" required />
          </label>

          <label class="field-label">
            EMAIL ADDRESS
            <input type="email" name="email" placeholder="student@pict.edu" value="<%= oldInput.email || '' %>" required />
          </label>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <label class="field-label">
              PASSWORD
              <input type="password" name="password" placeholder="••••••••" required />
            </label>
            <label class="field-label">
              CONFIRM PASSWORD
              <input type="password" name="passwordCopy" placeholder="••••••••" required />
            </label>
          </div>

          <!-- Student Panel -->
          <div id="student-panel" class="space-y-4 pt-2">
            <div class="grid grid-cols-2 gap-3">
              <label class="field-label">
                ROLL / PRN
                <input type="text" name="rollNumber" placeholder="41151" value="<%= oldInput.rollNumber || '' %>" />
              </label>
              <label class="field-label">
                DEPARTMENT
                <input type="text" name="department" placeholder="CE" value="<%= oldInput.department || '' %>" />
              </label>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <label class="field-label">
                ACADEMIC YEAR (1-4)
                <input type="number" name="year" placeholder="2" min="1" max="6" value="<%= oldInput.year || '' %>" />
              </label>
              <label class="field-label">
                PHONE
                <input type="tel" name="phone" placeholder="10 digits" value="<%= oldInput.phone || '' %>" />
              </label>
            </div>

            <label class="field-label">
              PROFILE PHOTO (OPTIONAL)
              <input type="file" name="profilePhoto" accept="image/*"
                     class="text-xs text-muted file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:bg-lime file:text-black file:font-bold file:cursor-pointer" />
            </label>

            <div>
              <span class="overline text-muted text-[8px] block mb-2">// VOLUNTEER SKILLS</span>
              <div class="flex flex-wrap gap-1.5">
                <% skillTags.forEach(function(tag) { %>
                  <label class="badge badge-neutral hover:badge-lime cursor-pointer text-[8px] flex items-center gap-1.5 py-1 px-2.5">
                    <input type="checkbox" name="skillTagIds" value="<%= tag.id %>" class="accent-lime" />
                    <span><%= tag.name %></span>
                  </label>
                <% }); %>
              </div>
            </div>
          </div>

          <!-- Organizer Panel -->
          <div id="organizer-panel" class="space-y-4 pt-2">
            <label class="field-label">
              WHICH CLUB DO YOU REPRESENT?
              <select name="clubId">
                <option value="">Select a club</option>
                <% openSlots.forEach(function(slot) { %>
                  <option value="<%= slot.clubId %>" <%= oldInput.clubId === slot.clubId ? 'selected' : '' %>>
                    <%= slot.clubName %> (<%= slot.openRoles.map(r => r === 'president' ? 'President' : 'VP').join(' + ') %> open)
                  </option>
                <% }); %>
              </select>
            </label>

            <label class="field-label">
              EXECUTIVE ROLE
              <select name="role">
                <option value="">Select a role</option>
                <option value="president" <%= oldInput.role === 'president' ? 'selected' : '' %>>President</option>
                <option value="vice_president" <%= oldInput.role === 'vice_president' ? 'selected' : '' %>>Vice President</option>
              </select>
            </label>
          </div>

          <div class="pt-4">
            <button type="submit" class="button button-primary w-full text-xs font-bold py-3">
              Create CampusBuzz Account →
            </button>
          </div>
        </form>
      </div>
    </main>
  </div>
</body>
</html>
