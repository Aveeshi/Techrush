<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: subEvent.title + ' — CampusBuzz' }) %>
</head>
<body class="font-sans text-fg antialiased bg-bg">
  <%- include('partials/nav') %>

  <main class="page max-w-4xl mx-auto pt-8 pb-20">
    <div class="mb-6 flex items-center justify-between">
      <a href="/events/<%= subEvent.event_id %>" class="text-xs font-mono text-muted hover:text-fg text-decoration-none flex items-center gap-1.5">
        ← BACK TO <%= (subEvent.event_title || 'PARENT EVENT').toUpperCase() %>
      </a>
      <span class="badge badge-lime text-[9px] font-mono">
        <%= (subEvent.event_type_name || 'SUB-EVENT').toUpperCase() %>
      </span>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="badge badge-red mb-6 p-4 w-full rounded-xl text-xs">
        <%= error %>
      </div>
    <% } %>

    <!-- Header Panel -->
    <div class="panel p-6 sm:p-8 mb-8 relative overflow-hidden">
      <div class="flex items-center gap-2 mb-3">
        <span class="overline text-lime">// SUB-TRACK APPLICATION</span>
        <span class="text-xs text-muted">Part of <strong class="text-fg"><%= subEvent.event_title %></strong></span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-fg mb-4 leading-tight">
        <%= subEvent.title %>
      </h1>

      <p class="text-sm text-muted leading-relaxed">
        <%= subEvent.description || 'No detailed specifications provided for this sub-session.' %>
      </p>
    </div>

    <% if (subEvent.banner_url) { %>
      <div class="w-full h-72 rounded-2xl overflow-hidden border border-line mb-8 bg-surface-2">
        <img src="<%= subEvent.banner_url %>" alt="<%= subEvent.title %>" class="w-full h-full object-cover" />
      </div>
    <% } %>

    <!-- Quick Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
      <div class="panel p-5">
        <span class="overline text-[8px] text-muted block mb-1">DATE &amp; SCHEDULE</span>
        <strong class="text-sm text-fg block">
          <%= new Date(subEvent.start_time).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' }) %>
        </strong>
      </div>
      <div class="panel p-5">
        <span class="overline text-[8px] text-muted block mb-1">DESIGNATED VENUE</span>
        <strong class="text-sm text-fg block"><%= subEvent.venue || 'Campus Auditorium' %></strong>
      </div>
      <div class="panel p-5">
        <span class="overline text-[8px] text-muted block mb-1">REGISTRATION CUT-OFF</span>
        <strong class="text-sm text-fg block">
          <%= subEvent.registration_deadline ? new Date(subEvent.registration_deadline).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' }) : 'Open until kickoff' %>
        </strong>
      </div>
    </div>

    <!-- Registration & Pass Interaction Panel -->
    <div class="panel p-8 bg-surface border border-line">
      <% if (!user) { %>
        <div class="text-center py-6">
          <p class="text-sm text-muted mb-4">Log in with your college credentials to claim an attendee pass or sign up as a volunteer.</p>
          <a href="/auth/login" class="button button-primary text-xs text-decoration-none">
            Log In to Register →
          </a>
        </div>

      <% } else if (typeof isHead !== 'undefined' && isHead) { %>
        <div class="flex items-center justify-between gap-4 flex-wrap">
          <div>
            <span class="badge badge-amber text-[9px] mb-1">OPERATIONAL HEAD</span>
            <h3 class="text-base font-bold text-fg">You are appointed as the Lead for this sub-track</h3>
            <p class="text-xs text-muted">Manage volunteers, teams, attendees, and operational logs from your organizer desk.</p>
          </div>
          <a href="/club-events/<%= subEvent.event_id %>/sub-events/<%= subEvent.id %>" class="button button-amber text-xs text-decoration-none">
            Open Sub-Event Management →
          </a>
        </div>

      <% } else if (user.type === 'organizer') { %>
        <% if (user.club_id === subEvent.club_id) { %>
          <div class="flex items-center justify-between gap-4 flex-wrap">
            <div>
              <span class="badge badge-lime text-[9px] mb-1">HOST CLUB</span>
              <h3 class="text-base font-bold text-fg">Organizer Gate Check-In</h3>
              <p class="text-xs text-muted">Scan attendee and volunteer pass QR codes directly using device camera.</p>
            </div>
            <a href="/events/<%= subEvent.event_id %>/sub-events/<%= subEvent.id %>/scan" class="button button-primary text-xs text-decoration-none">
              Launch QR Scanner →
            </a>
          </div>
        <% } else { %>
          <p class="text-xs text-muted">Organizer accounts cannot register as attendees.</p>
        <% } %>

      <% } else if (registration) { %>
        <div>
          <div class="flex items-center justify-between gap-4 mb-4">
            <div>
              <span class="badge <%= registration.status === 'checked_in' ? 'badge-green' : 'badge-lime' %> text-[9px] font-mono mb-1">
                <%= registration.status.toUpperCase() %>
              </span>
              <h3 class="text-lg font-bold text-fg">
                Registered as <%= registration.registration_type === 'volunteer' ? 'a Volunteer' : 'an Attendee' %>
              </h3>
            </div>
          </div>

          <% if (registration.registration_type === 'attendee' && typeof qrImage !== 'undefined' && qrImage) { %>
            <div class="p-6 rounded-xl bg-surface-2 border border-line flex flex-col sm:flex-row items-center gap-6 mt-6">
              <div class="p-2.5 bg-white rounded-xl shadow-lg shrink-0">
                <img src="<%= qrImage %>" alt="Your sub-event QR code" class="w-40 h-40" />
              </div>
              <div>
                <span class="overline text-lime text-[9px] block mb-1">DIGITAL GATE PASS</span>
                <h4 class="text-sm font-bold text-fg mb-1">Present this QR Code at the Entrance</h4>
                <p class="text-xs text-muted mb-3 leading-relaxed">
                  Upon arrival, show this ticket to an appointed Student Coordinator or Volunteer. Scanning validates your attendance and records accredited credit hours for course F023.
                </p>
                <div class="flex items-center gap-2">
                  <span class="badge badge-green font-mono text-[8px]">NON-TRANSFERABLE</span>
                  <span class="text-xs font-mono text-muted">Pass ID: #<%= registration.id.slice(0, 8) %></span>
                </div>
              </div>
            </div>
          <% } %>

          <% if (registration.registration_type === 'volunteer') { %>
            <div class="mt-6 pt-6 border-t border-line flex items-center justify-between">
              <div>
                <h4 class="text-sm font-bold text-fg">Volunteer Team Roster</h4>
                <p class="text-xs text-muted">Manage your sub-event team tasks and assignments.</p>
              </div>
              <a href="/events/<%= subEvent.event_id %>/sub-events/<%= subEvent.id %>/volunteer-teams" class="button button-quiet text-xs text-decoration-none">
                Manage Teams →
              </a>
            </div>
          <% } %>
        </div>

      <% } else { %>
        <div class="flex items-center justify-between flex-wrap gap-4">
          <div>
            <h3 class="text-base font-bold text-fg mb-1">Join this Sub-Event Track</h3>
            <p class="text-xs text-muted">Claim your institutional pass to verify attendance and earn co-curricular credits.</p>
          </div>

          <div class="flex items-center gap-3">
            <form action="/events/<%= subEvent.event_id %>/sub-events/<%= subEvent.id %>/register" method="POST" class="inline">
              <input type="hidden" name="registrationType" value="attendee" />
              <button type="submit" class="button button-primary text-xs">
                Register as Attendee →
              </button>
            </form>

            <% if (canVolunteer) { %>
              <form action="/events/<%= subEvent.event_id %>/sub-events/<%= subEvent.id %>/register" method="POST" class="inline">
                <input type="hidden" name="registrationType" value="volunteer" />
                <button type="submit" class="button button-quiet text-xs">
                  Volunteer for Event →
                </button>
              </form>
            <% } %>
          </div>
        </div>

        <% if (!canVolunteer) { %>
          <p class="text-xs text-muted mt-4 border-t border-line pt-3">
            Note: Volunteering is exclusive to registered club members. You can join the club from your Student Hub to unlock operational volunteer roles.
          </p>
        <% } %>
      <% } %>
    </div>
  </main>
</body>
</html>
