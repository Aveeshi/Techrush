<%
/*
  `user` comes from res.locals.user, set once by app-level middleware — every template gets it
  automatically. user is null if logged out, otherwise { id, name, email, type, ... }
  Types supported: 'student', 'organizer', 'faculty', 'institutional'.
*/
%>

<!-- NAVBAR -->
<header class="border-b border-line">
  <nav class="max-w-[1400px] mx-auto flex items-center justify-between px-4 sm:px-8 py-5">
    <a href="/events" class="flex items-center gap-2">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="shrink-0">
        <path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z" fill="#d7ff2b"/>
      </svg>
      <span class="font-display text-lg tracking-tight">CAMPUSBUZZ</span>
    </a>

    <!-- Desktop Navigation Links -->
    <div class="hidden md:flex items-center gap-6">
      <a href="/events" class="text-xs tracking-[0.15em] text-muted hover:text-fg transition-colors">
        EVENTS
      </a>

      <% if (user && user.type === 'student') { %>
        <a href="/student/dashboard" class="text-xs tracking-[0.15em] text-lime font-bold hover:text-white transition-colors">
          MY DASHBOARD
        </a>
        <a href="/logbook" class="text-xs tracking-[0.15em] text-muted hover:text-fg transition-colors">
          LOGBOOK
        </a>
        <a href="/registered-events" class="text-xs tracking-[0.15em] text-muted hover:text-fg transition-colors">
          REGISTERED EVENTS
        </a>
        <a href="/my-events" class="text-xs tracking-[0.15em] text-muted hover:text-fg transition-colors">
          MY EVENTS &amp; TEAMS
        </a>
      <% } else if (user && user.type === 'organizer') { %>
        <a href="/club" class="text-xs tracking-[0.15em] text-muted hover:text-fg transition-colors">
          CLUB
        </a>
        <a href="/club-events" class="text-xs tracking-[0.15em] text-muted hover:text-fg transition-colors">
          CLUB EVENTS
        </a>
      <% } else if (user && user.type === 'faculty') { %>
        <a href="/faculty/dashboard" class="text-xs tracking-[0.15em] text-lime font-bold hover:text-white transition-colors">
          FACULTY PORTAL
        </a>
        <a href="/faculty/events" class="text-xs tracking-[0.15em] text-muted hover:text-fg transition-colors">
          EVENT APPROVALS
        </a>
        <a href="/faculty/reports" class="text-xs tracking-[0.15em] text-muted hover:text-fg transition-colors">
          VERIFY REPORTS
        </a>
        <a href="/faculty/coordinators" class="text-xs tracking-[0.15em] text-muted hover:text-fg transition-colors">
          COORDINATORS
        </a>
        <a href="/faculty/generate-report" class="text-xs tracking-[0.15em] text-muted hover:text-fg transition-colors">
          REPORTS
        </a>
      <% } else if (user && user.type === 'institutional') { %>
        <a href="/institutional/dashboard" class="text-xs tracking-[0.15em] text-lime font-bold hover:text-white transition-colors">
          INSTITUTIONAL PORTAL
        </a>
        <a href="/institutional/dashboard" class="text-xs tracking-[0.15em] text-muted hover:text-fg transition-colors">
          ALL CLUBS AUDIT
        </a>
      <% } %>
    </div>

    <!-- Right Controls -->
    <div class="hidden md:flex items-center gap-3">
      <button
        type="button"
        id="theme-toggle"
        aria-label="Toggle dark/light theme"
        class="btn-outline text-sm px-3 py-2.5 border border-line rounded-md"
      >🌓</button>

      <% if (!user) { %>
        <a href="/auth/login" class="btn-outline text-sm font-semibold px-4 py-2 border border-line rounded-md">
          Login
        </a>
        <a href="/auth/signup" class="btn-lime text-sm font-semibold px-4 py-2 bg-lime text-black rounded-md">
          Signup
        </a>
        <a href="/auth/faculty-login" class="text-xs font-mono text-muted hover:text-lime px-2 py-1" title="Faculty Coordinator Portal">
          Faculty &rarr;
        </a>
        <a href="/auth/institutional-login" class="text-xs font-mono text-muted hover:text-lime px-2 py-1" title="Institutional Admin Portal">
          Institution &rarr;
        </a>
      <% } else { %>
        <% if (user.type === 'student') { %>
          <span data-role="isEventHead" class="nav-role-chip font-mono text-[10px] tracking-[0.1em] text-lime border border-lime rounded px-2 py-1 <%= isEventHead ? '' : 'nav-role-hidden' %>">
            EVENT HEAD
          </span>
          <span data-role="isTeamHead" class="nav-role-chip font-mono text-[10px] tracking-[0.1em] text-lime border border-lime rounded px-2 py-1 <%= isTeamHead ? '' : 'nav-role-hidden' %>">
            TEAM HEAD
          </span>
        <% } else if (user.type === 'faculty') { %>
          <span class="font-mono text-[10px] tracking-[0.1em] text-lime bg-lime/10 border border-lime/30 rounded px-2 py-1">
            FACULTY INCHARGE
          </span>
        <% } else if (user.type === 'institutional') { %>
          <span class="font-mono text-[10px] tracking-[0.1em] text-amber-300 bg-amber-400/10 border border-amber-400/30 rounded px-2 py-1">
            INSTITUTIONAL ADMIN
          </span>
        <% } %>

        <a href="<%= user.type === 'faculty' ? '/faculty/dashboard' : (user.type === 'institutional' ? '/institutional/dashboard' : (user.type === 'student' ? '/student/dashboard' : '/account')) %>"
           class="btn-outline flex items-center gap-2 text-sm font-semibold pl-2.5 pr-4 py-1.5 border border-line rounded-md">
          <% if (user.type === 'student') { %>
            <img src="<%= user.profile_photo_url || '/avatars/avatar-1.svg' %>" alt="" class="w-6 h-6 rounded-full object-cover" />
          <% } %>
          <%= user.name %>
        </a>

        <form action="/auth/logout" method="POST" class="inline">
          <button type="submit" class="text-xs tracking-[0.1em] text-muted hover:text-fg transition-colors">
            LOGOUT
          </button>
        </form>
      <% } %>
    </div>

    <!-- Mobile-only hamburger toggle -->
    <button
      type="button"
      id="nav-hamburger"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="nav-mobile-menu"
      class="md:hidden flex items-center justify-center w-10 h-10 border border-line rounded-md"
    >
      <svg id="nav-hamburger-icon-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
      <svg id="nav-hamburger-icon-close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="hidden">
        <line x1="5" y1="5" x2="19" y2="19" />
        <line x1="19" y1="5" x2="5" y2="19" />
      </svg>
    </button>
  </nav>

  <!-- Mobile-only menu -->
  <div id="nav-mobile-menu" class="hidden md:hidden border-t border-line px-4 py-4 flex-col gap-1">
    <a href="/events" class="px-2 py-2 text-xs tracking-[0.15em] text-muted hover:text-fg transition-colors">
      EVENTS
    </a>

    <% if (user && user.type === 'student') { %>
      <a href="/student/dashboard" class="px-2 py-2 text-xs tracking-[0.15em] text-lime font-bold hover:text-white transition-colors">
        MY DASHBOARD
      </a>
      <a href="/logbook" class="px-2 py-2 text-xs tracking-[0.15em] text-muted hover:text-fg transition-colors">
        LOGBOOK
      </a>
      <a href="/registered-events" class="px-2 py-2 text-xs tracking-[0.15em] text-muted hover:text-fg transition-colors">
        REGISTERED EVENTS
      </a>
      <a href="/my-events" class="px-2 py-2 text-xs tracking-[0.15em] text-muted hover:text-fg transition-colors">
        MY EVENTS &amp; TEAMS
      </a>
    <% } else if (user && user.type === 'organizer') { %>
      <a href="/club" class="px-2 py-2 text-xs tracking-[0.15em] text-muted hover:text-fg transition-colors">
        CLUB
      </a>
      <a href="/club-events" class="px-2 py-2 text-xs tracking-[0.15em] text-muted hover:text-fg transition-colors">
        CLUB EVENTS
      </a>
    <% } else if (user && user.type === 'faculty') { %>
      <a href="/faculty/dashboard" class="px-2 py-2 text-xs tracking-[0.15em] text-lime font-bold hover:text-white transition-colors">
        FACULTY PORTAL
      </a>
      <a href="/faculty/events" class="px-2 py-2 text-xs tracking-[0.15em] text-muted hover:text-fg transition-colors">
        EVENT APPROVALS
      </a>
      <a href="/faculty/reports" class="px-2 py-2 text-xs tracking-[0.15em] text-muted hover:text-fg transition-colors">
        VERIFY REPORTS
      </a>
      <a href="/faculty/coordinators" class="px-2 py-2 text-xs tracking-[0.15em] text-muted hover:text-fg transition-colors">
        COORDINATORS
      </a>
    <% } else if (user && user.type === 'institutional') { %>
      <a href="/institutional/dashboard" class="px-2 py-2 text-xs tracking-[0.15em] text-lime font-bold hover:text-white transition-colors">
        INSTITUTIONAL PORTAL
      </a>
    <% } %>

    <div class="mt-3 pt-3 border-t border-line flex flex-col gap-3">
      <% if (!user) { %>
        <div class="grid grid-cols-2 gap-2">
          <a href="/auth/login" class="btn-outline text-xs font-semibold py-2 border border-line rounded-md text-center">
            Login
          </a>
          <a href="/auth/signup" class="btn-lime text-xs font-semibold py-2 bg-lime text-black rounded-md text-center">
            Signup
          </a>
        </div>
        <div class="grid grid-cols-2 gap-2 text-center text-xs font-mono">
          <a href="/auth/faculty-login" class="py-1 text-muted hover:text-lime">Faculty Portal &rarr;</a>
          <a href="/auth/institutional-login" class="py-1 text-muted hover:text-lime">Institutional Portal &rarr;</a>
        </div>
      <% } else { %>
        <form action="/auth/logout" method="POST">
          <button type="submit" class="w-full text-left text-xs tracking-[0.1em] text-muted hover:text-fg transition-colors px-2 py-2">
            LOGOUT
          </button>
        </form>
      <% } %>

      <button
        type="button"
        id="theme-toggle-mobile"
        aria-label="Toggle dark/light theme"
        class="btn-outline text-xs px-3 py-2 border border-line rounded-md self-start"
      >🌓 Toggle theme</button>
    </div>
  </div>
</header>

<style>
  .nav-role-hidden { display: none !important; }
</style>

<script>
  function toggleTheme() {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    fetch('/theme', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ theme: next }),
    }).catch(() => {});
  }
  document.getElementById('theme-toggle').addEventListener('click', toggleTheme);
  document.getElementById('theme-toggle-mobile').addEventListener('click', toggleTheme);

  (function () {
    const button = document.getElementById('nav-hamburger');
    const menu = document.getElementById('nav-mobile-menu');
    const iconOpen = document.getElementById('nav-hamburger-icon-open');
    const iconClose = document.getElementById('nav-hamburger-icon-close');

    function setOpen(open) {
      menu.classList.toggle('hidden', !open);
      menu.classList.toggle('flex', open);
      iconOpen.classList.toggle('hidden', open);
      iconClose.classList.toggle('hidden', !open);
      button.setAttribute('aria-expanded', String(open));
    }

    button.addEventListener('click', function () {
      setOpen(menu.classList.contains('hidden'));
    });

    window.matchMedia('(min-width: 768px)').addEventListener('change', function (e) {
      if (e.matches) setOpen(false);
    });
  })();
</script>

<% if (user) { %>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/nav-live.js"></script>
<% } %>
