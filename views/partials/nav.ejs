<%
/*
  `user` comes from res.locals.user, set once by app-level middleware
  (see the note at the bottom of this file) — every template gets it
  automatically, no per-route wiring needed. user is null if logged out,
  otherwise the full req.user object including .type ('student'|'organizer').
*/
%>

<!-- NAVBAR -->
<header class="border-b border-line">
  <nav class="max-w-[1400px] mx-auto flex items-center justify-between px-4 sm:px-8 py-5">
    <a href="/events" class="flex items-center gap-2">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="shrink-0">
        <path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z" fill="#d7ff2b"/>
      </svg>
      <span class="font-display text-lg tracking-tight">CLUBBING</span>
    </a>

    <div class="hidden md:flex items-center gap-8">
      <a href="/events" class="text-xs tracking-[0.15em] text-muted hover:text-fg transition-colors">
        EVENTS
      </a>

      <% if (user && user.type === 'student') { %>
        <a href="/registered-events" class="text-xs tracking-[0.15em] text-muted hover:text-fg transition-colors">
          REGISTERED EVENTS
        </a>
        <!--
          The old standalone "Teams" tab is gone — every student sees this
          ONE tab instead, always (it now also covers "events/sub-events
          I volunteer at", the old Teams tab's job for a non-head
          student — see clubEventController.myEvents). isEventHead/
          isTeamHead only control the role CHIPS elsewhere in this nav,
          not this link's visibility.
        -->
        <a href="/my-events" class="text-xs tracking-[0.15em] text-muted hover:text-fg transition-colors">
          MY EVENTS &amp; TEAMS
        </a>
      <% } else if (user && user.type === 'organizer') { %>
        <a href="/club" class="text-xs tracking-[0.15em] text-muted hover:text-fg transition-colors">
          CLUB
        </a>
        <a href="/club-events" class="text-xs tracking-[0.15em] text-muted hover:text-fg transition-colors">
          CLUB EVENTS
        </a>
      <% } %>
    </div>

    <div class="hidden md:flex items-center gap-3">
      <button
        type="button"
        id="theme-toggle"
        aria-label="Toggle dark/light theme"
        class="btn-outline text-sm px-3 py-2.5 border border-line rounded-md"
      >🌓</button>

      <% if (!user) { %>
        <a href="/auth/login" class="btn-outline text-sm font-semibold px-5 py-2.5 border border-line rounded-md">
          Login
        </a>
        <a href="/auth/signup" class="btn-lime text-sm font-semibold px-5 py-2.5 bg-lime text-black rounded-md">
          Signup
        </a>
      <% } else { %>
        <% if (user.type === 'student') { %>
          <span data-role="isEventHead" class="nav-role-chip font-mono text-[10px] tracking-[0.1em] text-lime border border-lime rounded px-2 py-1 <%= isEventHead ? '' : 'nav-role-hidden' %>">
            EVENT HEAD
          </span>
          <span data-role="isTeamHead" class="nav-role-chip font-mono text-[10px] tracking-[0.1em] text-lime border border-lime rounded px-2 py-1 <%= isTeamHead ? '' : 'nav-role-hidden' %>">
            TEAM HEAD
          </span>
        <% } %>
        <a href="/account" class="btn-outline flex items-center gap-2 text-sm font-semibold pl-2.5 pr-5 py-2 border border-line rounded-md">
          <% if (user.type === 'student') { %>
            <img src="<%= user.profile_photo_url || '/avatars/avatar-1.svg' %>" alt="" class="w-6 h-6 rounded-full object-cover" />
          <% } %>
          <%= user.type === 'organizer' ? user.name : 'My Account' %>
        </a>
        <form action="/auth/logout" method="POST" class="inline">
          <button type="submit" class="text-xs tracking-[0.1em] text-muted hover:text-fg transition-colors">
            LOGOUT
          </button>
        </form>
      <% } %>
    </div>

    <!-- Mobile-only: hamburger toggle for the folded menu below -->
    <button
      type="button"
      id="nav-hamburger"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="nav-mobile-menu"
      class="md:hidden flex items-center justify-center w-10 h-10 border border-line rounded-md"
    >
      <svg id="nav-hamburger-icon-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
      <svg id="nav-hamburger-icon-close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="hidden">
        <line x1="5" y1="5" x2="19" y2="19" />
        <line x1="19" y1="5" x2="5" y2="19" />
      </svg>
    </button>
  </nav>

  <!-- Mobile-only: folded menu — all nav links + account controls stacked -->
  <div id="nav-mobile-menu" class="hidden md:hidden border-t border-line px-4 py-4 flex-col gap-1">
    <a href="/events" class="px-2 py-2.5 text-xs tracking-[0.15em] text-muted hover:text-fg transition-colors">
      EVENTS
    </a>

    <% if (user && user.type === 'student') { %>
      <a href="/registered-events" class="px-2 py-2.5 text-xs tracking-[0.15em] text-muted hover:text-fg transition-colors">
        REGISTERED EVENTS
      </a>
      <a href="/my-events" class="px-2 py-2.5 text-xs tracking-[0.15em] text-muted hover:text-fg transition-colors">
        MY EVENTS &amp; TEAMS
      </a>
    <% } else if (user && user.type === 'organizer') { %>
      <a href="/club" class="px-2 py-2.5 text-xs tracking-[0.15em] text-muted hover:text-fg transition-colors">
        CLUB
      </a>
      <a href="/club-events" class="px-2 py-2.5 text-xs tracking-[0.15em] text-muted hover:text-fg transition-colors">
        CLUB EVENTS
      </a>
    <% } %>

    <div class="mt-3 pt-3 border-t border-line flex flex-col gap-3">
      <% if (user && user.type === 'student') { %>
        <div class="flex items-center gap-2 px-2">
          <span data-role="isEventHead" class="nav-role-chip font-mono text-[10px] tracking-[0.1em] text-lime border border-lime rounded px-2 py-1 <%= isEventHead ? '' : 'nav-role-hidden' %>">
            EVENT HEAD
          </span>
          <span data-role="isTeamHead" class="nav-role-chip font-mono text-[10px] tracking-[0.1em] text-lime border border-lime rounded px-2 py-1 <%= isTeamHead ? '' : 'nav-role-hidden' %>">
            TEAM HEAD
          </span>
        </div>
      <% } %>

      <% if (!user) { %>
        <a href="/auth/login" class="btn-outline text-sm font-semibold px-5 py-2.5 border border-line rounded-md text-center">
          Login
        </a>
        <a href="/auth/signup" class="btn-lime text-sm font-semibold px-5 py-2.5 bg-lime text-black rounded-md text-center">
          Signup
        </a>
      <% } else { %>
        <a href="/account" class="btn-outline flex items-center gap-2 text-sm font-semibold pl-2.5 pr-5 py-2 border border-line rounded-md">
          <% if (user.type === 'student') { %>
            <img src="<%= user.profile_photo_url || '/avatars/avatar-1.svg' %>" alt="" class="w-6 h-6 rounded-full object-cover" />
          <% } %>
          <%= user.type === 'organizer' ? user.name : 'My Account' %>
        </a>
        <form action="/auth/logout" method="POST">
          <button type="submit" class="w-full text-left text-xs tracking-[0.1em] text-muted hover:text-fg transition-colors px-2 py-2">
            LOGOUT
          </button>
        </form>
      <% } %>

      <button
        type="button"
        id="theme-toggle-mobile"
        aria-label="Toggle dark/light theme"
        class="btn-outline text-sm px-3 py-2.5 border border-line rounded-md self-start"
      >🌓 Toggle theme</button>
    </div>
  </div>
</header>

<style>
  .nav-role-hidden { display: none !important; }
</style>

<script>
  // Theme toggle — flips document.documentElement.dataset.theme instantly
  // (every utility class already reads the CSS variables in
  // partials/head.ejs, so this alone re-themes the whole page with no
  // reload) and persists the choice via POST /theme, which sets the
  // `theme` cookie head.ejs's pre-paint script reads on the next visit.
  function toggleTheme() {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    fetch('/theme', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ theme: next }),
    }).catch(() => {});
  }
  document.getElementById('theme-toggle').addEventListener('click', toggleTheme);
  document.getElementById('theme-toggle-mobile').addEventListener('click', toggleTheme);

  // Hamburger — folds all nav links + account controls into a dropdown
  // panel below the header on phone-width screens (< md).
  (function () {
    const button = document.getElementById('nav-hamburger');
    const menu = document.getElementById('nav-mobile-menu');
    const iconOpen = document.getElementById('nav-hamburger-icon-open');
    const iconClose = document.getElementById('nav-hamburger-icon-close');

    function setOpen(open) {
      menu.classList.toggle('hidden', !open);
      menu.classList.toggle('flex', open);
      iconOpen.classList.toggle('hidden', open);
      iconClose.classList.toggle('hidden', !open);
      button.setAttribute('aria-expanded', String(open));
    }

    button.addEventListener('click', function () {
      setOpen(menu.classList.contains('hidden'));
    });

    // Close the menu once the viewport grows back to desktop width, so it
    // doesn't stay stuck open (and mis-styled) behind the desktop nav.
    window.matchMedia('(min-width: 768px)').addEventListener('change', function (e) {
      if (e.matches) setOpen(false);
    });
  })();
</script>

<% if (user && user.type === 'student') { %>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/nav-live.js"></script>
<% } %>

<%#
  Wire res.locals.user once, app-wide, so every template (including this
  partial) can reference `user` with zero per-route boilerplate:

    app.use((req, res, next) => {
      res.locals.user = req.user || null;
      next();
    });

  Place this AFTER passport's session middleware and BEFORE your routers.
%>
