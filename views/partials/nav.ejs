<%
/*
  CampusBuzz Top Navigation Bar
  Types supported: 'student', 'organizer', 'faculty', 'institutional'.
*/
%>

<header class="sticky top-0 z-50 border-b border-line bg-[#090a09]/90 backdrop-blur-xl transition-all">
  <nav class="max-w-[1440px] mx-auto flex items-center justify-between px-4 sm:px-8 py-3.5">
    <!-- Brand Logo (CampusBuzz UI Design) -->
    <a href="/events" class="brand group text-decoration-none">
      <div class="brand-mark group-hover:shadow-[0_0_25px_rgba(215,255,43,0.5)] transition-all">
        <span>CB</span>
      </div>
      <div class="brand-word">
        Campus<span>Buzz</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <div class="hidden md:flex items-center gap-7">
      <a href="/events" class="text-xs font-semibold tracking-wider text-muted hover:text-fg transition-colors">
        EVENTS
      </a>

      <% if (user && user.type === 'student') { %>
        <a href="/student/dashboard" class="text-xs font-bold tracking-wider text-lime flex items-center gap-1.5 hover:opacity-90 transition-opacity">
          <span class="w-1.5 h-1.5 rounded-full bg-lime animate-pulse"></span>
          MY DASHBOARD
        </a>
        <a href="/student/semester-report" class="text-xs font-semibold tracking-wider text-muted hover:text-fg transition-colors">
          SEMESTER REPORT
        </a>
        <a href="/logbook" class="text-xs font-semibold tracking-wider text-muted hover:text-fg transition-colors">
          LOGBOOK
        </a>
        <a href="/registered-events" class="text-xs font-semibold tracking-wider text-muted hover:text-fg transition-colors">
          REGISTERED
        </a>
        <a href="/my-events" class="text-xs font-semibold tracking-wider text-muted hover:text-fg transition-colors">
          MY TEAMS
        </a>
      <% } else if (user && user.type === 'organizer') { %>
        <a href="/club" class="text-xs font-bold tracking-wider text-lime">
          CLUB OVERVIEW
        </a>
        <a href="/club-events" class="text-xs font-semibold tracking-wider text-muted hover:text-fg transition-colors">
          CLUB EVENTS
        </a>
      <% } else if (user && user.type === 'faculty') { %>
        <a href="/faculty/dashboard" class="text-xs font-bold tracking-wider text-amber-400 flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
          REVIEW DESK
        </a>
        <a href="/faculty/events" class="text-xs font-semibold tracking-wider text-muted hover:text-fg transition-colors">
          EVENT APPROVALS
        </a>
        <a href="/faculty/reports" class="text-xs font-semibold tracking-wider text-muted hover:text-fg transition-colors">
          VERIFY REPORTS
        </a>
        <a href="/faculty/coordinators" class="text-xs font-semibold tracking-wider text-muted hover:text-fg transition-colors">
          COORDINATORS
        </a>
        <a href="/faculty/generate-report" class="text-xs font-semibold tracking-wider text-muted hover:text-fg transition-colors">
          EXPORT DOSSIER
        </a>
      <% } else if (user && user.type === 'institutional') { %>
        <a href="/institutional/dashboard" class="text-xs font-bold tracking-wider text-blue-400 flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse"></span>
          COMMAND CENTER
        </a>
        <a href="/institutional/dashboard" class="text-xs font-semibold tracking-wider text-muted hover:text-fg transition-colors">
          ALL-CLUBS DIRECTORY
        </a>
      <% } %>
    </div>

    <!-- Desktop Right Controls -->
    <div class="hidden md:flex items-center gap-3">
      <!-- Search Trigger / Visual -->
      <a href="/events" class="search hidden lg:flex" style="text-decoration:none;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-4-4"></path>
        </svg>
        <span class="text-xs text-muted flex-1">Search events & clubs...</span>
        <kbd class="font-mono text-[9px] border border-line-strong px-1.5 py-0.5 rounded text-muted">⌘ K</kbd>
      </a>

      <!-- Theme Switcher -->
      <button
        type="button"
        id="theme-toggle"
        aria-label="Toggle dark/light theme"
        class="icon-button"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path>
        </svg>
      </button>

      <% if (user) { %>
        <!-- Role Indicator Pill -->
        <% if (user.type === 'faculty') { %>
          <span class="badge badge-amber font-mono text-[8px]">FACULTY NODE</span>
        <% } else if (user.type === 'institutional') { %>
          <span class="badge badge-lime font-mono text-[8px]">INSTITUTION NODE</span>
        <% } else if (user.type === 'organizer') { %>
          <span class="badge badge-lime font-mono text-[8px]">LEAD ORGANIZER</span>
        <% } else { %>
          <span class="badge badge-green font-mono text-[8px]">VERIFIED STUDENT</span>
        <% } %>

        <!-- User Profile Pill -->
        <a href="<%= user.type === 'faculty' ? '/faculty/dashboard' : user.type === 'institutional' ? '/institutional/dashboard' : '/student/dashboard' %>"
           class="flex items-center gap-2.5 pl-1.5 pr-3 py-1 border border-line rounded-xl bg-surface hover:border-lime/40 transition-all text-decoration-none">
          <div class="avatar">
            <%= (user.name || 'U').split(' ').map(n => n[0]).join('').slice(0, 2).toUpperCase() %>
          </div>
          <span class="text-xs font-bold text-fg truncate max-w-[120px]"><%= user.name %></span>
        </a>

        <!-- Logout Action -->
        <form action="/auth/logout" method="POST" class="inline">
          <button type="submit" class="icon-button text-muted hover:text-red-400 hover:border-red-400/40 transition-colors" title="Log Out">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
          </button>
        </form>
      <% } else { %>
        <!-- Authentication CTAs -->
        <div class="flex items-center gap-2">
          <a href="/auth/login" class="button button-quiet text-xs font-semibold text-decoration-none">
            Sign In
          </a>
          <a href="/auth/faculty-login" class="hidden sm:inline-flex button button-quiet text-xs font-semibold text-decoration-none">
            Faculty
          </a>
          <a href="/auth/institutional-login" class="hidden lg:inline-flex button button-quiet text-xs font-semibold text-decoration-none">
            Institution
          </a>
          <a href="/auth/login" class="button button-primary text-xs font-bold text-decoration-none">
            Access Hub →
          </a>
        </div>
      <% } %>
    </div>

    <!-- Mobile Hamburger Toggle -->
    <button
      type="button"
      id="nav-hamburger"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="nav-mobile-menu"
      class="md:hidden icon-button"
    >
      <svg id="nav-hamburger-icon-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
      <svg id="nav-hamburger-icon-close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden">
        <line x1="5" y1="5" x2="19" y2="19" />
        <line x1="19" y1="5" x2="5" y2="19" />
      </svg>
    </button>
  </nav>

  <!-- Mobile Folded Menu -->
  <div id="nav-mobile-menu" class="hidden md:hidden border-t border-line bg-surface p-5 flex-col gap-3">
    <a href="/events" class="py-2 text-xs font-semibold tracking-wider text-muted hover:text-fg">
      EVENTS EXPLORER
    </a>

    <% if (user && user.type === 'student') { %>
      <a href="/student/dashboard" class="py-2 text-xs font-bold text-lime">
        MY DASHBOARD
      </a>
      <a href="/student/semester-report" class="py-2 text-xs font-semibold text-muted">
        SEMESTER REPORT
      </a>
      <a href="/logbook" class="py-2 text-xs font-semibold text-muted">
        LOGBOOK
      </a>
      <a href="/registered-events" class="py-2 text-xs font-semibold text-muted">
        REGISTERED EVENTS
      </a>
    <% } else if (user && user.type === 'faculty') { %>
      <a href="/faculty/dashboard" class="py-2 text-xs font-bold text-amber-400">
        FACULTY REVIEW DESK
      </a>
      <a href="/faculty/events" class="py-2 text-xs font-semibold text-muted">
        EVENT APPROVALS
      </a>
      <a href="/faculty/reports" class="py-2 text-xs font-semibold text-muted">
        STUDENT REPORTS
      </a>
      <a href="/faculty/generate-report" class="py-2 text-xs font-semibold text-muted">
        GENERATE REPORT
      </a>
    <% } else if (user && user.type === 'institutional') { %>
      <a href="/institutional/dashboard" class="py-2 text-xs font-bold text-blue-400">
        INSTITUTIONAL HUB
      </a>
    <% } else { %>
      <a href="/auth/login" class="py-2 text-xs font-semibold text-fg">
        STUDENT LOGIN
      </a>
      <a href="/auth/faculty-login" class="py-2 text-xs font-semibold text-amber-400">
        FACULTY COORDINATOR LOGIN
      </a>
      <a href="/auth/institutional-login" class="py-2 text-xs font-semibold text-blue-400">
        INSTITUTIONAL ADMIN LOGIN
      </a>
    <% } %>

    <div class="mt-4 pt-4 border-t border-line flex items-center justify-between">
      <% if (user) { %>
        <form action="/auth/logout" method="POST">
          <button type="submit" class="text-xs font-semibold text-red-400">
            Log Out
          </button>
        </form>
      <% } %>
      <button
        type="button"
        id="theme-toggle-mobile"
        aria-label="Toggle theme"
        class="text-xs px-3 py-1.5 border border-line rounded-lg"
      >🌓 Toggle Theme</button>
    </div>
  </div>
</header>

<script>
  function toggleTheme() {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    fetch('/theme', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ theme: next }),
    }).catch(() => {});
  }
  document.getElementById('theme-toggle').addEventListener('click', toggleTheme);
  const mobileToggle = document.getElementById('theme-toggle-mobile');
  if (mobileToggle) mobileToggle.addEventListener('click', toggleTheme);

  (function () {
    const button = document.getElementById('nav-hamburger');
    const menu = document.getElementById('nav-mobile-menu');
    const iconOpen = document.getElementById('nav-hamburger-icon-open');
    const iconClose = document.getElementById('nav-hamburger-icon-close');

    function setOpen(open) {
      menu.classList.toggle('hidden', !open);
      menu.classList.toggle('flex', open);
      iconOpen.classList.toggle('hidden', open);
      iconClose.classList.toggle('hidden', !open);
      button.setAttribute('aria-expanded', String(open));
    }

    if (button && menu) {
      button.addEventListener('click', function () {
        setOpen(menu.classList.contains('hidden'));
      });
    }

    window.matchMedia('(min-width: 768px)').addEventListener('change', function (e) {
      if (e.matches && menu) setOpen(false);
    });
  })();
</script>
