<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= typeof title !== 'undefined' ? title : 'CampusBuzz — Campus Activity & Credit Protocol' %></title>

<!-- Pre-paint theme script to prevent FOUC -->
<script>
  (function () {
    var match = document.cookie.match(/(?:^|; )theme=(dark|light)/);
    var theme = match ? match[1] : (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
    document.documentElement.dataset.theme = theme;
  })();
</script>

<!-- Google Fonts (Manrope, DM Mono, Outfit, Plus Jakarta Sans, JetBrains Mono) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">

<!-- Tailwind CDN -->
<script src="https://cdn.tailwindcss.com"></script>

<!-- CampusBuzz Production Design Styles -->
<link rel="stylesheet" href="/css/campusbuzz.css">

<script>
  tailwind.config = {
    theme: {
      extend: {
        colors: {
          bg: 'var(--bg)',
          panel: 'var(--surface, var(--panel))',
          'panel-glass': 'rgba(17, 19, 17, 0.85)',
          surface: 'var(--surface)',
          'surface-2': 'var(--surface-2)',
          'surface-3': 'var(--surface-3)',
          line: 'var(--line)',
          'line-strong': 'var(--line-strong)',
          lime: '#d7ff2b',
          'lime-ink': '#111600',
          'lime-dim': 'rgba(215, 255, 43, 0.12)',
          muted: 'var(--muted)',
          fg: 'var(--text, var(--fg))',
        },
        fontFamily: {
          sans: ['"Manrope"', '"Plus Jakarta Sans"', 'Inter', 'sans-serif'],
          display: ['"Outfit"', '"Manrope"', 'sans-serif'],
          mono: ['"DM Mono"', '"JetBrains Mono"', 'monospace'],
        },
        boxShadow: {
          'glow-lime': '0 0 25px -5px rgba(215, 255, 43, 0.4)',
          'glow-subtle': '0 10px 30px -10px rgba(0, 0, 0, 0.5)',
        },
      },
    },
  }
</script>

<style>
  :root, :root[data-theme="dark"] {
    --bg: #090a09;
    --surface: #111311;
    --surface-2: #171a17;
    --surface-3: #1c201c;
    --panel: #111311;
    --line: rgba(255, 255, 255, 0.09);
    --line-strong: rgba(255, 255, 255, 0.15);
    --fg: #f4f6f1;
    --text: #f4f6f1;
    --muted: #8b9189;
    --faint: #5f665e;
    --lime: #d7ff2b;
    --lime-ink: #111600;
    --green: #34d399;
    --amber: #fbbf24;
    --red: #fb7185;
    --purple: #a78bfa;
    --blue: #60a5fa;
    --shadow: 0 20px 60px rgba(0,0,0,.25);
  }

  :root[data-theme="light"] {
    --bg: #f4f5ef;
    --surface: #ffffff;
    --surface-2: #f7f8f3;
    --surface-3: #eef0e8;
    --panel: #ffffff;
    --line: rgba(14, 18, 12, 0.09);
    --line-strong: rgba(14, 18, 12, 0.16);
    --fg: #121510;
    --text: #121510;
    --muted: #697066;
    --faint: #969c93;
    --shadow: 0 20px 60px rgba(28,32,20,.08);
  }

  body {
    background-color: var(--bg);
    color: var(--text);
    font-family: 'Manrope', 'Plus Jakarta Sans', sans-serif;
  }
</style>
