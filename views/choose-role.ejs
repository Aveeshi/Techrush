<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <style>
    #tab-student, #tab-organizer { position: absolute; opacity: 0; width: 0; height: 0; }
    .tab-label {
      flex: 1;
      text-align: center;
      padding: 0.75rem;
      border: 1px solid #242424;
      cursor: pointer;
      color: #8a8a8a;
      font-size: 0.875rem;
      font-weight: 600;
      transition: all .15s ease;
    }
    #tab-student:checked ~ .tab-bar label[for="tab-student"],
    #tab-organizer:checked ~ .tab-bar label[for="tab-organizer"] {
      background-color: #d7ff2b;
      border-color: #d7ff2b;
      color: #0a0a0a;
    }
    #student-panel, #organizer-panel { display: none; }
    #tab-student:checked ~ #student-panel { display: block; }
    #tab-organizer:checked ~ #organizer-panel { display: block; }
  </style>
</head>
<body class="font-sans text-fg antialiased">
  <%- include('partials/nav') %>

  <main class="max-w-xl mx-auto px-8 py-16">
    <div class="flex items-center gap-3 mb-6">
      <span class="w-6 h-px bg-lime"></span>
      <span class="font-mono text-xs tracking-[0.2em] text-lime">// ONE MORE STEP</span>
    </div>
    <h1 class="font-display text-4xl mb-2">Complete your profile</h1>
    <p class="text-muted mb-8">
      Signed in as <span class="text-fg"><%= pendingUser.name %></span> (<%= pendingUser.email %>).
      Pick a role to finish setting up your account.
    </p>

    <% if (errors && errors.length > 0) { %>
      <div class="border border-red-500 bg-red-500/10 text-red-400 px-4 py-3 rounded-md mb-6 text-sm">
        <ul class="list-disc list-inside space-y-1">
          <% errors.forEach(function(error) { %>
            <li><%= error %></li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <!-- Tab toggle drives which form (different action) renders below -->
    <input type="radio" name="roleTab" id="tab-student" value="student"
           <%= (typeof oldInput.roleTab === 'undefined' || oldInput.roleTab !== 'organizer') ? 'checked' : '' %> />
    <input type="radio" name="roleTab" id="tab-organizer" value="organizer"
           <%= oldInput.roleTab === 'organizer' ? 'checked' : '' %> />

    <div class="tab-bar flex mb-8 rounded-md overflow-hidden">
      <label for="tab-student" class="tab-label">I'M A STUDENT</label>
      <label for="tab-organizer" class="tab-label">I'M AN ORGANIZER</label>
    </div>

    <!-- STUDENT PANEL: own form + own action -->
    <div id="student-panel">
      <form action="/auth/choose-role/student" method="POST" enctype="multipart/form-data">
        <div class="grid grid-cols-2 gap-4 mb-4">
          <input type="text" name="rollNumber" placeholder="Roll number"
                 value="<%= oldInput.rollNumber || '' %>"
                 class="px-4 py-3 bg-panel border border-line rounded-md text-fg placeholder-muted focus:outline-none focus:border-lime" required />
          <input type="text" name="department" placeholder="Department"
                 value="<%= oldInput.department || '' %>"
                 class="px-4 py-3 bg-panel border border-line rounded-md text-fg placeholder-muted focus:outline-none focus:border-lime" required />
        </div>
        <div class="grid grid-cols-2 gap-4 mb-6">
          <input type="number" name="year" placeholder="Year (1-6)" min="1" max="6"
                 value="<%= oldInput.year || '' %>"
                 class="px-4 py-3 bg-panel border border-line rounded-md text-fg placeholder-muted focus:outline-none focus:border-lime" required />
          <input type="tel" name="phone" placeholder="Phone (10 digits)"
                 value="<%= oldInput.phone || '' %>"
                 class="px-4 py-3 bg-panel border border-line rounded-md text-fg placeholder-muted focus:outline-none focus:border-lime" required />
        </div>

        <div class="mb-6">
          <label class="font-mono text-[11px] tracking-[0.15em] text-muted block mb-2">PROFILE PHOTO (OPTIONAL)</label>
          <p class="text-muted text-xs mb-2">Skip this and we'll assign you a default avatar — you can change it any time from your account page.</p>
          <input type="file" name="profilePhoto" accept="image/*"
                 class="w-full text-sm text-muted file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:bg-lime file:text-black file:font-semibold file:cursor-pointer" />
        </div>

        <p class="text-muted text-xs mb-6">
          Your clubs are figured out automatically from your club's member
          list once you sign up — no need to pick them here.
        </p>

        <p class="font-mono text-xs tracking-[0.15em] text-muted mb-3">SKILLS YOU'D VOLUNTEER WITH</p>
        <div class="flex flex-wrap gap-2 mb-6">
          <% skillTags.forEach(function(tag) { %>
            <input type="checkbox" name="skillTagIds" id="sskill-<%= tag.id %>" value="<%= tag.id %>" class="chip-input" />
            <label for="sskill-<%= tag.id %>" class="chip-label"><%= tag.name %></label>
          <% }); %>
        </div>

        <p class="font-mono text-xs tracking-[0.15em] text-muted mb-3">EVENTS YOU'RE INTERESTED IN</p>
        <div class="flex flex-wrap gap-2 mb-8">
          <% eventTypes.forEach(function(type) { %>
            <input type="checkbox" name="eventTypeInterestIds" id="setype-<%= type.id %>" value="<%= type.id %>" class="chip-input" />
            <label for="setype-<%= type.id %>" class="chip-label"><%= type.name %></label>
          <% }); %>
        </div>

        <button type="submit" class="btn-lime w-full bg-lime text-black font-semibold py-3.5 rounded-md">
          Finish setting up my account
        </button>
      </form>
    </div>

    <!-- ORGANIZER PANEL: own form + own action -->
    <div id="organizer-panel">
      <form action="/auth/choose-role/organizer" method="POST">
        <p class="font-mono text-xs tracking-[0.15em] text-muted mb-3">WHICH CLUB DO YOU REPRESENT?</p>
        <select name="clubId"
                class="w-full px-4 py-3 mb-4 bg-panel border border-line rounded-md text-fg focus:outline-none focus:border-lime" required>
          <option value="">Select a club</option>
          <% openSlots.forEach(function(slot) { %>
            <option value="<%= slot.clubId %>" <%= oldInput.clubId === slot.clubId ? 'selected' : '' %>>
              <%= slot.clubName %> (<%= slot.openRoles.map(r => r === 'president' ? 'President' : 'VP').join(' + ') %> open)
            </option>
          <% }); %>
        </select>

        <p class="font-mono text-xs tracking-[0.15em] text-muted mb-3">YOUR ROLE</p>
        <select name="role"
                class="w-full px-4 py-3 mb-2 bg-panel border border-line rounded-md text-fg focus:outline-none focus:border-lime" required>
          <option value="">Select a role</option>
          <option value="president" <%= oldInput.role === 'president' ? 'selected' : '' %>>President</option>
          <option value="vice_president" <%= oldInput.role === 'vice_president' ? 'selected' : '' %>>Vice President</option>
        </select>
        <p class="text-xs text-muted mb-8">
          Only President and Vice President can hold an organizer account —
          only clubs with an open slot are listed above.
        </p>

        <button type="submit" class="btn-lime w-full bg-lime text-black font-semibold py-3.5 rounded-md">
          Finish setting up my account
        </button>
      </form>
    </div>
  </main>
</body>
</html>
