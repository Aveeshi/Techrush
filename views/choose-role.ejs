<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Complete Profile — CampusBuzz' }) %>
  <style>
    #tab-student, #tab-organizer { position: absolute; opacity: 0; width: 0; height: 0; }
    .role-btn {
      flex: 1;
      text-align: center;
      padding: 0.85rem;
      border: 1px solid var(--line);
      cursor: pointer;
      color: var(--muted);
      font-size: 0.75rem;
      font-weight: 700;
      background: var(--surface);
      border-radius: 10px;
      transition: all .15s ease;
    }
    #tab-student:checked ~ .role-tabs label[for="tab-student"],
    #tab-organizer:checked ~ .role-tabs label[for="tab-organizer"] {
      background: var(--lime);
      color: var(--lime-ink);
      border-color: var(--lime);
    }
    #student-panel, #organizer-panel { display: none; }
    #tab-student:checked ~ #student-panel { display: block; }
    #tab-organizer:checked ~ #organizer-panel { display: block; }
  </style>
</head>
<body class="font-sans text-fg antialiased bg-bg">
  <%- include('partials/nav') %>

  <main class="page max-w-xl mx-auto pt-8 pb-20">
    <div class="mb-6 flex items-center justify-between">
      <span class="overline text-lime">// ONBOARDING INITIALIZATION</span>
      <span class="badge badge-lime font-mono text-[9px]">STEP 2 OF 2</span>
    </div>

    <div class="welcome-row mb-8">
      <div>
        <h1 class="text-3xl font-extrabold text-fg mb-1">Complete Your Profile</h1>
        <p class="text-xs text-muted">
          Authenticated as <strong class="text-fg"><%= pendingUser.name %></strong> (<%= pendingUser.email %>). Choose your institutional role to finalize your workspace.
        </p>
      </div>
    </div>

    <% if (errors && errors.length > 0) { %>
      <div class="panel p-4 mb-6 bg-red-500/10 border border-red-500/30 text-red-400 text-xs">
        <ul class="list-disc list-inside space-y-1">
          <% errors.forEach(function(error) { %>
            <li><%= error %></li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <!-- Tab Radios -->
    <input type="radio" name="roleTab" id="tab-student" value="student"
           <%= (typeof oldInput.roleTab === 'undefined' || oldInput.roleTab !== 'organizer') ? 'checked' : '' %> />
    <input type="radio" name="roleTab" id="tab-organizer" value="organizer"
           <%= oldInput.roleTab === 'organizer' ? 'checked' : '' %> />

    <div class="role-tabs flex gap-3 mb-8">
      <label for="tab-student" class="role-btn">STUDENT ACCOUNT</label>
      <label for="tab-organizer" class="role-btn">ORGANIZER / LEAD</label>
    </div>

    <!-- Student Panel -->
    <div id="student-panel">
      <form action="/auth/choose-role/student" method="POST" enctype="multipart/form-data" class="panel p-6 sm:p-8 space-y-4 border border-line bg-surface">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <label class="field-label">
            ROLL NUMBER / PRN
            <input type="text" name="rollNumber" placeholder="e.g. 41151" value="<%= oldInput.rollNumber || '' %>" required />
          </label>
          <label class="field-label">
            DEPARTMENT
            <input type="text" name="department" placeholder="e.g. CE / IT / ENTC" value="<%= oldInput.department || '' %>" required />
          </label>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <label class="field-label">
            ACADEMIC YEAR (1-4)
            <input type="number" name="year" placeholder="e.g. 2" min="1" max="6" value="<%= oldInput.year || '' %>" required />
          </label>
          <label class="field-label">
            PHONE NUMBER
            <input type="tel" name="phone" placeholder="10 digits" value="<%= oldInput.phone || '' %>" required />
          </label>
        </div>

        <label class="field-label">
          PROFILE PHOTO (OPTIONAL)
          <input type="file" name="profilePhoto" accept="image/*"
                 class="text-xs text-muted file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-lime file:text-black file:font-bold file:cursor-pointer" />
        </label>

        <div>
          <span class="overline text-muted text-[8px] block mb-2">// VOLUNTEER SKILLS</span>
          <div class="flex flex-wrap gap-1.5">
            <% skillTags.forEach(function(tag) { %>
              <label class="badge badge-neutral hover:badge-lime cursor-pointer text-[8px] flex items-center gap-1.5 py-1 px-2.5">
                <input type="checkbox" name="skillTagIds" value="<%= tag.id %>" class="accent-lime" />
                <span><%= tag.name %></span>
              </label>
            <% }); %>
          </div>
        </div>

        <div>
          <span class="overline text-muted text-[8px] block mb-2">// EVENT INTERESTS</span>
          <div class="flex flex-wrap gap-1.5">
            <% eventTypes.forEach(function(type) { %>
              <label class="badge badge-neutral hover:badge-lime cursor-pointer text-[8px] flex items-center gap-1.5 py-1 px-2.5">
                <input type="checkbox" name="eventTypeInterestIds" value="<%= type.id %>" class="accent-lime" />
                <span><%= type.name %></span>
              </label>
            <% }); %>
          </div>
        </div>

        <div class="pt-4">
          <button type="submit" class="button button-primary w-full text-xs py-3 font-bold">
            Complete Onboarding &rarr;
          </button>
        </div>
      </form>
    </div>

    <!-- Organizer Panel -->
    <div id="organizer-panel">
      <form action="/auth/choose-role/organizer" method="POST" class="panel p-6 sm:p-8 space-y-4 border border-line bg-surface">
        <label class="field-label">
          AFFILIATED STUDENT CLUB
          <select name="clubId" required>
            <option value="">Select a club</option>
            <% openSlots.forEach(function(slot) { %>
              <option value="<%= slot.clubId %>" <%= oldInput.clubId === slot.clubId ? 'selected' : '' %>>
                <%= slot.clubName %> (<%= slot.openRoles.map(r => r === 'president' ? 'President' : 'VP').join(' + ') %> open)
              </option>
            <% }); %>
          </select>
        </label>

        <label class="field-label">
          EXECUTIVE ROLE
          <select name="role" required>
            <option value="">Select a role</option>
            <option value="president" <%= oldInput.role === 'president' ? 'selected' : '' %>>President</option>
            <option value="vice_president" <%= oldInput.role === 'vice_president' ? 'selected' : '' %>>Vice President</option>
          </select>
        </label>

        <div class="pt-4">
          <button type="submit" class="button button-primary w-full text-xs py-3 font-bold">
            Complete Organizer Setup &rarr;
          </button>
        </div>
      </form>
    </div>
  </main>
</body>
</html>
