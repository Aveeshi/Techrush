<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Registered Events' }) %>
</head>
<body class="font-sans text-fg antialiased">
  <%- include('partials/nav') %>

  <main class="max-w-[1400px] mx-auto px-8 pt-16 pb-20">
    <div class="flex items-center gap-3 mb-6">
      <span class="w-6 h-px bg-lime"></span>
      <span class="font-mono text-xs tracking-[0.2em] text-lime">// STUDENT · ATTENDEE</span>
    </div>
    <h1 class="font-display text-5xl mb-12">Registered events</h1>

    <% if (registrations.length === 0) { %>
      <p class="text-muted">You haven't registered as an attendee for any event yet.</p>
      <a href="/events" class="btn-lime inline-flex items-center gap-2 bg-lime text-black font-semibold px-6 py-3.5 rounded-md mt-6">
        Browse events
      </a>
    <% } %>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% registrations.forEach(function(reg) { %>
        <a href="<%= reg.sub_event_id ? '/events/' + reg.parent_event_id + '/sub-events/' + reg.sub_event_id : '/events/' + reg.parent_event_id %>" class="event-card block border border-line rounded-lg overflow-hidden">
          <div class="h-44 bg-panel">
            <% if (reg.banner_url) { %>
              <img src="<%= reg.banner_url %>" alt="" class="w-full h-full object-cover" />
            <% } %>
          </div>
          <div class="p-6">
            <span class="inline-block font-mono text-[11px] tracking-[0.15em] text-lime border border-lime rounded px-2 py-1 mb-4">
              <%= (reg.event_type_name || 'EVENT').toUpperCase() %>
            </span>
            <h3 class="font-display text-xl mb-1"><%= reg.title %></h3>
            <p class="text-muted text-sm mb-4"><%= reg.club_name %></p>

            <div class="space-y-1.5 text-sm text-muted mb-5">
              <div class="flex items-center gap-2">
                <span class="font-mono">📅</span>
                <%= new Date(reg.start_time).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) %>
              </div>
              <% if (reg.venue) { %>
                <div class="flex items-center gap-2">
                  <span class="font-mono">📍</span>
                  <%= reg.venue %>
                </div>
              <% } %>
            </div>

            <span class="font-mono text-xs tracking-[0.1em] text-lime">
              STATUS: <%= reg.status.toUpperCase() %>
            </span>
          </div>
        </a>
      <% }); %>
    </div>
  </main>
</body>
</html>
