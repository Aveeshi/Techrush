<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'My Events & Teams' }) %>
</head>
<body class="font-sans text-fg antialiased">
  <%- include('partials/nav') %>

  <main class="max-w-[1400px] mx-auto px-8 pt-16 pb-20">
    <div class="flex items-center gap-3 mb-6">
      <span class="w-6 h-px bg-lime"></span>
      <span class="font-mono text-xs tracking-[0.2em] text-lime">// STUDENT</span>
    </div>
    <h1 class="font-display text-5xl mb-12">My events &amp; teams</h1>

    <% if (cards.length === 0) { %>
      <p class="text-muted">You're not connected to any event yet — register or volunteer for one to see it here.</p>
      <a href="/events" class="btn-lime inline-flex items-center gap-2 bg-lime text-black font-semibold px-6 py-3.5 rounded-md mt-6">
        Browse events
      </a>
    <% } %>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% cards.forEach(function(c) { %>
        <%
          const isHead = c.tags.includes('EVENT HEAD') || c.tags.includes('SUB-EVENT HEAD');
          const manageUrl = c.type === 'sub_event'
            ? `/club-events/${c.parentEventId}/sub-events/${c.id}`
            : `/club-events/${c.id}`;
          const teamsUrl = c.type === 'sub_event' ? `/teams/sub-event/${c.id}` : `/teams/event/${c.id}`;
          const cardUrl = isHead ? manageUrl : teamsUrl;
        %>
        <a href="<%= cardUrl %>" class="event-card block border border-line rounded-lg p-6">
          <div class="flex flex-wrap gap-2 mb-4">
            <% c.tags.forEach(function(tag) { %>
              <span class="inline-block font-mono text-[11px] tracking-[0.15em] text-lime border border-lime rounded px-2 py-1"><%= tag %></span>
            <% }); %>
          </div>
          <h3 class="font-display text-xl mb-1"><%= c.title %></h3>
          <p class="text-muted text-sm mb-4"><%= c.clubName %></p>

          <div class="space-y-1.5 text-sm text-muted mb-5">
            <div class="flex items-center gap-2">
              <span class="font-mono">📅</span>
              <%= new Date(c.startTime).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) %>
            </div>
          </div>

          <span class="font-mono text-xs tracking-[0.1em] text-lime">
            <%= isHead ? 'MANAGE →' : 'VIEW →' %>
          </span>
        </a>
      <% }); %>
    </div>
  </main>
</body>
</html>
