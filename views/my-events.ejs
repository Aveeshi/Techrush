<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'My Events & Teams — CampusBuzz' }) %>
</head>
<body class="font-sans text-fg antialiased bg-bg">
  <%- include('partials/nav') %>

  <main class="page">
    <section class="welcome-row mb-8">
      <div>
        <span class="overline">// INVOLVEMENT &amp; RESPONSIBILITIES</span>
        <h1>My Events &amp; Teams</h1>
        <p>Active leadership, volunteer teams, and management assignments across all college events.</p>
      </div>

      <a href="/events" class="button button-quiet text-decoration-none">
        Browse Events Catalog
      </a>
    </section>

    <% if (cards.length === 0) { %>
      <article class="panel p-12 text-center text-muted">
        <p class="text-base mb-4">You're not connected to any event yet — register or volunteer for one to see it here.</p>
        <a href="/events" class="button button-primary text-decoration-none">
          Browse Events Explorer →
        </a>
      </article>
    <% } else { %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% cards.forEach(function(c, idx) { %>
          <%
            const isHead = c.tags.includes('EVENT HEAD') || c.tags.includes('SUB-EVENT HEAD');
            const manageUrl = c.type === 'sub_event'
              ? `/club-events/${c.parentEventId}/sub-events/${c.id}`
              : `/club-events/${c.id}`;
            const teamsUrl = c.type === 'sub_event' ? `/teams/sub-event/${c.id}` : `/teams/event/${c.id}`;
            const cardUrl = isHead ? manageUrl : teamsUrl;
            const evDate = new Date(c.startTime);
            const dayNum = String(evDate.getDate()).padStart(2, '0');
            const monthStr = evDate.toLocaleString('en-US', { month: 'short' }).toUpperCase();
          %>
          <article class="panel flex flex-col justify-between overflow-hidden group hover:border-lime/40 transition-all">
            <div class="p-6">
              <div class="flex items-center justify-between gap-2 mb-4">
                <div class="flex flex-wrap gap-1.5">
                  <% c.tags.forEach(function(tag) { %>
                    <span class="badge <%= isHead ? 'badge-amber' : 'badge-lime' %> text-[8px] tracking-wider uppercase"><%= tag %></span>
                  <% }); %>
                </div>
                <div class="date-tile shrink-0 scale-90 origin-top-right">
                  <strong><%= dayNum %></strong>
                  <small><%= monthStr %></small>
                </div>
              </div>

              <span class="text-xs text-muted block mb-1 font-medium"><%= c.clubName %></span>
              <h3 class="text-lg font-bold text-fg mb-3 group-hover:text-lime transition-colors">
                <%= c.title %>
              </h3>

              <div class="space-y-1.5 text-xs text-muted mb-6">
                <div class="flex items-center gap-2">
                  <span class="mono">📅</span>
                  <%= evDate.toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) %>
                </div>
              </div>
            </div>

            <div class="p-4 bg-surface-2 border-t border-line flex items-center justify-between">
              <span class="mono text-[10px] text-muted tracking-wider">
                <%= isHead ? 'OPERATIONAL LEAD' : 'VOLUNTEER CADRE' %>
              </span>
              <a href="<%= cardUrl %>" class="button <%= isHead ? 'button-amber' : 'button-quiet' %> text-xs font-bold text-decoration-none">
                <%= isHead ? 'Manage Event Operations →' : 'View Team Tasks →' %>
              </a>
            </div>
          </article>
        <% }); %>
      </div>
    <% } %>
  </main>
</body>
</html>
