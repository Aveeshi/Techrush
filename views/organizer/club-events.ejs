<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Club Events' }) %>
</head>
<body class="font-sans text-fg antialiased">
  <%- include('../partials/nav') %>

  <main class="max-w-[1400px] mx-auto px-8 pt-16 pb-20">
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center gap-3">
        <span class="w-6 h-px bg-lime"></span>
        <span class="font-mono text-xs tracking-[0.2em] text-lime">// ORGANIZER · CLUB EVENTS</span>
      </div>
      <a href="/club-events/new" class="btn-lime bg-lime text-black font-semibold px-5 py-2.5 rounded-md text-sm">
        + New event
      </a>
    </div>
    <h1 class="font-display text-5xl mb-12">Club Events</h1>

    <% if (events.length === 0) { %>
      <p class="text-muted">No events yet — create your first one.</p>
    <% } %>

    <div class="space-y-6">
      <% events.forEach(function(event) { %>
        <div class="border border-line rounded-lg overflow-hidden">
          <a href="/club-events/<%= event.id %>" class="block p-6 hover:bg-white/5 transition-colors">
            <div class="flex items-start justify-between gap-4">
              <div>
                <span class="inline-block font-mono text-[11px] tracking-[0.15em] text-lime border border-lime rounded px-2 py-1 mb-3">
                  <%= (event.status || 'draft').toUpperCase() %>
                </span>
                <h3 class="font-display text-2xl mb-1"><%= event.title %></h3>
                <p class="text-muted text-sm">
                  <%= new Date(event.start_time).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' }) %>
                  <% if (event.venue) { %> · <%= event.venue %><% } %>
                </p>
              </div>
              <span class="font-mono text-xs tracking-[0.1em] text-lime shrink-0">MANAGE →</span>
            </div>
          </a>

          <% if (event.subEvents.length > 0) { %>
            <div class="border-t border-line divide-y divide-line">
              <% event.subEvents.forEach(function(sub) { %>
                <a href="/club-events/<%= event.id %>/sub-events/<%= sub.id %>"
                   class="flex items-center justify-between px-6 py-3 pl-10 text-sm hover:bg-white/5 transition-colors">
                  <span>
                    <span class="text-muted font-mono text-xs mr-2">SUB-EVENT</span>
                    <%= sub.title %>
                  </span>
                  <span class="text-muted text-xs">
                    <%= new Date(sub.start_time).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                  </span>
                </a>
              <% }); %>
            </div>
          <% } %>

          <div class="border-t border-line px-6 py-2.5">
            <a href="/club-events/<%= event.id %>/sub-events/new" class="font-mono text-[11px] tracking-[0.1em] text-lime hover:underline">
              + ADD SUB-EVENT
            </a>
          </div>
        </div>
      <% }); %>
    </div>
  </main>
</body>
</html>
