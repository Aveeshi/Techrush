<!DOCTYPE html>
<html lang="en">
<head>
  <%-
    include('../partials/head', {
      title: (mode === 'create' ? 'New ' : 'Edit ') + (containerType === 'sub_event' ? 'Sub-Event' : 'Event') + ' — CampusBuzz'
    })
  %>
</head>
<body class="font-sans text-fg antialiased bg-bg">
  <%- include('../partials/nav') %>

  <main class="page max-w-3xl mx-auto pt-8 pb-20">
    <div class="mb-6 flex items-center justify-between">
      <a href="<%= parentEvent ? `/club-events/${parentEvent.id}` : '/club-events' %>"
         class="text-xs font-mono text-muted hover:text-fg text-decoration-none flex items-center gap-1.5">
        ← BACK TO <%= parentEvent ? 'PARENT EVENT' : 'CLUB EVENTS' %>
      </a>
      <span class="badge badge-lime font-mono text-[9px]">
        <%= containerType === 'sub_event' ? 'SUB-TRACK FORM' : 'FLAGSHIP EVENT FORM' %>
      </span>
    </div>

    <!-- Header -->
    <div class="welcome-row mb-8">
      <div>
        <span class="overline text-lime">// EVENT SPECIFICATIONS</span>
        <h1 class="text-3xl font-extrabold text-fg my-1">
          <%= mode === 'create' ? 'Create' : 'Edit' %> <%= containerType === 'sub_event' ? 'Sub-Event Track' : 'Campus Event' %>
        </h1>
        <% if (parentEvent) { %>
          <p class="text-xs text-muted">Affiliated under flagship: <strong class="text-fg"><%= parentEvent.title %></strong></p>
        <% } %>
      </div>
    </div>

    <% if (errors && errors.length > 0) { %>
      <div class="panel p-4 mb-6 bg-red-500/10 border border-red-500/30 text-red-400 text-xs">
        <ul class="list-disc list-inside space-y-1">
          <% errors.forEach(function(error) { %><li><%= error %></li><% }); %>
        </ul>
      </div>
    <% } %>

    <%
      const actionUrl = mode === 'create'
        ? (containerType === 'sub_event' ? `/club-events/${parentEvent.id}/sub-events` : '/club-events')
        : (containerType === 'sub_event' ? `/club-events/${parentEvent.id}/sub-events/${event.id}/edit` : `/club-events/${event.id}/edit`);
      const val = (field) => (event && event[field] != null ? event[field] : '');
    %>

    <form action="<%= actionUrl %>" method="POST" <%- containerType === 'event' ? 'enctype="multipart/form-data"' : '' %> class="panel p-6 sm:p-8 space-y-5 bg-surface border border-line">
      <label class="field-label">
        EVENT / TRACK TITLE
        <input type="text" name="title" placeholder="e.g. Git &amp; GitHub Special Interest Group (SIG)" value="<%= val('title') %>" required />
      </label>

      <label class="field-label">
        DETAILED SYLLABUS &amp; DESCRIPTION
        <textarea name="description" placeholder="Describe workshop topics, hands-on activities, prerequisites, and learning outcomes..." rows="4"><%= val('description') %></textarea>
      </label>

      <label class="field-label">
        CAMPUS VENUE / LAB
        <input type="text" name="venue" placeholder="e.g. Lab A1-305, PICT Campus" value="<%= val('venue') %>" />
      </label>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <label class="field-label">
          START TIME
          <input type="datetime-local" name="startTime" required
                 value="<%= event && event.start_time ? new Date(event.start_time).toISOString().slice(0,16) : '' %>" />
        </label>
        <label class="field-label">
          END TIME
          <input type="datetime-local" name="endTime" required
                 value="<%= event && event.end_time ? new Date(event.end_time).toISOString().slice(0,16) : '' %>" />
        </label>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <label class="field-label">
          REGISTRATION DEADLINE (OPTIONAL)
          <input type="datetime-local" name="registrationDeadline"
                 value="<%= event && event.registration_deadline ? new Date(event.registration_deadline).toISOString().slice(0,16) : '' %>" />
        </label>

        <label class="field-label">
          ASSIGNED CREDIT HOURS (F023 CCA-I)
          <input type="number" step="0.5" min="0" name="creditHours" placeholder="e.g. 4.0"
                 value="<%= val('credit_hours') %>" />
        </label>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <label class="field-label">
          EVENT CATEGORY / TYPE
          <select name="eventTypeId">
            <option value="">Select Category (Optional)</option>
            <% eventTypes.forEach(function(et) { %>
              <option value="<%= et.id %>" <%= val('event_type_id') === et.id ? 'selected' : '' %>><%= et.name %></option>
            <% }); %>
          </select>
        </label>

        <% if (containerType === 'event') { %>
          <label class="field-label">
            VISIBILITY SCOPE
            <select name="visibility">
              <option value="public" <%= val('visibility') !== 'club_only' ? 'selected' : '' %>>Public (All PICT Students)</option>
              <option value="club_only" <%= val('visibility') === 'club_only' ? 'selected' : '' %>>Club Members Only</option>
            </select>
          </label>
        <% } %>
      </div>

      <label class="field-label">
        BANNER IMAGE URL (OPTIONAL)
        <input type="text" name="bannerUrl" placeholder="https://..." value="<%= val('banner_url') %>" />
      </label>

      <% if (containerType === 'event') { %>
        <div class="p-4 rounded-xl bg-surface-2 border border-line space-y-4">
          <label class="field-label">
            PRIMARY POSTER / THUMBNAIL
            <input type="file" name="primaryImage" accept="image/*"
                   class="text-xs text-muted file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-lime file:text-black file:font-bold file:cursor-pointer" />
          </label>

          <label class="field-label">
            ADDITIONAL GALLERY PHOTOS (OPTIONAL)
            <input type="file" name="additionalImages" accept="image/*" multiple
                   class="text-xs text-muted file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border file:border-line file:bg-surface-3 file:text-fg file:cursor-pointer" />
          </label>
        </div>
      <% } %>

      <% if (mode === 'create') { %>
        <div class="border-t border-line pt-5 mt-5">
          <label class="overline text-lime block mb-2">// DESIGNATE EVENT HEAD</label>
          <p class="text-xs text-muted mb-3">
            Pick an appointed Student Coordinator or member to manage check-ins, tasks, and volunteer teams for this event.
          </p>
          <input type="text" id="head-search" placeholder="Search club members by name..."
                 class="w-full text-xs px-3 py-2 bg-surface-2 border border-line rounded-lg text-fg placeholder-muted focus:outline-none focus:border-lime mb-3" />
          <div id="head-list" class="border border-line rounded-xl max-h-52 overflow-y-auto divide-y divide-line bg-surface-2">
            <% members.forEach(function(m) { %>
              <label class="head-option flex items-center gap-3 px-4 py-2.5 cursor-pointer hover:bg-surface-3 transition-colors" data-name="<%= m.name.toLowerCase() %>">
                <input type="radio" name="eventHeadStudentId" value="<%= m.id %>" class="accent-lime" />
                <strong class="text-xs text-fg"><%= m.name %></strong>
                <span class="text-muted text-[10px] mono ml-auto"><%= m.email %></span>
              </label>
            <% }); %>
            <% if (members.length === 0) { %>
              <p class="text-muted text-xs p-4">No club members available. Upload a roster first.</p>
            <% } %>
          </div>
        </div>
      <% } %>

      <div class="pt-4">
        <button type="submit" class="button button-primary w-full text-xs py-3 font-bold">
          <%= mode === 'create' ? 'Publish Event Proposal →' : 'Save Changes →' %>
        </button>
      </div>
    </form>
  </main>

  <script>
    const searchInput = document.getElementById('head-search');
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        const q = searchInput.value.trim().toLowerCase();
        document.querySelectorAll('.head-option').forEach((el) => {
          el.style.display = el.dataset.name.includes(q) ? '' : 'none';
        });
      });
    }
  </script>
</body>
</html>
