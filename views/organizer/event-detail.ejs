<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: event.title + ' — Event Management' }) %>
</head>
<body class="font-sans text-fg antialiased bg-bg">
  <%- include('../partials/nav') %>

  <main class="page max-w-6xl mx-auto pt-8 pb-20">
    <%
      const backUrl = user.type === 'organizer'
        ? (parentEvent ? `/club-events/${parentEvent.id}` : '/club-events')
        : '/my-events';
      const backLabel = user.type === 'organizer'
        ? (parentEvent ? parentEvent.title.toUpperCase() : 'CLUB EVENTS')
        : 'MY EVENTS & TEAMS';
    %>
    <div class="mb-6 flex items-center justify-between">
      <a href="<%= backUrl %>" class="text-xs font-mono text-muted hover:text-fg text-decoration-none flex items-center gap-1.5">
        ← BACK TO <%= backLabel %>
      </a>
      <span class="badge <%= event.status === 'published' ? 'badge-green' : 'badge-neutral' %> font-mono text-[9px] uppercase">
        <%= containerType === 'sub_event' ? 'SUB-EVENT' : 'FLAGSHIP' %> · <%= (event.status || 'draft').toUpperCase() %>
      </span>
    </div>

    <!-- Header Panel -->
    <div class="welcome-row mb-8 items-start">
      <div class="flex-1">
        <span class="overline text-lime">// EVENT OPERATIONS HUB</span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-fg my-1"><%= event.title %></h1>
        <p class="text-xs text-muted">
          <%= new Date(event.start_time).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' }) %>
          <% if (event.venue) { %> · 📍 <%= event.venue %><% } %>
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <% if (user.type === 'organizer') { %>
          <form action="<%= manageBasePath %>/publish" method="POST" class="inline">
            <button type="submit" class="button button-quiet text-xs">
              <%= event.status === 'published' ? 'Unpublish' : 'Publish' %>
            </button>
          </form>
        <% } %>

        <a href="<%= containerType === 'sub_event' ? `/events/${event.event_id}/sub-events/${event.id}/scan` : `/events/${event.id}/scan` %>"
           class="button button-primary text-xs text-decoration-none font-bold">
          📱 Scan Attendee QR Codes
        </a>

        <a href="<%= manageBasePath %>/edit" class="button button-quiet text-xs text-decoration-none">
          Edit Info
        </a>
      </div>
    </div>

    <% if (event.description) { %>
      <div class="panel p-6 mb-8 text-xs text-muted leading-relaxed whitespace-pre-line">
        <%= event.description %>
      </div>
    <% } %>

    <% if (containerType === 'event') { %>
      <!-- Sub-Events Section -->
      <div class="panel p-6 mb-8">
        <div class="panel-head px-0 pt-0 pb-4 mb-4">
          <div>
            <span class="overline">// SUB-TRACKS &amp; MODULES</span>
            <h3 class="text-base font-bold text-fg">Sub-Events (<%= subEvents.length %>)</h3>
          </div>
          <a href="/club-events/<%= event.id %>/sub-events/new" class="button button-quiet text-xs text-decoration-none">
            + Add Sub-Track
          </a>
        </div>

        <% if (subEvents.length === 0) { %>
          <p class="text-xs text-muted py-4">No sub-events created yet for this flagship event.</p>
        <% } else { %>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <% subEvents.forEach(function(sub) { %>
              <a href="/club-events/<%= event.id %>/sub-events/<%= sub.id %>" class="panel p-5 bg-surface-2 hover:border-lime/40 transition-colors text-decoration-none block">
                <span class="badge badge-lime text-[8px] font-mono mb-2">TRACK</span>
                <h4 class="text-sm font-bold text-fg mb-1"><%= sub.title %></h4>
                <p class="text-[10px] text-muted mono">
                  <%= new Date(sub.start_time).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                </p>
              </a>
            <% }); %>
          </div>
        <% } %>
      </div>
    <% } %>

    <!-- Event Heads Panel -->
    <div class="panel p-6 mb-8">
      <div class="panel-head px-0 pt-0 pb-4 mb-4">
        <span class="overline">// OPERATIONAL LEADERSHIP</span>
        <h3 class="text-base font-bold text-fg">Designated Event Heads (<%= heads.length %>)</h3>
      </div>
      <% if (heads.length === 0) { %>
        <p class="text-xs text-muted">No student head currently assigned.</p>
      <% } else { %>
        <div class="flex flex-wrap gap-2.5">
          <% heads.forEach(function(h) { %>
            <span class="badge badge-lime text-xs px-3 py-1.5 font-bold">★ <%= h.name %></span>
          <% }); %>
        </div>
      <% } %>
    </div>

    <!-- Teams Management Panel -->
    <div class="panel p-6 mb-8">
      <div class="panel-head px-0 pt-0 pb-4 mb-4">
        <div>
          <span class="overline">// VOLUNTEER CADRE</span>
          <h3 class="text-base font-bold text-fg">Operational Teams (<%= teams.length %>)</h3>
        </div>
      </div>

      <% if (teams.length === 0) { %>
        <p class="text-xs text-muted py-2">No volunteer teams formed yet.</p>
      <% } %>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
        <% teams.forEach(function(team) { %>
          <div class="panel p-5 bg-surface-2 border border-line">
            <div class="flex items-start justify-between gap-3 mb-2">
              <div>
                <h4 class="text-sm font-bold text-fg"><%= team.name %></h4>
                <% if (team.description) { %>
                  <p class="text-xs text-muted mt-0.5"><%= team.description %></p>
                <% } %>
              </div>
              <span class="badge <%= team.max_size && team.members.length >= team.max_size ? 'badge-red' : 'badge-neutral' %> font-mono text-[8px]">
                <%= team.members.length %><%= team.max_size ? ' / ' + team.max_size : '' %> MEMBERS
              </span>
            </div>

            <% if (team.heads.length > 0) { %>
              <div class="flex flex-wrap gap-1.5 mb-3">
                <% team.heads.forEach(function(h) { %>
                  <span class="badge badge-amber text-[8px]">Head: <%= h.name %></span>
                <% }); %>
              </div>
            <% } %>

            <div class="flex items-center gap-3 pt-3 border-t border-line">
              <a href="/teams/<%= team.id %>/manage" class="button button-quiet text-[9px] py-1 px-3 text-decoration-none">
                Manage Team →
              </a>
              <a href="/teams/<%= team.id %>#chat" class="button button-quiet text-[9px] py-1 px-3 text-decoration-none">
                Team Chat
              </a>
            </div>
          </div>
        <% }); %>
      </div>

      <!-- Add Team Form -->
      <form action="<%= manageBasePath %>/teams" method="POST" class="p-5 rounded-xl bg-surface-2 border border-line">
        <span class="overline text-lime block mb-3">// CREATE OPERATIONAL TEAM</span>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-4">
          <label class="field-label sm:col-span-1">
            TEAM NAME
            <input type="text" name="name" placeholder="e.g. Technical Logistics" required />
          </label>
          <label class="field-label sm:col-span-1">
            MANDATE DESCRIPTION
            <input type="text" name="description" placeholder="Sound, displays, network..." />
          </label>
          <label class="field-label sm:col-span-1">
            CAPACITY LIMIT
            <input type="number" name="maxSize" min="1" placeholder="Unlimited" />
          </label>
        </div>

        <button type="submit" class="button button-primary text-xs font-bold">
          + Add Operational Team
        </button>
      </form>
    </div>

    <!-- Attendees Roster -->
    <div class="panel overflow-hidden">
      <div class="panel-head">
        <div>
          <span class="overline">// VERIFIED PARTICIPATION</span>
          <h3 class="text-base font-bold text-fg">Registered Attendees (<%= attendees.length %>)</h3>
        </div>
        <span class="badge badge-green font-mono text-[9px]"><%= attendees.length %> Registered</span>
      </div>

      <% if (attendees.length === 0) { %>
        <div class="p-10 text-center text-muted text-xs">
          No students registered as attendees yet.
        </div>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Attendee Name</th>
                <th>Email Address</th>
                <th>Check-in Status</th>
                <th>Check-out Status</th>
              </tr>
            </thead>
            <tbody>
              <% attendees.forEach(function(a) { %>
                <tr>
                  <td><strong class="text-fg text-xs"><%= a.name %></strong></td>
                  <td class="mono text-xs text-muted"><%= a.email %></td>
                  <td>
                    <% if (a.checked_in_at) { %>
                      <span class="badge badge-green font-mono text-[8px]">
                        ✓ <%= new Date(a.checked_in_at).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) %>
                      </span>
                    <% } else { %>
                      <span class="text-muted mono text-[10px]">—</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (a.checked_out_at) { %>
                      <span class="badge badge-green font-mono text-[8px]">
                        ✓ <%= new Date(a.checked_out_at).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) %>
                      </span>
                    <% } else { %>
                      <span class="text-muted mono text-[10px]">—</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </main>
</body>
</html>
