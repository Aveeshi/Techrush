<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: club.name + ' — Club Hub' }) %>
</head>
<body class="font-sans text-fg antialiased bg-bg">
  <%- include('../partials/nav') %>

  <main class="page max-w-5xl mx-auto pt-8 pb-20">
    <div class="mb-6 flex items-center justify-between">
      <a href="/events" class="text-xs font-mono text-muted hover:text-fg text-decoration-none flex items-center gap-1.5">
        ← Back to Events
      </a>
      <span class="badge badge-lime font-mono text-[9px]">ORGANIZER DESK</span>
    </div>

    <% if (uploaded) { %>
      <div class="panel p-4 mb-6 bg-lime/10 border border-lime/40 text-lime text-xs flex items-center gap-2">
        <span class="font-bold">✓</span> Roster updated — <%= roster.length %> member<%= roster.length === 1 ? '' : 's' %> on file.
      </div>
    <% } %>

    <!-- Club Overview Header -->
    <div class="welcome-row mb-8 items-start">
      <div class="flex items-start gap-5">
        <div class="w-20 h-20 rounded-2xl bg-surface-2 border border-line shrink-0 overflow-hidden flex items-center justify-center">
          <% if (club.logo_url) { %>
            <img src="<%= club.logo_url %>" alt="<%= club.name %>" class="w-full h-full object-cover" />
          <% } else { %>
            <span class="font-display font-extrabold text-2xl text-lime"><%= club.name.slice(0, 2).toUpperCase() %></span>
          <% } %>
        </div>
        <div>
          <span class="overline text-lime">// ACCREDITED CHAPTER PROFILE</span>
          <h1 class="text-3xl font-extrabold text-fg my-1"><%= club.name %></h1>
          <p class="text-xs text-muted leading-relaxed max-w-xl"><%= club.description || 'No institutional description provided.' %></p>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <a href="/club-events/new" class="button button-primary text-xs text-decoration-none font-bold">
          + New Event Proposal
        </a>
      </div>
    </div>

    <!-- Member Roster Upload Panel -->
    <div class="panel p-6 mb-8">
      <div class="panel-head px-0 pt-0 pb-4 mb-4">
        <div>
          <span class="overline">// VERIFIED ENROLLMENT</span>
          <h3 class="text-base font-bold text-fg">Member Roster Upload</h3>
        </div>
        <span class="badge badge-neutral text-[9px] font-mono"><%= roster.length %> Verified Members</span>
      </div>

      <p class="text-xs text-muted mb-5 leading-relaxed">
        Upload an .xlsx or .xls file containing <strong class="text-fg">Name</strong> and <strong class="text-fg">Email</strong> columns. Every upload validates membership eligibility when students register for events or access logbook records.
      </p>

      <form action="/club/roster" method="POST" enctype="multipart/form-data" class="flex flex-wrap items-center gap-3 mb-6">
        <input type="file" name="roster" accept=".xlsx,.xls" required
               class="text-xs text-muted file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border file:border-line file:bg-surface-2 file:text-fg file:text-xs file:font-semibold file:cursor-pointer" />
        <button type="submit" class="button button-quiet text-xs font-bold">
          Upload / Replace Roster
        </button>
      </form>
    </div>

    <!-- CCA Logbook Feature Panel -->
    <div class="panel p-6 mb-8 bg-surface-2 border border-line">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <span class="badge badge-lime text-[8px] font-mono mb-1">COURSE F023 CCA-I</span>
          <h3 class="text-base font-bold text-fg">Institutional Activity Logbook Engine</h3>
          <p class="text-xs text-muted mt-1 max-w-xl">
            When enabled, student members can generate pre-filled Co-Curricular Activity Logbook (.docx) dossiers from their verified event check-in stamps and logged task hours.
          </p>
        </div>

        <form action="/club/logbook-toggle" method="POST">
          <input type="hidden" name="enabled" value="<%= club.logbook_enabled ? 'false' : 'true' %>" />
          <button type="submit" class="button <%= club.logbook_enabled ? 'button-green' : 'button-quiet' %> text-xs font-bold">
            <%= club.logbook_enabled ? '✓ Enabled for Members' : 'Enable Logbook' %>
          </button>
        </form>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <a href="/club-events" class="button button-quiet text-xs text-decoration-none">
        Manage All Club Events →
      </a>
      <a href="/events" class="button button-quiet text-xs text-decoration-none">
        View Public Event Directory →
      </a>
    </div>
  </main>
</body>
</html>
