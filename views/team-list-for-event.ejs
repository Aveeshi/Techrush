<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: event.title + ' · Volunteer Squads — CampusBuzz' }) %>
</head>
<body class="font-sans text-fg antialiased bg-bg">
  <%- include('partials/nav') %>

  <main class="page max-w-6xl mx-auto pt-8 pb-20">
    <div class="mb-6 flex items-center justify-between">
      <a href="<%= backUrl %>" class="text-xs font-mono text-muted hover:text-fg text-decoration-none flex items-center gap-1.5">
        ← BACK TO MY EVENTS &amp; TEAMS
      </a>
      <span class="badge badge-lime font-mono text-[9px]">SQUAD DIRECTORY</span>
    </div>

    <!-- Header Section -->
    <div class="welcome-row mb-8">
      <div>
        <span class="overline text-lime">// STUDENT VOLUNTEER CADRE</span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-fg my-1"><%= event.title %></h1>
        <p class="text-xs text-muted">
          You are enrolled on <%= teams.length %> volunteer team<%= teams.length === 1 ? '' : 's' %> for this event.
          <% if (manageTeamsUrl) { %>
            · <a href="<%= manageTeamsUrl %>" class="text-lime hover:underline text-decoration-none">Manage Team Roster →</a>
          <% } %>
        </p>
      </div>

      <div class="date-tile">
        <strong><%= teams.length %></strong>
        <small>SQUADS</small>
      </div>
    </div>

    <% if (teams.length === 0) { %>
      <article class="panel p-10 text-center text-muted text-xs">
        You are not currently volunteering on any squad for this event.
      </article>
    <% } else { %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% teams.forEach(function(team) { %>
          <article class="panel p-6 flex flex-col justify-between hover:border-lime/40 transition-colors">
            <div>
              <span class="badge badge-lime text-[8px] font-mono mb-3">SQUAD</span>
              <h3 class="text-lg font-bold text-fg mb-2"><%= team.name %></h3>

              <% if (team.description) { %>
                <p class="text-xs text-muted mb-4 leading-relaxed line-clamp-3"><%= team.description %></p>
              <% } %>
            </div>

            <div class="pt-4 border-t border-line mt-4">
              <a href="/teams/<%= team.id %>" class="button button-quiet w-full text-center text-xs font-bold text-decoration-none">
                Open Team Workspace →
              </a>
            </div>
          </article>
        <% }); %>
      </div>
    <% } %>
  </main>
</body>
</html>
