<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: "CampusBuzz — Institutional Campus Activity & Credit Protocol" }) %>
</head>
<body class="font-sans text-fg antialiased bg-bg">
  <%- include('partials/nav') %>

  <!-- HERO SECTION -->
  <main class="page pt-12 pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-[1.2fr_0.8fr] gap-12 items-center mb-16">
      <!-- LEFT: COPY -->
      <div>
        <div class="flex items-center gap-3 mb-6">
          <span class="badge badge-lime">
            <i></i> PICT AUTONOMOUS CAMPUS PROTOCOL
          </span>
          <span class="mono text-xs text-muted">// PROTOCOL V2.4</span>
        </div>

        <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl font-extrabold leading-[1.05] tracking-tight mb-6">
          Every contribution.<br />
          <span class="text-lime">Credited.</span>
        </h1>

        <p class="text-muted text-base sm:text-lg leading-relaxed max-w-xl mb-8">
          One verified, tamper-proof academic ledger for all co-curricular activities, leadership hours, and accredited milestones. Designed for students, faculty conveners, and institutional auditors.
        </p>

        <div class="flex flex-wrap items-center gap-3">
          <a href="/events" class="button button-primary text-sm py-3 px-6 text-decoration-none">
            Explore Events &amp; Hackathons →
          </a>
          <% if (!user) { %>
            <a href="/auth/login" class="button button-quiet text-sm py-3 px-6 text-decoration-none">
              Sign In to Portal
            </a>
          <% } else { %>
            <a href="<%= user.type === 'faculty' ? '/faculty/dashboard' : user.type === 'institutional' ? '/institutional/dashboard' : '/student/dashboard' %>"
               class="button button-quiet text-sm py-3 px-6 text-decoration-none">
              My Console (<%= user.type.toUpperCase() %>)
            </a>
          <% } %>
        </div>
      </div>

      <!-- RIGHT: STATS GRID -->
      <div class="grid grid-cols-2 gap-4">
        <article class="metric featured">
          <div class="metric-top">
            <span class="metric-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 21h18M6 21V7l6-4 6 4v14"></path>
              </svg>
            </span>
            <span class="badge badge-lime">REGISTERED</span>
          </div>
          <p>CAMPUS CLUBS</p>
          <h2>08 <small>Autonomous</small></h2>
          <div class="metric-foot">
            <span>PICT Technical & Cultural</span>
          </div>
        </article>

        <article class="metric">
          <div class="metric-top">
            <span class="metric-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="9"></circle>
                <polyline points="12 7 12 12 15 14"></polyline>
              </svg>
            </span>
            <span class="trend font-mono">+18.4%</span>
          </div>
          <p>VERIFIED HOURS</p>
          <h2>1,420 <small>hrs</small></h2>
          <div class="metric-foot">
            <span>Credited to transcripts</span>
          </div>
        </article>

        <article class="metric">
          <div class="metric-top">
            <span class="metric-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="8" r="6"></circle>
                <path d="M8.5 13 7 22l5-3 5 3-1.5-9"></path>
              </svg>
            </span>
            <span class="badge badge-green">NAAC A++</span>
          </div>
          <p>AUDIT LEDGER</p>
          <h2>100% <small>Locked</small></h2>
          <div class="metric-foot">
            <span>Cryptographic sign-off</span>
          </div>
        </article>

        <article class="metric">
          <div class="metric-top">
            <span class="metric-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
              </svg>
            </span>
            <span class="trend font-mono">LIVE NODE</span>
          </div>
          <p>ACTIVE STUDENTS</p>
          <h2>3,200+</h2>
          <div class="metric-foot">
            <span>Enrolled engineers</span>
          </div>
        </article>
      </div>
    </div>

    <!-- VALUE STRIP -->
    <section class="landing-signal-panel">
      <div class="landing-signal-grid"></div>
      <div class="landing-signal-copy">
        <span class="overline">ONE CAMPUS. ONE CLEAR RECORD.</span>
        <h2>Make every hour visible.</h2>
        <p>
          Discover what is happening, show up with purpose, and keep a verified record of the work that moves campus life forward.
        </p>
        <a href="/events" class="button button-primary text-sm py-3 px-6 text-decoration-none">
          See what’s happening →
        </a>
      </div>

      <div class="landing-signal-status" aria-label="Campus activity status">
        <div class="signal-status-header">
          <span class="signal-dot"></span>
          <span class="mono text-xs">CAMPUS SIGNAL</span>
          <span class="mono text-xs text-muted">LIVE</span>
        </div>
        <div class="signal-wave" aria-hidden="true">
          <span></span><span></span><span></span><span></span><span></span>
          <span></span><span></span><span></span><span></span><span></span>
          <span></span><span></span><span></span><span></span><span></span>
        </div>
        <div class="signal-status-foot">
          <span>Events</span>
          <strong>Discover · Join · Credit</strong>
        </div>
      </div>
    </section>

    <div class="landing-principles" aria-label="CampusBuzz principles">
      <div>
        <span class="principle-index">01</span>
        <strong>Find your next thing</strong>
        <span>Clubs, workshops, competitions, and conversations in one calm feed.</span>
      </div>
      <div>
        <span class="principle-index">02</span>
        <strong>Show up together</strong>
        <span>Register, collaborate, and build momentum with your campus community.</span>
      </div>
      <div>
        <span class="principle-index">03</span>
        <strong>Keep the proof</strong>
        <span>Verified attendance and contributions become part of your academic story.</span>
      </div>
    </div>
  </main>
</body>
</html>
