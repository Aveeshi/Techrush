<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'QR Gate Scanner · ' + event.title + ' — CampusBuzz' }) %>
  <script src="/vendor/html5-qrcode.min.js"></script>
</head>
<body class="font-sans text-fg antialiased bg-bg">
  <%- include('partials/nav') %>

  <main class="page max-w-xl mx-auto pt-8 pb-20">
    <div class="mb-6 flex items-center justify-between">
      <a href="<%= typeof backUrl !== 'undefined' ? backUrl : '/events/' + event.id %>" class="text-xs font-mono text-muted hover:text-fg text-decoration-none flex items-center gap-1.5">
        ← BACK TO EVENT
      </a>
      <span class="badge badge-green font-mono text-[9px]">LIVE CAMERA SCANNER</span>
    </div>

    <!-- Header -->
    <div class="welcome-row mb-6">
      <div>
        <span class="overline text-lime">// GATE ADMISSION &amp; ATTENDANCE</span>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-fg my-1"><%= event.title %></h1>
        <p class="text-xs text-muted">Point camera at student pass QR. Scan once to check in (+credit hours), scan again to check out.</p>
      </div>
    </div>

    <!-- Result Banner -->
    <div id="result" class="hidden panel p-4 mb-6 text-xs font-bold transition-all"></div>

    <!-- Camera Box -->
    <div class="panel p-3 border-2 border-line bg-surface-2 overflow-hidden shadow-2xl rounded-2xl">
      <div id="reader" class="rounded-xl overflow-hidden"></div>
    </div>

    <p id="camera-error" class="hidden text-red-400 text-xs mt-4 text-center"></p>
  </main>

  <script>
    const checkinUrl = '<%= typeof checkinUrl !== "undefined" ? checkinUrl : "/events/" + event.id + "/checkin" %>';
    const resultBox = document.getElementById('result');
    const cameraError = document.getElementById('camera-error');

    let processing = false;

    function showResult({ ok, text }) {
      resultBox.classList.remove('hidden', 'bg-lime/10', 'border-lime/40', 'text-lime', 'bg-red-500/10', 'border-red-500/30', 'text-red-400');
      if (ok) {
        resultBox.classList.add('bg-lime/10', 'border-lime/40', 'text-lime');
      } else {
        resultBox.classList.add('bg-red-500/10', 'border-red-500/30', 'text-red-400');
      }
      resultBox.textContent = text;
    }

    async function onScanSuccess(decodedText) {
      if (processing) return;
      processing = true;

      try {
        const res = await fetch(checkinUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ qrCode: decodedText }),
        });
        const data = await res.json();

        if (!res.ok) {
          showResult({ ok: false, text: data.error || 'Scan validation failed.' });
        } else {
          const verb = data.action === 'check_in' ? 'Checked in' : 'Checked out';
          showResult({ ok: true, text: `✓ ${verb}: ${data.student.name} (${data.registrationType}) — Credited.` });
        }
      } catch (err) {
        showResult({ ok: false, text: 'Network connection error — retry scan.' });
      } finally {
        setTimeout(() => { processing = false; }, 2000);
      }
    }

    const scanner = new Html5Qrcode('reader');
    scanner.start(
      { facingMode: 'environment' },
      { fps: 10, qrbox: 250 },
      onScanSuccess,
      (err) => {}
    ).catch((err) => {
      cameraError.classList.remove('hidden');
      cameraError.textContent = 'Camera permission denied or camera device unavailable.';
    });
  </script>
</body>
</html>
